<Window x:Class="CloudBerry.App.InputLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cirra Input Lab"
        Icon="pack://application:,,,/Resources/Icons/cirra_app_icon_256.png"
        Width="820"
        Height="650"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                           FontSize="{DynamicResource FontSizeHeading}"
                           FontWeight="SemiBold"
                           Text="Input Lab"/>
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Text="Live buttons, triggers, sticks, drift, and disconnect state for four XInput slots."/>
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="CloseClick"
                    Content="Close"/>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource PanelBorderStyle}"
                Padding="14,10"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,14,0"
                           Text="QUIET ZONE"/>
                <Slider Grid.Column="1"
                        Minimum="0.04"
                        Maximum="0.30"
                        TickFrequency="0.01"
                        IsSnapToTickEnabled="True"
                        Value="{Binding DriftThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="2"
                           Margin="12,0,18,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding DriftThreshold, StringFormat={}{0:P0}}"/>
                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Text="Read-only diagnostics · mappings are not changed"/>
            </Grid>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Controllers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="16,14"
                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource FontSizeBody}"
                                           FontWeight="SemiBold"
                                           Text="{Binding SlotLabel}"/>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource CloudBrush}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Text="{Binding ConnectionLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0">
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Text="{Binding ButtonLabel}"/>
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="Consolas"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Text="{Binding StickLabel}"/>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="Consolas"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Text="{Binding TriggerLabel}"/>
                            </StackPanel>
                            <Border Grid.Column="2"
                                    MinWidth="172"
                                    Padding="10,7"
                                    VerticalAlignment="Center"
                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                    Background="{DynamicResource ThemePanelFillSoftBrush}">
                                <TextBlock MaxWidth="220"
                                           TextWrapping="Wrap"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Text="{Binding HealthMessage}"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
