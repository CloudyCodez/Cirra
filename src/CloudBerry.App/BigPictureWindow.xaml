<Window x:Class="CloudBerry.App.BigPictureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CloudBerry.App.Controls"
        xmlns:effects="clr-namespace:CloudBerry.App.Effects"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cirra Horizon"
        Icon="pack://application:,,,/Resources/Icons/cirra_app_icon_256.png"
        Width="1600"
        Height="960"
        MinWidth="1280"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="{DynamicResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="WindowPreviewKeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="BigPictureAtmosphereBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#CC1E1A14"/>
            <GradientStop Offset="0.55" Color="#E61A1610"/>
            <GradientStop Offset="1" Color="#F7181410"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BigPictureCardOverlayBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#08000000"/>
            <GradientStop Offset="0.44" Color="#20000000"/>
            <GradientStop Offset="0.70" Color="#A8100C09"/>
            <GradientStop Offset="1" Color="#FA100C09"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BigPictureCardTitleBrush" Color="#FFF8EED8"/>
        <SolidColorBrush x:Key="BigPictureCardSubtitleBrush" Color="#E6D9C69A"/>
        <SolidColorBrush x:Key="BigPictureCardAccentBrush" Color="#FFC8A870"/>
        <LinearGradientBrush x:Key="BigPictureCardTextPlateBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#E0100C09"/>
            <GradientStop Offset="0.62" Color="#B8120E0A"/>
            <GradientStop Offset="1" Color="#86120E0A"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BigPictureCardTextPlateBorderBrush" Color="#46F8EED8"/>

        <Style x:Key="HorizonScrollViewerStyle"
               TargetType="ScrollViewer"
               BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
            <Setter Property="PanningDeceleration" Value="0.0014"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="VerticalPointerDragStart"/>
            <EventSetter Event="PreviewMouseMove" Handler="VerticalPointerDragMove"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="VerticalPointerDragEnd"/>
            <EventSetter Event="LostMouseCapture" Handler="VerticalPointerDragLost"/>
        </Style>

        <Style x:Key="HorizonGlassSurfaceStyle"
               TargetType="Border"
               BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemePanelFillSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassPanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}"
                                      BlurRadius="20"
                                      ShadowDepth="2"
                                      Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizonCommandSurfaceStyle"
               TargetType="Border"
               BasedOn="{StaticResource HorizonGlassSurfaceStyle}">
            <Setter Property="Background" Value="{DynamicResource BladeGlassBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}"
                                      BlurRadius="14"
                                      ShadowDepth="1"
                                      Opacity="0.14"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizonInsetSurfaceStyle"
               TargetType="Border"
               BasedOn="{StaticResource InsetCardStyle}">
            <Setter Property="Background" Value="{DynamicResource GlassChipFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassPanelBorderBrush}"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="HorizonLiquidButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource BladeGlassBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassPanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}"
                                      BlurRadius="12" ShadowDepth="1" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizonLiquidIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource HorizonLiquidButtonStyle}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="HorizonGridListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,6,8,12"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        </Style>

        <Style x:Key="HorizonGridItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BigPictureNavListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="BigPictureNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,10"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="NavItemScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <!-- A2: theme-reactive glow color (was hardcoded parchment #3C3020) -->
                                <DropShadowEffect x:Name="NavItemGlow" Color="{DynamicResource ThemePanelShadowColor}" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavItemHoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11"/>
                                            <DoubleAnimation Storyboard.TargetName="NavItemScale" Storyboard.TargetProperty="ScaleX" To="1.014" Duration="0:0:0.11"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NavItemScale" Storyboard.TargetProperty="ScaleY" To="1.014" Duration="0:0:0.11"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NavItemGlow" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:0.11"/>
                                            <DoubleAnimation Storyboard.TargetName="NavItemGlow" Storyboard.TargetProperty="Opacity" To="0.26" Duration="0:0:0.11"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Border.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavItemHoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="NavItemScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NavItemScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NavItemGlow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="NavItemGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Grid>
                                <Border x:Name="NavItemHoverOverlay"
                                        Background="{DynamicResource CardHoverBrush}"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                        Opacity="0"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BladeGlassBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource CloudBrush}"/>
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}" BlurRadius="9" ShadowDepth="0" Opacity="0.24"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource CloudBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BigPictureCategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg"
                                MinWidth="148"
                                Height="60"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,9"
                                ClipToBounds="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CatItemScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <!-- A2: theme-reactive glow color (was hardcoded parchment #8A7040) -->
                                <DropShadowEffect x:Name="CatItemGlow" Color="{DynamicResource ThemePanelShadowColor}" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.MouseEnter">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CatItemHoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11"/>
                                        <DoubleAnimation Storyboard.TargetName="CatItemScale" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.11"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CatItemScale" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.11"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CatItemGlow" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:0.11"/>
                                        <DoubleAnimation Storyboard.TargetName="CatItemGlow" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0:0:0.11"/>
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Border.MouseLeave">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CatItemHoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="CatItemScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CatItemScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CatItemGlow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="CatItemGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Grid>
                                <Border x:Name="CatItemHoverOverlay"
                                        Background="{DynamicResource CardHoverBrush}"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                        Opacity="0"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BladeGlassBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource CloudBrush}"/>
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.30"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BigPictureShelfListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        </Style>

        <Style x:Key="BigPictureShelfItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="BigPictureGameCardTemplate">
            <Grid Width="220" Height="310" RenderTransformOrigin="0.5,0.5"
                  MouseEnter="GameCardMouseEnter" MouseLeave="GameCardMouseLeave">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="&#xE768;  Launch" Click="CardContextLaunchClick" FontWeight="SemiBold"/>
                        <Separator/>
                        <MenuItem Header="&#xE734;  Favorite" Click="CardContextFavoriteClick"
                                  IsChecked="{Binding IsFavorite, Mode=OneWay}"/>
                        <MenuItem Header="&#xE8BD;  Mark as Playing" Click="CardContextMarkPlayingClick"/>
                        <MenuItem Header="&#xE930;  Mark as Completed" Click="CardContextMarkCompletedClick"/>
                        <Separator/>
                        <MenuItem Header="&#xE946;  View Details" Click="CardContextDetailsClick"/>
                        <MenuItem Header="&#xE8A7;  Open in Library" Click="CardContextOpenLibraryClick"/>
                        <Separator/>
                        <MenuItem Header="&#xE74D;  Remove from Library" Click="CardContextRemoveClick"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Grid.MouseEnter">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.012" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.012" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.14"/>
                            <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:0.14"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Grid.MouseLeave">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                            <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Border x:Name="FocusHalo" Margin="-6" CornerRadius="{DynamicResource ThemeCornerRadiusLarge}"
                        BorderBrush="{DynamicResource NeoCyanBrush}" BorderThickness="0" Opacity="0">
                    <Border.Effect>
                        <!-- A2: theme-reactive glow color (was hardcoded parchment #3C3020) -->
                        <DropShadowEffect x:Name="FocusGlow" Color="{DynamicResource ThemePanelShadowColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.32"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="FocusAura" Margin="-14" CornerRadius="{DynamicResource ThemeCornerRadiusLarge}"
                        Background="{DynamicResource ThemeSweepBrush}" Opacity="0" IsHitTestVisible="False"/>
                <!-- Now Playing pulse ring — visible when IsRunning = true -->
                        <Border x:Name="NowPlayingRing"
                                Margin="-2"
                                CornerRadius="{DynamicResource ThemeCornerRadiusLarge}"
                                BorderBrush="{DynamicResource MintBrush}"
                                BorderThickness="2.5"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ThemePrimaryButtonGlowColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.72"/>
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="NowPlayingRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.55" To="1.0"
                                                             Duration="0:0:1.1">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <Border x:Name="CardRoot" CornerRadius="{DynamicResource ThemeCornerRadiusLarge}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Background="{DynamicResource CardBrush}">
                    <Border.Effect>
                        <!-- A2: theme-reactive glow color (was hardcoded parchment #3C3020) -->
                        <DropShadowEffect x:Name="CardGlow" Color="{DynamicResource ThemePanelShadowColor}" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                    </Border.Effect>
                    <Grid ClipToBounds="True">
                        <Border Background="{DynamicResource SurfaceHighBrush}"/>
                        <controls:CrossfadeImage Stretch="UniformToFill" Source="{Binding DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                        <controls:CrossfadeImage Stretch="UniformToFill" Opacity="0.18" Source="{Binding DisplayBackgroundImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                        <Rectangle Fill="{StaticResource BigPictureCardOverlayBrush}"/>
                        <Rectangle VerticalAlignment="Top" Height="86" Fill="{DynamicResource GlassSheenBrush}" Opacity="0.42" IsHitTestVisible="False"/>
                        <Rectangle x:Name="SelectedSheen" Width="76" HorizontalAlignment="Left"
                                   Fill="{DynamicResource GlassSheenBrush}" Opacity="0" IsHitTestVisible="False">
                            <Rectangle.RenderTransform><SkewTransform AngleX="-18"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Border x:Name="InnerFocusRim" Margin="6" CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                BorderBrush="{DynamicResource CloudBrush}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="TrailerHoverPlate" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="10" Padding="9,5" CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                Background="{DynamicResource ThemePanelFillBrush}"
                                BorderBrush="{DynamicResource CloudBrush}" BorderThickness="1" Opacity="0"
                                Visibility="{Binding HasTrailer, Converter={StaticResource BooleanToVisibilityConverter}}"
                                IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12"
                                           Foreground="{DynamicResource CloudBrush}" Text="&#xE768;" VerticalAlignment="Center"/>
                                <TextBlock Margin="6,0,0,0" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource BigPictureCardTitleBrush}" Text="TRAILER" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Grid Visibility="{Binding HasCoverImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="48"
                                       Foreground="{StaticResource BigPictureCardTitleBrush}"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Top" Margin="14">
                            <Border Padding="9,4" Background="{DynamicResource ThemePanelFillBrush}"
                                    BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}" HorizontalAlignment="Left"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BigPictureCardAccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <Border x:Name="CardTextPlate" VerticalAlignment="Bottom" Margin="10,0,10,10" Padding="10,8"
                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                Background="{StaticResource BigPictureCardTextPlateBrush}"
                                BorderBrush="{StaticResource BigPictureCardTextPlateBorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="0" Opacity="0.28"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource BigPictureCardTitleBrush}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="46"/>
                                <TextBlock Margin="0,5,0,0" Text="{Binding Subtitle}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BigPictureCardSubtitleBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Margin="0,4,0,0" Text="{Binding AchievementSummary}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BigPictureCardAccentBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <!-- Compact-mode Play button: small frosted pill at bottom, only shown when hero is collapsed -->
                        <Border x:Name="CompactPlayBtn"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,8" Padding="14,7"
                                CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                Background="{DynamicResource ThemePanelFillBrush}"
                                BorderBrush="{DynamicResource CloudBrush}" BorderThickness="1"
                                Cursor="Hand"
                                MouseLeftButtonUp="CompactPlayBtnClick"
                                Visibility="{Binding DataContext.IsCloudscapeCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                IsHitTestVisible="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.38"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           FontSize="11" Foreground="{DynamicResource CloudBrush}" VerticalAlignment="Center"/>
                                <TextBlock Margin="6,0,0,0" Text="Play" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource BigPictureCardTitleBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource CloudBrush}"/>
                    <Setter TargetName="TrailerHoverPlate" Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource CloudBrush}"/>
                    <Setter TargetName="CardRoot" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="FocusHalo" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="FocusHalo" Property="Opacity" Value="1"/>
                    <Setter TargetName="FocusAura" Property="Opacity" Value="0.16"/>
                    <Setter TargetName="InnerFocusRim" Property="Opacity" Value="0.82"/>
                    <Setter TargetName="SelectedSheen" Property="Opacity" Value="0.28"/>
                    <Setter TargetName="CardTextPlate" Property="BorderBrush" Value="{StaticResource BigPictureCardAccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsKeyboardFocusWithin}" Value="True">
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource CloudBrush}"/>
                    <Setter TargetName="FocusHalo" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="FocusHalo" Property="Opacity" Value="1"/>
                    <Setter TargetName="FocusAura" Property="Opacity" Value="0.16"/>
                    <Setter TargetName="InnerFocusRim" Property="Opacity" Value="0.82"/>
                    <Setter TargetName="SelectedSheen" Property="Opacity" Value="0.28"/>
                    <Setter TargetName="CardTextPlate" Property="BorderBrush" Value="{StaticResource BigPictureCardAccentBrush}"/>
                </DataTrigger>
                <!-- Now Playing: pulsing green ring when this game is actively running -->
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="#FF44FFAA"/>
                    <Setter TargetName="CardRoot" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="NowPlayingRing" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- Compact mode: hide the text plate so the frosted play button shows clean -->
                <DataTrigger Binding="{Binding DataContext.IsCloudscapeCompact,
                                              RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="CardTextPlate" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="Horizon3DGameCaseTemplate">
            <Grid Width="214" Height="326" Margin="4,4,4,12"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="270"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <controls:HorizonGameCase3D x:Name="CaseModel" Width="205" Height="266"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Profile="{Binding CaseProfile}"
                                             CoverImagePath="{Binding DisplayCoverImagePath}"/>

                <StackPanel Grid.Row="1" Margin="10,4,10,0">
                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding Platform}" FontSize="10.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="CaseModel" Property="IsCaseFocused" Value="True"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="CaseModel" Property="IsCaseFocused" Value="True"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="BigPictureShelfTemplate">
            <StackPanel Margin="0,0,0,28">
                <DockPanel Margin="0,0,0,8">
                    <!-- See All button: jumps to Library tab filtered to this shelf's category -->
                    <Button DockPanel.Dock="Right" Margin="10,2,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Tag="{Binding Title}"
                            Click="SeeAllShelfClick"
                            Padding="12,5" FontSize="11">
                        See All
                    </Button>
                    <Border DockPanel.Dock="Right" Margin="14,2,0,0" Padding="10,4"
                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                            Background="{DynamicResource ThemePillFillBrush}"
                            BorderBrush="{DynamicResource ThemePillBorderBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding Count, StringFormat={}{0} games}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title}"
                               FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </DockPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="54" Height="1" Margin="0,8,12,0" Fill="{DynamicResource CloudBrush}" Opacity="0.66"/>
                    <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <ListBox ItemsSource="{Binding Games}"
                         Style="{StaticResource BigPictureShelfListStyle}"
                         ItemTemplate="{StaticResource BigPictureGameCardTemplate}"
                         ItemContainerStyle="{StaticResource BigPictureShelfItemStyle}"
                         SelectionChanged="ShelfSelectionChanged"
                         PreviewMouseLeftButtonDown="ShelfPointerDragStart"
                         PreviewMouseMove="ShelfPointerDragMove"
                         PreviewMouseLeftButtonUp="ShelfPointerDragEnd"
                         LostMouseCapture="ShelfPointerDragLost"
                         MouseDoubleClick="ShelfMouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="CloudscapeRoot"
          MouseMove="CloudscapePointerMove"
          MouseLeave="CloudscapePointerLeave"
          PreviewMouseLeftButtonDown="CloudscapePointerDown">
        <Image x:Name="HeroBgA" Stretch="UniformToFill" Opacity="0.2" CacheMode="BitmapCache" RenderOptions.BitmapScalingMode="LowQuality">
            <Image.RenderTransform><TranslateTransform x:Name="HeroBgATransform"/></Image.RenderTransform>
            <Image.Effect><BlurEffect Radius="10"/></Image.Effect>
        </Image>
        <Image x:Name="HeroBgB" Stretch="UniformToFill" Opacity="0" CacheMode="BitmapCache" RenderOptions.BitmapScalingMode="LowQuality">
            <Image.RenderTransform><TranslateTransform x:Name="HeroBgBTransform"/></Image.RenderTransform>
            <Image.Effect><BlurEffect Radius="10"/></Image.Effect>
        </Image>
        <Image Stretch="UniformToFill" Opacity="{DynamicResource NierArtworkOpacity}"
               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"
               Source="pack://application:,,,/Resources/Images/nier_theme.png">
            <Image.OpacityMask>
                <RadialGradientBrush Center="0.66,0.52" GradientOrigin="0.66,0.52" RadiusX="0.92" RadiusY="0.90">
                    <GradientStop Offset="0" Color="#FFFFFFFF"/>
                    <GradientStop Offset="0.62" Color="#D8FFFFFF"/>
                    <GradientStop Offset="0.88" Color="#5CFFFFFF"/>
                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                </RadialGradientBrush>
            </Image.OpacityMask>
        </Image>
        <Image Stretch="UniformToFill" Opacity="{DynamicResource WutheringArtworkOpacity}"
               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"
               Source="pack://application:,,,/Resources/Images/wuwa_theme.jpg">
            <Image.OpacityMask>
                <RadialGradientBrush Center="0.64,0.50" GradientOrigin="0.64,0.50" RadiusX="0.96" RadiusY="0.88">
                    <GradientStop Offset="0" Color="#FFFFFFFF"/>
                    <GradientStop Offset="0.58" Color="#D8FFFFFF"/>
                    <GradientStop Offset="0.86" Color="#58FFFFFF"/>
                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                </RadialGradientBrush>
            </Image.OpacityMask>
        </Image>
        <Grid Opacity="{DynamicResource BlackFlashArtworkOpacity}" IsHitTestVisible="False" ClipToBounds="True">
            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                   Source="pack://application:,,,/Resources/Images/yuji1.png">
                <Image.OpacityMask>
                    <RadialGradientBrush Center="0.72,0.48" GradientOrigin="0.72,0.48" RadiusX="0.88" RadiusY="0.90">
                        <GradientStop Offset="0" Color="#FFFFFFFF"/>
                        <GradientStop Offset="0.50" Color="#D0FFFFFF"/>
                        <GradientStop Offset="0.82" Color="#55FFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </RadialGradientBrush>
                </Image.OpacityMask>
            </Image>
            <Image Stretch="UniformToFill" Width="520" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="80,0,0,-120" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality"
                   Source="pack://application:,,,/Resources/Images/yuji6.png">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00FFFFFF"/>
                        <GradientStop Offset="0.24" Color="#B8FFFFFF"/>
                        <GradientStop Offset="0.70" Color="#88FFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>
            <Image Stretch="UniformToFill" Width="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,60,96,0" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality"
                   Source="pack://application:,,,/Resources/Images/yuji4.png">
                <Image.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
                        <GradientStop Offset="0" Color="#FFFFFFFF"/>
                        <GradientStop Offset="0.56" Color="#A8FFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </RadialGradientBrush>
                </Image.OpacityMask>
            </Image>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.66,0.45" GradientOrigin="0.66,0.45" RadiusX="0.54" RadiusY="0.54">
                        <GradientStop Offset="0" Color="#88FF1D2D"/>
                        <GradientStop Offset="0.34" Color="#34B30015"/>
                        <GradientStop Offset="1" Color="#00000000"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Rectangle Fill="{DynamicResource HeroOverlayBrush}"/>
        <Rectangle Fill="{DynamicResource HeroOverlayBrush}" Opacity="{DynamicResource ThemeShellOverlayOpacity}"/>
        <Rectangle Fill="{DynamicResource ThemeGrainBrush}" Opacity="{DynamicResource ThemeGrainOpacity}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource NostalgiaScanlineBrush}" Opacity="0.018" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource MatrixRainBrush}" Opacity="{DynamicResource ThemeRainOverlayOpacity}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource NierDeletionBrush}" Opacity="{DynamicResource NierDeletionEffectOpacity}" IsHitTestVisible="False"/>
<effects:ThemeEffectLayer ThemeKey="{Binding AppearanceThemeKey}" EffectRole="Cloudscape"
                                  Quality="{Binding EffectsQuality}"
                                      IsEffectActive="{Binding VisualEffectsEnabled}"
                                  Intensity="{Binding EffectiveVisualEffectIntensity}"
                                  Opacity="0.72" IsHitTestVisible="False"/>

        <Grid Margin="38,22,38,20">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CloudscapeTopNav" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.26" BeginTime="0:0:0.00"/>
                            <DoubleAnimation Storyboard.TargetName="CloudscapeTopNavLift" Storyboard.TargetProperty="Y" From="-10" To="0" Duration="0:0:0.26" BeginTime="0:0:0.00"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CloudscapeHeroShell" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" BeginTime="0:0:0.10"/>
                            <DoubleAnimation Storyboard.TargetName="CloudscapeHeroLift" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.30" BeginTime="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CloudscapePageShell" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.30" BeginTime="0:0:0.20"/>
                            <DoubleAnimation Storyboard.TargetName="CloudscapePageLift" Storyboard.TargetProperty="Y" From="14" To="0" Duration="0:0:0.34" BeginTime="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="HeroRow" Height="240"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Nav bar ── -->
            <Grid x:Name="CloudscapeTopNav" Grid.Row="0" Margin="0,0,0,16" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><TranslateTransform x:Name="CloudscapeTopNavLift" Y="-10"/></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cirra" FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="30" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Horizon" Style="{StaticResource MatrixTitleTextStyle}" FontSize="12" Foreground="{DynamicResource CloudBrush}"/>
                </StackPanel>

                <Border Grid.Column="1" Margin="26,2,26,0" Padding="6" HorizontalAlignment="Center"
                        Style="{StaticResource HorizonCommandSurfaceStyle}"
                        Background="{DynamicResource ThemePanelFillSoftBrush}"
                        BorderBrush="{DynamicResource GlassPanelBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource ThemeCornerRadiusPanel}">
                    <ListBox Style="{StaticResource BigPictureNavListStyle}" SelectedIndex="{Binding SelectedCloudscapePage}">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle><StaticResource ResourceKey="BigPictureNavItemStyle"/></ListBox.ItemContainerStyle>
                        <ListBoxItem><TextBlock Text="Home" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="Library" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="Achievements" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="Emulation" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/></ListBoxItem>
                        <ListBoxItem Visibility="{Binding CloudTheatreNavVisibility}">
                            <TextBlock Text="Cloud's Theatre" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </ListBoxItem>
                    </ListBox>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- ── Netflix mode toggle — compact view with more shelf rows visible ── -->
                    <Button x:Name="NetflixToggleBtn"
                            Click="NetflixModeToggleClick"
                            Style="{StaticResource HorizonLiquidButtonStyle}"
                            Padding="11,10" Margin="0,0,10,0"
                            ToolTip="Toggle compact / full view">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NetflixToggleIcon"
                                       Text="&#xE8A9;"
                                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="NetflixToggleLabel"
                                       Text="Compact"
                                       FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="CloudscapeProfileCard" Padding="12,9" Margin="0,0,14,0"
                            Style="{StaticResource ProfileHeroCardStyle}"
                            Background="{DynamicResource ProfileCardBaseBrush}"
                            BorderBrush="{DynamicResource ProfileBadgeBorderBrush}" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Style="{StaticResource ProfileSurfaceAtmosphereOverlayStyle}"/>
                            <Rectangle Style="{StaticResource ProfileSurfacePatternOverlayStyle}"/>
                            <Rectangle Style="{StaticResource ProfileSurfaceSweepOverlayStyle}" Width="116"/>
                            <Border Width="44" Height="44" Margin="0,0,10,0" Style="{StaticResource ProfileAvatarBadgeStyle}">
                                <Grid>
                                    <Ellipse Style="{StaticResource ProfileBadgePulseStyle}" Margin="-4"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding ActiveProfileIconGlyph}"
                                               FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="18"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ActiveProfileName}" FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding ActiveProfileCloudCode}" FontSize="10.5" Foreground="{DynamicResource CloudBrush}"/>
                                <TextBlock Text="{Binding ActiveProfileScoreLine}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ProfileSocialSummary}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="14,10" Margin="0,0,14,0" Style="{StaticResource FeatureDetailCardStyle}" Visibility="Collapsed"
                            Background="{DynamicResource ThemePanelFillSoftBrush}"
                            BorderBrush="{DynamicResource ThemePanelEdgeBrush}">
                        <!-- A2: theme-reactive glow color (was hardcoded parchment #3C3020) -->
                        <Border.Effect><DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.16"/></Border.Effect>
                        <TextBlock Text="Enter to launch / F11 to exit / 1-6 for pages" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Border>
                    <Border Margin="0,0,12,0" Padding="12,8"
                            Style="{StaticResource HorizonGlassSurfaceStyle}"
                            Visibility="{Binding IsShellBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Width="38" Height="3" Margin="0,0,9,0"
                                         VerticalAlignment="Center" Style="{StaticResource BusyBarStyle}"/>
                            <TextBlock Text="{Binding ShellBusyLabel}" FontSize="11"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource HorizonLiquidButtonStyle}" Margin="0" Padding="18,10"
                            Click="CloseBigPictureClick" Content="Exit Horizon"/>
                </StackPanel>
            </Grid>

            <!-- ── Hero ── -->
            <Grid x:Name="CloudscapeHeroShell"
                  Visibility="{Binding TheatreHeroVisibility}"
                  Grid.Row="1" Margin="0,0,0,18" Opacity="0" RenderTransformOrigin="0.5,0.5"
                  MouseMove="HeroParallaxMouseMove" MouseLeave="HeroParallaxMouseLeave">
                <Grid.RenderTransform><TranslateTransform x:Name="CloudscapeHeroLift" Y="14"/></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource HorizonGlassSurfaceStyle}" Margin="0,0,18,0"
                        Background="{DynamicResource BladeGlassBrush}"
                        BorderBrush="{DynamicResource GlassPanelBorderBrush}" Padding="26,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Rectangle Fill="{DynamicResource ThemeShellAtmosphereBrush}" Opacity="0.45" IsHitTestVisible="False"/>
                        <ToggleButton x:Name="SpotlightPauseToggle" Grid.Row="0" Grid.RowSpan="2"
                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Style="{StaticResource GhostToggleButtonStyle}"
                                          Width="36" Height="36" Padding="0" Margin="12,0,0,0"
                                          IsChecked="{Binding HorizonSpotlightPaused, Mode=TwoWay}"
                                          ToolTip="{Binding HorizonSpotlightActionLabel}"
                                          AutomationProperties.Name="{Binding HorizonSpotlightActionLabel}">
                                <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE769;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HorizonSpotlightPaused}" Value="True">
                                                    <Setter Property="Text" Value="&#xE768;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                        </ToggleButton>
                        <DockPanel Grid.Row="0" Margin="0,0,48,0">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding BigPictureHeroContextLabel}"
                                       FontSize="11" Foreground="{DynamicResource CloudBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Margin="0,4,48,0"
                                   Text="{Binding BigPictureHeroGame.Title, TargetNullValue=Cirra}"
                                   FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="34" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="{Binding BigPictureHeroSummary}"
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0">
                                <Border Padding="10,4" Margin="0,0,8,6" Style="{StaticResource VisualFeaturePillStyle}">
                                    <TextBlock Text="{Binding BigPictureHeroGame.ReleaseDateLabel, TargetNullValue=Release date unknown}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Padding="10,4" Margin="0,0,8,6" Style="{StaticResource VisualFeaturePillStyle}">
                                    <TextBlock Text="{Binding BigPictureHeroGame.PlaytimeLabel, TargetNullValue=No tracked playtime}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                                <!-- Critic score badge: only shown when a score exists -->
                                <Border Padding="10,4" Margin="0,0,8,6"
                                        Background="{DynamicResource ThemePanelFillSoftBrush}"
                                        BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                        Visibility="{Binding BigPictureHeroGame.HasCriticRating, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="★" FontSize="10" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding BigPictureHeroGame.CriticRatingLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GoldBrush}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Developer pill -->
                                <Border Padding="10,4" Margin="0,0,8,6" Style="{StaticResource VisualFeaturePillStyle}"
                                        Visibility="{Binding BigPictureHeroGame.HasCriticRating, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding BigPictureHeroGame.DevelopersLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                </Border>
                                <!-- Live session pill: shown only when hero game is running -->
                                <Border Padding="10,4" Margin="0,0,8,6"
                                        Background="{DynamicResource ThemePanelFillSoftBrush}"
                                        BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                        Visibility="{Binding BigPictureHeroGame.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding BigPictureHeroGame.LiveSessionLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GoldBrush}"/>
                                </Border>
                                <Border Padding="10,4" Margin="0,0,8,6" Style="{StaticResource GlassMetricChipStyle}">
                                    <TextBlock Text="{Binding BigPictureHeroGame.AchievementSummary, TargetNullValue=No synced achievements yet}" FontSize="11" Foreground="{DynamicResource GoldBrush}"/>
                                </Border>
                                <!-- Platform + Status pill -->
                                <Border Padding="10,4" Margin="0,0,8,6" Style="{StaticResource VisualFeaturePillStyle}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding BigPictureHeroGame.Platform, TargetNullValue=Unknown}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding BigPictureHeroGame.Status, TargetNullValue=Unplayed}"/>
                                    </TextBlock>
                                </Border>
                            </WrapPanel>
                            <WrapPanel Grid.Row="1">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="LaunchHeroGameClick" Content="Launch"/>
                                <Button Style="{StaticResource HorizonLiquidButtonStyle}" Click="BrowseHeroGameClick" Content="Browse Library"/>
                                <Button Style="{StaticResource HorizonLiquidButtonStyle}" Click="OpenHeroAchievementsClick" Content="View Achievements"/>
                                <Button Style="{StaticResource HorizonLiquidButtonStyle}" Click="OpenHeroTrailerClick"
                                        IsEnabled="{Binding BigPictureHeroGame.CanOpenTrailer}" Content="Watch Trailer"/>
                                <Button Style="{StaticResource HorizonLiquidButtonStyle}" Click="OpenHeroWebsiteClick"
                                        IsEnabled="{Binding BigPictureHeroGame.CanOpenWebsite}" Content="Open Website"/>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" x:Name="CloudscapeHeroCoverShell"
                        Style="{StaticResource MediaAssetCardStyle}"
                        Background="{DynamicResource ThemePanelFillSoftBrush}"
                        BorderBrush="{DynamicResource ThemePanelEdgeBrush}" ClipToBounds="True">
                    <Border.RenderTransform><TranslateTransform x:Name="CloudscapeHeroCoverParallax"/></Border.RenderTransform>
                    <Grid>
                        <controls:CrossfadeImage Stretch="UniformToFill"
                                                 Source="{Binding BigPictureHeroGame.DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=hero}"/>
                        <Rectangle VerticalAlignment="Bottom" Height="72" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000"/>
                                    <GradientStop Offset="1" Color="#90120E0B"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Grid Visibility="{Binding BigPictureHeroGame.HasCoverImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Border Background="{DynamicResource SurfaceHighBrush}"/>
                            <TextBlock Text="{Binding BigPictureHeroGame.Initials, TargetNullValue=CB}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="52"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        <Rectangle VerticalAlignment="Bottom" Height="90">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000"/>
                                    <GradientStop Offset="1" Color="#E61A1410"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12">
                            <TextBlock Text="{Binding BigPictureHeroGame.Title, TargetNullValue=Cirra}"
                                       FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource BigPictureCardTitleBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Page content ── -->
            <TabControl x:Name="CloudscapePageShell" Grid.Row="2"
                        SelectedIndex="{Binding SelectedCloudscapePage}"
                        Style="{StaticResource InvisibleTabControlStyle}"
                        Opacity="0" RenderTransformOrigin="0.5,0.5">
                <TabControl.RenderTransform><TranslateTransform x:Name="CloudscapePageLift" Y="16"/></TabControl.RenderTransform>

                <!-- Home -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Search bar -->
                        <Border Grid.Row="0" Margin="0,0,0,14" Padding="14,10"
                                Style="{StaticResource HorizonCommandSurfaceStyle}"
                                Background="{DynamicResource ThemePanelFillSoftBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ThemeCornerRadiusPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{DynamicResource GlassInputBrush}"
                                        BorderBrush="{DynamicResource GlassPanelBorderBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusSmall}" Padding="12,0">
                                    <Grid>
                                        <TextBlock FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                                   FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="{Binding BigPictureIsSearching, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <Run Text="&#xE721;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"/>
                                            <Run Text="  Search your library..."/>
                                        </TextBlock>
                                        <TextBox x:Name="BigPictureSearchBox"
                                                 AutomationProperties.Name="Search library"
                                                 Text="{Binding BigPictureSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextFieldStyle}" Height="34"
                                                 BorderThickness="0" Background="Transparent"
                                                 FontSize="13" VerticalContentAlignment="Center"
                                                 KeyDown="BigPictureSearchBoxKeyDown"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="PLAY WINDOW" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding PlayWindowOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Minutes"
                                              SelectedValue="{Binding SelectedPlayWindowMinutes, Mode=TwoWay}"
                                              MinWidth="126" Height="34"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="2" Margin="10,0,0,0"
                                        Style="{StaticResource GhostButtonStyle}" Padding="12,8"
                                        Click="BigPictureSearchClearClick"
                                        Visibility="{Binding BigPictureIsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Content="&#x2715; Clear"/>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="CloudscapeHomeScroll"
                                      Style="{StaticResource HorizonScrollViewerStyle}"
                                      Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BigPictureHomeShelves}" ItemTemplate="{StaticResource BigPictureShelfTemplate}"
                                          Visibility="{Binding BigPictureIsSearching, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </ScrollViewer>
                        <Border Grid.Row="1"
                                Background="Transparent"
                                Visibility="{Binding HasGames, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                                <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                           FontSize="{DynamicResource FontSizeHeading}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextAlignment="Center"
                                           Text="Your library is empty"/>
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="Head back to the desktop view to scan a folder or add a game, then come back to browse it here."/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" Style="{StaticResource HorizonScrollViewerStyle}" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding BigPictureIsSearching, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Search results shelf -->
                            <ItemsControl ItemsSource="{Binding BigPictureSearchShelves}" ItemTemplate="{StaticResource BigPictureShelfTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Library -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="LibraryFilterPanel" Grid.Row="0" Style="{StaticResource HorizonGlassSurfaceStyle}"
                                Background="{DynamicResource ThemePanelFillSoftBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button x:Name="LibraryViewToggleButton" DockPanel.Dock="Right"
                                            Style="{StaticResource HorizonLiquidIconButtonStyle}"
                                            Click="LibraryViewToggleClick" ToolTip="Switch to cover grid">
                                        <TextBlock x:Name="LibraryViewToggleIcon" Text="&#xE80A;"
                                                   FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="17"/>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="Library" FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Margin="0,3,0,0" Text="{Binding BigPictureSelectedCategorySummary}"
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                                <ListBox ItemsSource="{Binding BigPictureLibraryCategories}"
                                         Style="{StaticResource BigPictureNavListStyle}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         SelectedItem="{Binding SelectedBigPictureLibraryCategory}">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle><StaticResource ResourceKey="BigPictureCategoryItemStyle"/></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Rectangle HorizontalAlignment="Right" Width="68" Fill="{DynamicResource ThemeSweepBrush}" Opacity="0.20" IsHitTestVisible="False"/>
                                                <StackPanel Grid.RowSpan="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding Count, StringFormat={}{0} titles}"
                                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!-- Sort pills -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Sort:" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Tag="default" Click="BigPictureLibrarySortClick"
                                            Style="{StaticResource HorizonLiquidButtonStyle}" Margin="0,0,6,0"
                                            Padding="12,5" FontSize="11">Default</Button>
                                    <Button Tag="az" Click="BigPictureLibrarySortClick"
                                            Style="{StaticResource HorizonLiquidButtonStyle}" Margin="0,0,6,0"
                                            Padding="12,5" FontSize="11">A–Z</Button>
                                    <Button Tag="rating" Click="BigPictureLibrarySortClick"
                                            Style="{StaticResource HorizonLiquidButtonStyle}" Margin="0,0,6,0"
                                            Padding="12,5" FontSize="11">Rating</Button>
                                    <Button Tag="playtime" Click="BigPictureLibrarySortClick"
                                            Style="{StaticResource HorizonLiquidButtonStyle}" Margin="0,0,6,0"
                                            Padding="12,5" FontSize="11">Playtime</Button>
                                    <Button Tag="recent" Click="BigPictureLibrarySortClick"
                                            Style="{StaticResource HorizonLiquidButtonStyle}"
                                            Padding="12,5" FontSize="11">Recent</Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" Style="{StaticResource HorizonScrollViewerStyle}" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsBigPictureLibraryGrid, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding BigPictureLibraryShelves}" ItemTemplate="{StaticResource BigPictureShelfTemplate}"/>
                        </ScrollViewer>
                        <ListBox x:Name="LibraryGridList" Grid.Row="1"
                                 ItemsSource="{Binding BigPictureLibraryGridGames}"
                                 SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                 Style="{StaticResource HorizonGridListStyle}"
                                 ItemContainerStyle="{StaticResource HorizonGridItemStyle}"
                                 ItemTemplate="{StaticResource Horizon3DGameCaseTemplate}"
                                 Visibility="{Binding IsBigPictureLibraryGrid, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 SelectionChanged="LibraryGridSelectionChanged"
                                 MouseDoubleClick="ShelfMouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="222" ItemHeight="342"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Border Grid.Row="1"
                                Background="Transparent"
                                Visibility="{Binding HasGames, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                                <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                           FontSize="{DynamicResource FontSizeHeading}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextAlignment="Center"
                                           Text="Your library is empty"/>
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="Head back to the desktop view to scan a folder or add a game, then come back to browse it here."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Achievements -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ── Left rail: game list ── -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Stats header -->
                            <Border Grid.Row="0" Padding="16,14" Margin="0,0,12,8"
                                    Style="{StaticResource HorizonGlassSurfaceStyle}"
                                    Background="{DynamicResource ThemePanelFillSoftBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ThemeCornerRadiusPanel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                   FontSize="15" Foreground="{DynamicResource GoldBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Achievement Center"
                                                   FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Global progress bar -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0" Height="5"
                                                     Minimum="0" Maximum="{Binding TotalAchievementsCount}"
                                                     Value="{Binding UnlockedAchievementsCount, Mode=OneWay}"
                                                     Style="{StaticResource BusyBarStyle}"
                                                     IsIndeterminate="False"
                                                     Foreground="{DynamicResource GoldBrush}"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource GoldBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}/{1}">
                                                    <Binding Path="UnlockedAchievementsCount"/>
                                                    <Binding Path="TotalAchievementsCount"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                    <!-- Gamer score + synced games summary -->
                                    <WrapPanel Grid.Row="2">
                                        <Border Padding="8,3" Margin="0,0,6,0"
                                                Background="{DynamicResource GlassMetricChipBrush}"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}">
                                            <TextBlock Text="{Binding LibraryGamerScoreLabel}" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource GoldBrush}"/>
                                        </Border>
                                        <Border Padding="8,3"
                                                Background="{DynamicResource GlassMetricChipBrush}"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding GamesWithAchievementsCount, Mode=OneWay}"/>
                                                <Run Text=" synced games"/>
                                            </TextBlock>
                                        </Border>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <!-- Sync all row -->
                            <Border Grid.Row="1" Padding="12,10" Margin="0,0,12,8"
                                    Style="{StaticResource HorizonInsetSurfaceStyle}"
                                    Background="{DynamicResource ThemePanelFillSoftBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AchievementTrackingSummary}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BigPictureSyncAchievementsClick"
                                            Padding="12,6" VerticalAlignment="Center" FontSize="11"
                                            Content="&#xE895;  Sync All"/>
                                </Grid>
                            </Border>

                            <!-- Scrollable game list -->
                            <ScrollViewer Grid.Row="2" Style="{StaticResource HorizonScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                                <ItemsControl ItemsSource="{Binding Games}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,5" Padding="10,8" Cursor="Hand"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    Visibility="{Binding HasAchievements, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    MouseLeftButtonUp="AchievementGameRowClick">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ThemePanelFillSoftBrush}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BladeGlassBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="38"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Cover thumbnail -->
                                                    <Border Grid.Column="0" Width="36" Height="48"
                                                            CornerRadius="4" ClipToBounds="True"
                                                            Background="{DynamicResource SurfaceHighBrush}">
                                                        <Image Stretch="UniformToFill"
                                                               Source="{Binding DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                                                    </Border>
                                                    <!-- Title + progress -->
                                                    <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Margin="0,2,0,0" Text="{Binding AchievementSummary}"
                                                                   FontSize="10" Foreground="{DynamicResource GoldBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <ProgressBar Margin="0,4,0,0" Height="3"
                                                                     Minimum="0" Maximum="100"
                                                                     Value="{Binding AchievementCompletionPercent, Mode=OneWay}"
                                                                     Background="{DynamicResource SurfaceHighBrush}"
                                                                     Foreground="{DynamicResource GoldBrush}"
                                                                     BorderThickness="0"/>
                                                    </StackPanel>
                                                    <!-- Completion % -->
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                               FontSize="11" FontWeight="Bold" TextAlignment="Right"
                                                               Foreground="{DynamicResource GoldBrush}">
                                                        <TextBlock.Text>
                                                            <Binding Path="AchievementCompletionPercent" StringFormat="{}{0:0}%"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- ── Right panel: selected game detail ── -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- No game selected placeholder -->
                            <Border Grid.RowSpan="2" Padding="0,48"
                                    Visibility="{Binding SelectedGame.HasAchievements, FallbackValue=Visible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                               FontSize="52" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}" Opacity="0.35"/>
                                    <TextBlock Margin="0,14,0,0" Text="Pick a game from the list"
                                               FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="20"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Margin="0,6,0,0" Text="Synced games appear on the left."
                                               FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Selected game hero block -->
                            <Border Grid.Row="0" Padding="18,16" Margin="0,0,0,10"
                                    Background="{DynamicResource ThemePanelFillSoftBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                    Visibility="{Binding SelectedGame.HasAchievements, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Cover -->
                                    <Border Grid.Column="0" Width="80" Height="108"
                                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}" ClipToBounds="True"
                                            Background="{DynamicResource SurfaceHighBrush}">
                                        <Image Stretch="UniformToFill"
                                               Source="{Binding SelectedGame.DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=hero}"/>
                                    </Border>
                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedGame.Title}"
                                                   FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- Overall progress bar -->
                                        <Grid Margin="0,8,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Height="5"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding SelectedGame.AchievementCompletionPercent, Mode=OneWay}"
                                                         Style="{StaticResource BusyBarStyle}"
                                                         IsIndeterminate="False"
                                                         Foreground="{DynamicResource GoldBrush}"
                                                         VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource GoldBrush}">
                                                <TextBlock.Text>
                                                    <Binding Path="SelectedGame.AchievementCompletionPercent" StringFormat="{}{0:0}%"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                        <!-- Stat pills row -->
                                        <WrapPanel>
                                            <Border Padding="8,3" Margin="0,0,6,4"
                                                    Background="{DynamicResource GlassMetricChipBrush}"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}">
                                                <TextBlock Text="{Binding SelectedGame.AchievementSummary}" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource GoldBrush}"/>
                                            </Border>
                                            <Border Padding="8,3" Margin="0,0,6,4"
                                                    Background="{DynamicResource GlassMetricChipBrush}"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}">
                                                <TextBlock Text="{Binding SelectedGame.GamerScoreLabel}" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Padding="8,3" Margin="0,0,0,4"
                                                    Background="{DynamicResource GlassMetricChipBrush}"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}">
                                                <TextBlock Text="{Binding SelectedGame.AchievementsLastSyncedLabel}" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Margin="0,2,0,0" Text="{Binding SelectedGame.AchievementSourceLabel}"
                                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,2,0">
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Click="BigPictureSyncAchievementsClick"
                                                IsEnabled="{Binding SelectedGame.CanSyncAchievements}"
                                                Padding="14,8" FontSize="12" Content="&#xE895;  Sync"/>
                                        <!-- Steam App ID inline editor -->
                                        <Border Margin="0,8,0,0" Padding="10,6"
                                                Background="{DynamicResource GlassInputBrush}"
                                                BorderBrush="{DynamicResource GlassPanelBorderBrush}" BorderThickness="1"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusSmall}">
                                            <StackPanel>
                                                <TextBlock Text="STEAM APP ID" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding SelectedGame.SteamAppId, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource TextFieldStyle}"
                                                         Width="120" Height="26" FontSize="11"
                                                         BorderThickness="0" Background="Transparent"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="Steam App ID for achievement sync"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Achievement list with filter tabs -->
                            <Grid Grid.Row="1"
                                  Visibility="{Binding SelectedGame.HasAchievements, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Filter strip: Unlocked / Locked / All -->
                                <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,6"
                                        Background="{DynamicResource ThemePanelFillSoftBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusControl}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Show:" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Padding="11,4" FontSize="11"
                                                Margin="0,0,5,0" Tag="all" Click="AchievementFilterClick">All</Button>
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Padding="11,4" FontSize="11"
                                                Margin="0,0,5,0" Tag="unlocked" Click="AchievementFilterClick">&#xE930; Unlocked</Button>
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Padding="11,4" FontSize="11"
                                                Tag="locked" Click="AchievementFilterClick">&#xE72E; Locked</Button>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="1" Style="{StaticResource HorizonScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AchievementItemsControl"
                                                  ItemsSource="{Binding SelectedGame.Achievements}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,5" Padding="12,10"
                                                        CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource ThemePanelFillSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource MintDimBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource MintBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Icon with lock overlay -->
                                                        <Border Grid.Column="0" Width="40" Height="40"
                                                                CornerRadius="8" ClipToBounds="True"
                                                                Background="{DynamicResource SurfaceHighBrush}">
                                                            <Grid>
                                                                <Image Stretch="UniformToFill"
                                                                       Source="{Binding DisplayIconUrl, Converter={StaticResource StringToImageSourceConverter}}"/>
                                                                <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="8"
                                                                        Visibility="{Binding IsUnlocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Title + description + rarity -->
                                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                                                <Border Margin="8,0,0,0" Padding="5,2"
                                                                        CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                                        Background="{DynamicResource GlassChipFillBrush}"
                                                                        Visibility="{Binding IsHidden, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="HIDDEN" FontSize="9" FontWeight="Bold"
                                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Margin="0,3,0,0" Text="{Binding DescriptionOrPlaceholder}"
                                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding RarityLabel}" FontSize="10"
                                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Margin="8,0,0,0"
                                                                           Text="{Binding UnlockStateLabel}" FontSize="10"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           Visibility="{Binding IsUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <!-- Score chip -->
                                                        <Border Grid.Column="2" Padding="8,4" CornerRadius="6"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource GlassMetricChipBrush}">
                                                            <TextBlock Text="{Binding GamerScoreValue, StringFormat={}{0} G}"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="{DynamicResource GoldBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Settings -->
                <TabItem>
                    <ScrollViewer Style="{StaticResource HorizonScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource HorizonGlassSurfaceStyle}" Margin="0,0,14,0">
                                    <StackPanel>
                                        <TextBlock Text="Library" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Text="{Binding LibrarySummary}" FontSize="16"
                                                   FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,10,0,0" Text="{Binding StorageLocation}" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource HorizonGlassSurfaceStyle}">
                                    <StackPanel>
                                        <TextBlock Text="LIBRARY TOOLS" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Text="Scan, refresh art, and sync achievements." FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="BigPictureScanFolderClick" Content="Scan Games"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Click="BigPictureFillMetadataClick" Content="Fill Metadata"/>
                                            <Button Style="{StaticResource GhostButtonStyle}" Click="BigPictureSyncAchievementsClick" Content="Sync Achievements"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource ProfileHeroCardStyle}" Padding="0" ClipToBounds="True">
                                <Grid>
                                    <Rectangle Style="{StaticResource ProfileSurfaceAtmosphereOverlayStyle}"/>
                                    <Rectangle Style="{StaticResource ProfileSurfacePatternOverlayStyle}"/>
                                    <Rectangle Style="{StaticResource ProfileSurfaceSweepOverlayStyle}" Width="220"/>
                                    <Grid Margin="22,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="96"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="{Binding ActiveProfileName}"
                                                       FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                       FontSize="24" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ActiveProfileScoreLine}" Margin="0,6,0,0"
                                                       FontSize="14" Foreground="{DynamicResource CloudBrush}"/>
                                            <WrapPanel Margin="0,16,0,0">
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Click="OpenDesktopManagerClick" Content="Open Desktop Manager"/>
                                                <Button Style="{StaticResource GhostButtonStyle}" Click="CloseBigPictureClick" Content="Exit Horizon"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Style="{StaticResource ProfileAvatarHeroStyle}">
                                            <Grid>
                                                <Ellipse Style="{StaticResource ProfileBadgePulseStyle}" Margin="-8"/>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="40"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding ActiveProfileIconGlyph}"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Emulation Station -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource HorizonGlassSurfaceStyle}"
                                Background="{DynamicResource ThemePanelFillSoftBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ThemeCornerRadiusPanel}" Padding="22,16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Emulation Station" FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="22" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Margin="0,4,0,12" Text="{Binding BigPictureEmulationSummary}"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Configure Emulators" Click="OpenEmulatorSettingsClick"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,7" FontSize="12"
                                            VerticalAlignment="Top"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding BigPictureEmulationPlatforms}"
                                         Style="{StaticResource BigPictureNavListStyle}"
                                         SelectedItem="{Binding SelectedBigPictureEmulationPlatform}">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle><StaticResource ResourceKey="BigPictureCategoryItemStyle"/></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Rectangle HorizontalAlignment="Right" Width="68" Fill="{DynamicResource ThemeSweepBrush}" Opacity="0.20" IsHitTestVisible="False"/>
                                                <StackPanel Grid.RowSpan="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Margin="0,3,0,0" Text="{Binding Subtitle}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding Count, StringFormat={}{0} titles}"
                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!-- Quick stat row -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}">
                                        <Run Text="{Binding EmulationRomCount, Mode=OneWay, StringFormat={}{0} ROMs total}"/>
                                    </TextBlock>
                                    <TextBlock Margin="16,0,0,0" FontSize="11.5" Foreground="{DynamicResource GoldBrush}"
                                               Visibility="{Binding HasEmulationGamesNeedingCore, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Run Text="{Binding EmulationNeedsCoreCount, Mode=OneWay}"/>
                                        <Run Text=" need a core configured"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" Style="{StaticResource HorizonScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BigPictureEmulationShelves}" ItemTemplate="{StaticResource BigPictureShelfTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Cloud's Theatre -->
                <TabItem Visibility="{Binding CloudTheatreNavVisibility}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Command bar -->
                        <Border Grid.Row="0" Padding="12,8"
                                Style="{StaticResource HorizonCommandSurfaceStyle}"
                                Background="{DynamicResource BladeGlassBrush}"
                                BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="9,6" Click="TheatreBackClick"    Content="&#x2190;" ToolTip="Back"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="9,6" Click="TheatreForwardClick" Content="&#x2192;" ToolTip="Forward"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="9,6" Click="TheatreRefreshClick" Content="&#x27F3;" ToolTip="Refresh"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="9,6" Click="TheatreHomeClick"    Content="&#x2302;" ToolTip="Home"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{DynamicResource GlassInputBrush}"
                                        BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusSmall}"
                                        Padding="10,0">
                                    <TextBox x:Name="TheatreAddressBox"
                                             Style="{StaticResource TextFieldStyle}"
                                             Text="{Binding TheatreAddressText, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" FontSize="13"
                                             BorderThickness="0" Background="Transparent"
                                             KeyDown="TheatreAddressBoxKeyDown"/>
                                </Border>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="10,6"
                                            Click="NavigateTheatreAddressClick" Content="Go" ToolTip="Navigate"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="10,6"
                                            Click="TheatreSaveSiteClick" Content="&#x2605; Save" ToolTip="Save current site"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="10,6"
                                            Click="TheatreToggleSidebarClick" Content="&#x2630;" ToolTip="Toggle saved sites"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="10,6"
                                            Click="EnterTheatreWatchModeClick" Content="&#x25B6;&#xA0;Watch"
                                            Visibility="{Binding TheatreExitWatchVisibility, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            ToolTip="Watch mode"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="10,6"
                                            Click="ExitTheatreWatchModeClick" Content="&#x25A3;&#xA0;Library"
                                            Visibility="{Binding TheatreExitWatchVisibility}"
                                            ToolTip="Exit watch mode"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sidebar + Browser -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="200"
                                    Visibility="{Binding TheatreSidebarVisibility}"
                                    Background="{DynamicResource BladeGlassBrush}"
                                    BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                                    BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="14,10"
                                            BorderBrush="{DynamicResource GlassPanelBorderBrush}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="SAVED SITES" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SavedTheatreSites}"
                                             SelectedItem="{Binding SelectedSavedSite}"
                                             SelectionChanged="SavedSiteSelectionChanged"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Padding="2,4" ToolTip="{Binding Url}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Grid.Row="2" Padding="10,8"
                                            BorderBrush="{DynamicResource GlassPanelBorderBrush}" BorderThickness="0,1,0,0">
                                        <Button Style="{StaticResource GhostButtonStyle}" Content="Remove Selected"
                                                FontSize="11" Padding="8,5" HorizontalAlignment="Stretch"
                                                Click="RemoveSavedSiteClick"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <wv2:WebView2 Grid.Column="1" x:Name="CloudTheatreBrowser"
                                          CoreWebView2InitializationCompleted="CloudTheatreBrowser_InitCompleted"/>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Status bar -->
            <DockPanel Grid.Row="3" Margin="0,10,0,2">
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border x:Name="ControllerActionLegend"
                            Margin="0,0,14,0" Padding="10,5"
                            CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                            Background="{DynamicResource GlassChipFillBrush}"
                            BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                            BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ControllerDeviceText" Margin="0,0,10,0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}"/>
                            <TextBlock Text="LB/RB" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CloudBrush}"/>
                            <TextBlock Text=" Pages" Margin="3,0,12,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="A" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MintBrush}"/>
                            <TextBlock x:Name="ControllerActionAText" Text=" Details" Margin="3,0,12,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel x:Name="ControllerActionXGroup" Orientation="Horizontal">
                                <TextBlock Text="X" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CloudBrush}"/>
                                <TextBlock x:Name="ControllerActionXText" Text=" View" Margin="3,0,12,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="ControllerActionYGroup" Orientation="Horizontal">
                                <TextBlock Text="Y" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}"/>
                                <TextBlock x:Name="ControllerActionYText" Text=" Search" Margin="3,0,12,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="B" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BerryBrush}"/>
                            <TextBlock Text=" Exit" Margin="3,0,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding SelectedGame.Title, TargetNullValue=No title selected}"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <Border x:Name="HorizonScrollPulse"
                Width="4" Height="132"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,10,0"
                Background="{DynamicResource CloudBrush}"
                BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                Opacity="0" IsHitTestVisible="False" Panel.ZIndex="79">
            <Border.RenderTransform>
                <TranslateTransform x:Name="HorizonScrollPulseTransform" Y="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ThemePrimaryButtonGlowColor}"
                                  BlurRadius="16" ShadowDepth="0" Opacity="0.42"/>
            </Border.Effect>
        </Border>

        <Ellipse x:Name="CloudscapePointerGlow" Width="112" Height="112"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="80">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="{DynamicResource ThemePointerGlowCenterColor}"/>
                    <GradientStop Offset="0.28" Color="{DynamicResource ThemePointerGlowMidColor}"/>
                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="CloudscapePointerGlowTransform" X="-600" Y="-600"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="CloudscapeClickPulse" Width="20" Height="20"
                 HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"
                 Opacity="0" Stroke="{DynamicResource CloudBrush}" StrokeThickness="1.6"
                 Fill="Transparent" IsHitTestVisible="False" Panel.ZIndex="81">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CloudscapeClickPulseScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="CloudscapeClickPulseTransform" X="-600" Y="-600"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Border x:Name="CloudscapeDragCue" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,56" Padding="16,8" CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                Background="{DynamicResource ThemePanelFillSoftBrush}" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False" Panel.ZIndex="82">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0"   Color="#44EEE4CC"/>
                    <GradientStop Offset="0.5" Color="#88C8A870"/>
                    <GradientStop Offset="1"   Color="#44EEE4CC"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <!-- A2: theme-reactive glow color (was hardcoded parchment #8A7040) -->
                <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>
            <TextBlock Text="Browsing shelf" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>

        <Border x:Name="CardTrailerPreviewHost" Width="220" Height="310"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CloudBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource ThemeCornerRadiusLarge}" ClipToBounds="True"
                Opacity="0" Visibility="Collapsed" Panel.ZIndex="96"
                IsHitTestVisible="False">
            <Grid>
                <Rectangle Fill="{DynamicResource ThemeShellAtmosphereBrush}" Opacity="0.32"/>
                <Border x:Name="CardTrailerPreviewFallback" Padding="18" Background="{DynamicResource ThemePanelFillBrush}"
                        Visibility="Collapsed" Panel.ZIndex="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="34"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource CloudBrush}"/>
                        <TextBlock Margin="0,10,0,0" Text="Trailer preview unavailable" FontSize="13" FontWeight="SemiBold"
                                   TextAlignment="Center" Foreground="{DynamicResource TextOnDarkBrush}"/>
                        <TextBlock Margin="0,4,0,0" Text="Open the trailer from the game details." FontSize="11"
                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <wv2:WebView2 x:Name="CardTrailerPreviewBrowser" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             NOW PLAYING BAR — persistent strip while a game is running
             Panel.ZIndex=85 so it floats over shelves but under the detail overlay.
             ══════════════════════════════════════════════════════════════════ -->
        <Border x:Name="NowPlayingBar"
                Grid.ColumnSpan="3"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Margin="30,0,30,14"
                Padding="18,12,18,12"
                CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                BorderThickness="1"
                Opacity="0"
                Visibility="Collapsed"
                Panel.ZIndex="85"
                IsHitTestVisible="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#E8100C09"/>
                    <GradientStop Offset="1" Color="#CC1A1410"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#60C8A870"/>
                    <GradientStop Offset="0.5" Color="#88EEE4CC"/>
                    <GradientStop Offset="1" Color="#44C8A870"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#C8A870" BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Pulsing live dot -->
                <Grid Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="NowPlayingPulseRing" Width="24" Height="24"
                             Stroke="{DynamicResource MintBrush}" StrokeThickness="1.5" Fill="Transparent"
                             Opacity="0">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="NowPlayingPulseScale" ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="NowPlayingPulseRing" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:1.8"/>
                                        <DoubleAnimation Storyboard.TargetName="NowPlayingPulseScale" Storyboard.TargetProperty="ScaleX" From="0.7" To="1.6" Duration="0:0:1.8"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="NowPlayingPulseScale" Storyboard.TargetProperty="ScaleY" From="0.7" To="1.6" Duration="0:0:1.8"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource MintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Effect><DropShadowEffect Color="#55FFAA" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                    </Ellipse>
                </Grid>
                <!-- Game info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,16,0">
                    <TextBlock Text="NOW PLAYING"
                               FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource MintBrush}" Opacity="0.85"
                               FontFamily="{DynamicResource ThemeBodyFontFamily}"/>
                    <TextBlock x:Name="NowPlayingTitle"
                               Text="{Binding RunningGameTitle}"
                               FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    <TextBlock x:Name="NowPlayingSessionLabel"
                               Text="{Binding RunningGameSessionLabel}"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <!-- Achievement progress mini-bar -->
                <Border Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" MinWidth="120">
                    <StackPanel>
                        <TextBlock Text="{Binding RunningGameAchievementLabel}"
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <ProgressBar Value="{Binding RunningGameAchievementProgress, Mode=OneWay}"
                                     Minimum="0" Maximum="100"
                                     Height="3" Width="120"
                                     Style="{StaticResource BusyBarStyle}"
                                     IsIndeterminate="False"
                                     Foreground="{DynamicResource GoldBrush}"/>
                    </StackPanel>
                </Border>
                <!-- Reveal button -->
                <Button Grid.Column="3" Style="{StaticResource GhostButtonStyle}" Padding="14,8"
                        Click="NowPlayingRevealClick" Content="Reveal"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             GAME DETAIL FULL-SCREEN OVERLAY
             Slides in from the right when a shelf card is clicked (single click).
             Press Escape or Back button to dismiss. Launch from here.
             Panel.ZIndex=90 — above everything except the launch handoff (999).
             ══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="CloudscapeDetailOverlay"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="90">
            <!-- Full-bleed blurred background art -->
            <Image x:Name="DetailBgImage"
                   Stretch="UniformToFill"
                   Opacity="0.28"
                   CacheMode="BitmapCache"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.Effect><BlurEffect Radius="14"/></Image.Effect>
            </Image>
            <!-- Dark atmospheric scrim -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#F2080C0E"/>
                        <GradientStop Offset="0.55" Color="#DC0C1016"/>
                        <GradientStop Offset="1" Color="#A80C1016"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Slide-in content panel -->
            <Grid Margin="30,24,30,24">
                <Grid.RenderTransform><TranslateTransform x:Name="DetailPanelLift" X="60"/></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Back button + title row -->
                <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                    <Button DockPanel.Dock="Left"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="14,9"
                            Click="DetailBackClick"
                            Content="&#x2190;  Back"/>
                    <TextBlock x:Name="DetailPlatformLabel"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding CloudscapeDetailGame.Platform}"
                               Margin="0,0,4,0"/>
                    <TextBlock x:Name="DetailTitle"
                               VerticalAlignment="Center"
                               Margin="18,0,0,0"
                               FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding CloudscapeDetailGame.Title}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <!-- Left: metadata + summary + actions -->
                <ScrollViewer Grid.Row="1" Grid.Column="0"
                              Style="{StaticResource HorizonScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,24,0">
                    <StackPanel>
                        <!-- Meta pills -->
                        <WrapPanel Margin="0,0,0,16">
                            <Border Style="{StaticResource VisualFeaturePillStyle}" Margin="0,0,8,8" Padding="10,4">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding CloudscapeDetailGame.Status}"/>
                            </Border>
                            <Border Style="{StaticResource VisualFeaturePillStyle}" Margin="0,0,8,8" Padding="10,4">
                                <TextBlock FontSize="11" Foreground="{DynamicResource GoldBrush}"
                                           Text="{Binding CloudscapeDetailGame.CriticRatingLabel}"/>
                            </Border>
                            <Border Style="{StaticResource VisualFeaturePillStyle}" Margin="0,0,8,8" Padding="10,4">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding CloudscapeDetailGame.PlaytimeLabel}"/>
                            </Border>
                            <Border Style="{StaticResource VisualFeaturePillStyle}" Margin="0,0,8,8" Padding="10,4">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding CloudscapeDetailGame.AchievementSummary}"/>
                            </Border>
                        </WrapPanel>
                        <!-- Developer + release -->
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding CloudscapeDetailGame.DevelopersLabel}"
                                   Margin="0,0,0,14"/>
                        <!-- Achievement progress bar -->
                        <StackPanel Margin="0,0,0,20">
                            <DockPanel Margin="0,0,0,5">
                                <TextBlock DockPanel.Dock="Right"
                                           FontSize="11" Foreground="{DynamicResource GoldBrush}"
                                           Text="{Binding CloudscapeDetailGame.AchievementSummary}"/>
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="ACHIEVEMENTS"/>
                            </DockPanel>
                            <ProgressBar Value="{Binding CloudscapeDetailGame.AchievementCompletionPercent, Mode=OneWay}"
                                         Minimum="0" Maximum="100" Height="4"
                                         IsIndeterminate="False"
                                         Style="{StaticResource BusyBarStyle}"
                                         Foreground="{DynamicResource GoldBrush}"/>
                        </StackPanel>
                        <!-- Summary text -->
                        <TextBlock FontSize="13" LineHeight="22"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding CloudscapeDetailGame.SummaryOrPlaceholder}"
                                   Margin="0,0,0,24"/>
                        <!-- Private return-to-game context -->
                        <Border Margin="0,0,0,22"
                                Padding="14,12"
                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                Background="{DynamicResource GlassChipActiveFillBrush}"
                                BorderBrush="{DynamicResource GlassButtonBorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding CloudscapeDetailGame.HasNextTimeNote, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,2,0,0"
                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           FontSize="15"
                                           Foreground="{DynamicResource CloudBrush}"
                                           Text="&#xE70B;"/>
                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Margin="12,0,0,0"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding CloudscapeDetailGame.NextTimeUpdatedLabel}"/>
                                        <TextBlock FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource CloudBrush}"
                                                   Text="NEXT TIME"/>
                                    </DockPanel>
                                    <TextBlock Margin="0,6,0,0"
                                               MaxHeight="78"
                                               FontSize="13"
                                               LineHeight="20"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding CloudscapeDetailGame.NextTimeNote}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Original-format manuals and guides -->
                        <StackPanel Margin="0,0,0,22"
                                    Visibility="{Binding CloudscapeDetailGame.HasGuidebooks, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding CloudscapeDetailGame.GuidebookCountLabel}"/>
                                <TextBlock FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource CloudBrush}"
                                           Text="GUIDES &amp; MANUALS"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding CloudscapeDetailGame.Guidebooks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="12,9" Margin="0,0,0,6"
                                                Click="DetailGuidebookClick">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0"
                                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                           Foreground="{DynamicResource CloudBrush}" Text="&#xE72A;"/>
                                                <StackPanel>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Margin="0,2,0,0" FontSize="9"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Text="{Binding DiscoveryLabel}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- Genres -->
                        <WrapPanel Margin="0,0,0,0">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding CloudscapeDetailGame.GenresText}"
                                       TextWrapping="Wrap"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: cover art -->
                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                        CornerRadius="{DynamicResource ThemeCornerRadiusLarge}"
                        ClipToBounds="True"
                        Margin="0,0,0,16"
                        VerticalAlignment="Top">
                    <Image x:Name="DetailCoverImage"
                           Stretch="UniformToFill"
                           MaxHeight="380"
                           Source="{Binding CloudscapeDetailGame.DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=cover}"/>
                </Border>

                <!-- Bottom action row -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Margin="0,14,0,0">
                    <Button x:Name="DetailLaunchButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="28,13" FontSize="15"
                            Click="DetailLaunchClick"
                            Content="&#x25BA;  Launch"/>
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Padding="16,13" Margin="12,0,0,0"
                            Click="DetailMetadataClick"
                            Content="Edit Metadata"/>
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Padding="16,13" Margin="12,0,0,0"
                            Click="DetailAchievementsClick"
                            Content="View Achievements"/>
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Padding="16,13" Margin="12,0,0,0"
                            Visibility="{Binding CloudscapeDetailGame.HasGuidebooks, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="DetailFirstGuidebookClick"
                            Content="Open Guide"/>
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Padding="16,13" Margin="12,0,0,0"
                            Click="DetailFavoriteClick"
                            Content="{Binding CloudscapeDetailGame.FavoriteGlyph}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Attract Mode: Xbox/PS5-dashboard-style ambient full-screen showcase, engaged after
             extended idle on Cloudscape's Home tab. Two Ken-Burns-animated images crossfade
             through a curated rotation of the library's best-looking games, pulling every
             background/banner/screenshot IGDB gave us so a single game can hold the screen
             across several images before advancing. Any input exits instantly (see
             BigPictureWindow.xaml.cs ExitAttractMode). -->
        <Grid x:Name="AttractModeOverlay"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="95"
              Background="Black">
            <Image x:Name="AttractBgA" Stretch="UniformToFill" Opacity="1" CacheMode="BitmapCache"
                   RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="AttractBgAScale" ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="AttractBgB" Stretch="UniformToFill" Opacity="0" CacheMode="BitmapCache"
                   RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="AttractBgBScale" ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
            </Image>
            <!-- Atmospheric scrim so title text stays readable over any artwork -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#7A05070A"/>
                        <GradientStop Offset="0.42" Color="#2005070A"/>
                        <GradientStop Offset="0.7" Color="#4805070A"/>
                        <GradientStop Offset="1" Color="#EE05070A"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Title reveal, bottom-left -->
            <StackPanel x:Name="AttractTitleBlock" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="56,0,0,72" Opacity="0" IsHitTestVisible="False" MaxWidth="900">
                <StackPanel.RenderTransform><TranslateTransform x:Name="AttractTitleLift" Y="26"/></StackPanel.RenderTransform>
                <TextBlock Text="NOW SHOWCASING" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource CloudBrush}" Opacity="0.9"
                           Margin="2,0,0,10"/>
                <TextBlock x:Name="AttractTitleText" FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                           FontSize="56" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="AttractSubtitleText" FontSize="15" Margin="3,10,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Corner badge -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,56,0"
                    Padding="12,6" CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                    Background="{DynamicResource ThemePillFillBrush}"
                    BorderBrush="{DynamicResource ThemePillBorderBrush}" BorderThickness="1"
                    IsHitTestVisible="False">
                <TextBlock Text="ATTRACT MODE" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>

            <!-- Wake hint, fades in a couple seconds after the takeover so it never fights the title reveal -->
            <TextBlock x:Name="AttractWakeHint" Text="Press any key or move to browse"
                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,56,72" Opacity="0" IsHitTestVisible="False"/>
        </Grid>

        <!-- Launch handoff overlay: artwork-backed confirmation shared by every Horizon Play route. -->
        <Border x:Name="LaunchHandoffOverlay"
                Background="Black"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="999"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid x:Name="LaunchHandoffContent">
                <Image Stretch="UniformToFill" Opacity="0.22"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding DisplayBackgroundImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=background}"/>
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.76" RadiusY="0.82">
                            <GradientStop Offset="0" Color="#50000000"/>
                            <GradientStop Offset="0.58" Color="#C8000000"/>
                            <GradientStop Offset="1" Color="#F8000000"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="CIRRA / HORIZON" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource CloudBrush}"/>
                    <TextBlock Margin="0,12,0,0" Text="{Binding Title}"
                               FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                               FontSize="38" FontWeight="SemiBold" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Margin="0,8,0,18" Text="Preparing your session"
                               FontSize="13" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ProgressBar Height="4" Width="260" HorizontalAlignment="Center"
                                 Style="{StaticResource BusyBarStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Embedded Play: keeps a RetroArch-launched game's own window living inside Cloudscape
             instead of it popping out as a separate CloudBerry window. EmbeddedPlayHostContainer
             stays empty in XAML — BigPictureWindow.xaml.cs adds an EmbeddedProcessWindowHost to it
             programmatically once a real target window handle exists (see ShowEmbeddedPlay). Sits
             above Attract Mode (which is already guarded off while a game IsRunning, but this is
             the belt-and-suspenders order) and below the transient launch-handoff flash. -->
        <Grid x:Name="EmbeddedPlayOverlay"
              Visibility="Collapsed"
              Panel.ZIndex="120"
              Background="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="14,10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock x:Name="EmbeddedPlayTitleText"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Text="Game"/>
                        <TextBlock Margin="10,0,0,0"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Text="Playing via RetroArch (embedded)"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="ExitEmbeddedPlayClick"
                            Content="Exit Game"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" x:Name="EmbeddedPlayHostContainer" Background="Black"/>
        </Grid>

    </Grid>
</Window>
