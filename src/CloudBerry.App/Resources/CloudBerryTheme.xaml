    <CornerRadius x:Key="ThemeCornerRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="ThemeCornerRadiusPanel">8</CornerRadius>
    <CornerRadius x:Key="ThemeCornerRadiusLarge">8</CornerRadius>
    <CornerRadius x:Key="ThemeCornerRadiusPill">999</CornerRadius>
    <Thickness x:Key="ThemeBorderThickness">1</Thickness>

    <!--
        Type scale. Shared across every theme skin so text sizes stay consistent no
        matter which of the 9 palettes is active — only color/font-family should vary
        by theme, not size. Steps roughly follow a 1.15-1.25 ratio; each step is meant
        to be visually distinct from its neighbors, not a 0.5pt nudge.

        Caption   - timestamps, muted sub-labels, badge text
        Small     - secondary list/grid text (platform, last-played)
        Body      - default reading size for most UI text
        BodyLarge - primary list/card titles, form labels
        Heading   - section headers, dialog titles
        Title     - page titles
        Display   - hero/detail-panel game titles
    -->
    <sys:Double x:Key="FontSizeMicro">10</sys:Double>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeBodyLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeHeading">20</sys:Double>
    <sys:Double x:Key="FontSizeTitle">26</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">36</sys:Double>
    <sys:Double x:Key="FontSizeStatMedium">24</sys:Double>
    <sys:Double x:Key="FontSizeStatLarge">30</sys:Double>

    <!--
        Spacing scale. Same rationale as the type scale above — shared across every
        theme, and meant to replace the current sprawl of near-duplicate literal
        Margin/Padding values (10,6 vs 10,5 vs 9,5 vs 9,7, etc.) with a small set of
        values that are actually distinct from one another and consistent everywhere.
        Use as Thickness building blocks, e.g. Margin="{StaticResource SpaceM}" for
        uniform, or compose manually ("{StaticResource SpaceS},{StaticResource SpaceM}")
        where XAML allows it.
    -->
    <sys:Double x:Key="SpaceXS">4</sys:Double>
    <sys:Double x:Key="SpaceS">8</sys:Double>
    <sys:Double x:Key="SpaceM">14</sys:Double>
    <sys:Double x:Key="SpaceL">20</sys:Double>
    <sys:Double x:Key="SpaceXL">32</sys:Double>
    <!-- Optical-depth surfaces -->
