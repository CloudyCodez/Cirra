        <GradientStop Offset="0" Color="#E7151A23"/>
        <GradientStop Offset="0.48" Color="#BE243044"/>
        <GradientStop Offset="1" Color="#D5090B10"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProfileScoreBandBrush" StartPoint="0,0" EndPoint="1,0">
