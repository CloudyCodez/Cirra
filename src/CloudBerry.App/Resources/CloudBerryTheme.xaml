<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ════════════════════════════════════════════════════════════════════
         CIRRA CORE
         Obsidian depth · ice light · champagne precision
         The runtime theme engine replaces these tokens for every other skin.
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush"        Color="#070B10" />
    <SolidColorBrush x:Key="SidebarBrush"              Color="#0A1017" />
    <SolidColorBrush x:Key="SurfaceBrush"              Color="#0F1721" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush"      Color="#141F2B" />
    <SolidColorBrush x:Key="SurfaceHighBrush"          Color="#192735" />
    <SolidColorBrush x:Key="CardBrush"                 Color="#172431" />
    <SolidColorBrush x:Key="CardHoverBrush"            Color="#203344" />
    <SolidColorBrush x:Key="ArtworkHoverBrush"         Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CardSelectedBrush"         Color="#274257" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"               Color="#273B4A" />
    <SolidColorBrush x:Key="BorderSubtleBrush"         Color="#355265" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"          Color="#F3F9FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush"        Color="#B8C8D1" />
    <SolidColorBrush x:Key="TextMutedBrush"            Color="#748A98" />
    <SolidColorBrush x:Key="TextOnDarkBrush"           Color="#FFFFFF" />

    <!-- Cirra ice accent -->
    <SolidColorBrush x:Key="BerryBrush"                Color="#62D5F6" />
    <SolidColorBrush x:Key="BerryHoverBrush"           Color="#9AEAFF" />
    <SolidColorBrush x:Key="BerryPressedBrush"         Color="#35A8C9" />
    <SolidColorBrush x:Key="BerryDimBrush"             Color="#A9EEFF" />
    <SolidColorBrush x:Key="BerryMutedBrush"           Color="#2B809A" />

    <!-- Secondary accents -->
    <SolidColorBrush x:Key="CloudBrush"                Color="#9CB7C5" />
    <SolidColorBrush x:Key="CloudDimBrush"             Color="#1A3442" />
    <SolidColorBrush x:Key="MintBrush"                 Color="#58D6B2" />
    <SolidColorBrush x:Key="MintDimBrush"              Color="#123E34" />
    <SolidColorBrush x:Key="GoldBrush"                 Color="#E4C47D" />
    <SolidColorBrush x:Key="GoldDimBrush"              Color="#594A26" />
    <SolidColorBrush x:Key="WarningBrush"              Color="#F0B35A" />
    <SolidColorBrush x:Key="NeoBerryBrush"             Color="#7DA8FF" />
    <SolidColorBrush x:Key="NeoCyanBrush"              Color="#62D5F6" />
    <SolidColorBrush x:Key="NeoTwilightBrush"          Color="#060B11" />

    <!-- Error / Danger -->
    <SolidColorBrush x:Key="ErrorBrush"                Color="#F36B74" />
    <SolidColorBrush x:Key="ErrorHoverBrush"           Color="#FF8790" />
    <SolidColorBrush x:Key="ErrorDimBrush"             Color="#703039" />

    <!-- Backward-compatible resource aliases -->
    <SolidColorBrush x:Key="PanelBrush"                Color="#141F2B" />
    <SolidColorBrush x:Key="PanelAltBrush"             Color="#192735" />
    <SolidColorBrush x:Key="DarkPanelBrush"            Color="#0F1721" />
    <SolidColorBrush x:Key="DarkPanelAltBrush"         Color="#141F2B" />

    <!-- Core gradients -->
    <LinearGradientBrush x:Key="BerryGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#62D5F6"/>
        <GradientStop Offset="1" Color="#7DA8FF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#E4C47D"/>
        <GradientStop Offset="1" Color="#B99751"/>
    </LinearGradientBrush>
    <!-- Flash Bloom: radial crimson energy burst -->
    <RadialGradientBrush x:Key="FlashBloomGradient" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Offset="0" Color="#FF6B7A"/>
        <GradientStop Offset="0.4" Color="#FF2E4D"/>
        <GradientStop Offset="1" Color="#00000000"/>
    </RadialGradientBrush>
    <!-- Lightning Streak: white→crimson→transparent electric trace -->
    <LinearGradientBrush x:Key="LightningStreakGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FFFFFFFF"/>
        <GradientStop Offset="0.5" Color="#FF2E4D"/>
        <GradientStop Offset="1" Color="#00000000"/>
    </LinearGradientBrush>
    <!-- Domain Vignette: deep black edges with subtle crimson center -->
    <RadialGradientBrush x:Key="DomainVignetteGradient" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Offset="0.4" Color="#000A0A0F"/>
        <GradientStop Offset="0.8" Color="#401A0010"/>
        <GradientStop Offset="1" Color="#800A0A0F"/>
    </RadialGradientBrush>
    <!-- Restrained specular sheen -->
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"    Color="#34FFFFFF"/>
        <GradientStop Offset="0.25" Color="#1862D5F6"/>
        <GradientStop Offset="0.45" Color="#087DA8FF"/>
        <GradientStop Offset="0.46" Color="#00FFFFFF"/>
        <GradientStop Offset="0.82" Color="#06E4C47D"/>
        <GradientStop Offset="1"    Color="#00000000"/>
    </LinearGradientBrush>
    <!-- Inner highlight stripe — sits 1 px inside border for depth illusion -->
    <LinearGradientBrush x:Key="GlassInnerHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"   Color="#50FFFFFF"/>
        <GradientStop Offset="0.5" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <!-- Pressed overlay -->
    <LinearGradientBrush x:Key="GlassPressedOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2862D5F6"/>
        <GradientStop Offset="1" Color="#2403070A"/>
    </LinearGradientBrush>
    <CornerRadius x:Key="GlassButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="GlassChipCornerRadius">8</CornerRadius>
    <Thickness x:Key="GlassButtonBorderThickness">1</Thickness>
    <!-- Cirra optical-glass controls -->
    <LinearGradientBrush x:Key="GlassButtonFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#5862D5F6"/>
        <GradientStop Offset="0.5"  Color="#241B6078"/>
        <GradientStop Offset="1"    Color="#16070B10"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassButtonHoverFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#82A8EDFF"/>
        <GradientStop Offset="0.5"  Color="#3431A1C1"/>
        <GradientStop Offset="1"    Color="#1E070B10"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassButtonPressedFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#365EC6E4"/>
        <GradientStop Offset="0.5"  Color="#20227F99"/>
        <GradientStop Offset="1"    Color="#2A05080C"/>
    </LinearGradientBrush>
    <!-- Border: bright top-left rim → warm gold mid → subtle bottom -->
    <LinearGradientBrush x:Key="GlassButtonBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#B8D8F7FF"/>
        <GradientStop Offset="0.38" Color="#6862D5F6"/>
        <GradientStop Offset="0.70" Color="#38E4C47D"/>
        <GradientStop Offset="1"    Color="#24FFFFFF"/>
    </LinearGradientBrush>
    <!-- Ghost chip fills -->
    <LinearGradientBrush x:Key="GlassChipFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#2EFFFFFF"/>
        <GradientStop Offset="0.5" Color="#161B6078"/>
        <GradientStop Offset="1"   Color="#10070B10"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassChipActiveFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#48FFFFFF"/>
        <GradientStop Offset="0.5" Color="#242B92AF"/>
        <GradientStop Offset="1"   Color="#16070B10"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassChipBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#86FFFFFF"/>
        <GradientStop Offset="0.48" Color="#5462D5F6"/>
        <GradientStop Offset="1"    Color="#32E4C47D"/>
    </LinearGradientBrush>
    <!-- Fine cadence texture; individual themes may replace it. -->
    <DrawingBrush x:Key="NostalgiaScanlineBrush"
                  Viewport="0,0,1,4"
                  ViewportUnits="Absolute"
                  TileMode="Tile"
                  Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#1262D5F6" Geometry="M0,0 L1,0 1,1 0,1 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- Optional diagonal signal grid; theme intensity controls its visibility. -->
    <DrawingBrush x:Key="MatrixRainBrush"
                  Viewport="0,0,20,20"
                  ViewportUnits="Absolute"
                  TileMode="Tile"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Diagonal \ line (top-left → bottom-right) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2862D5F6" Thickness="0.55"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,0" EndPoint="20,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Diagonal / line (top-right → bottom-left) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#187DA8FF" Thickness="0.55"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="20,0" EndPoint="0,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- Atmospheric & overlay brushes — refined for v1-19 -->
    <SolidColorBrush x:Key="AuroraVeilBrush"           Color="#28C2B48E"/>
    <SolidColorBrush x:Key="GlitchNeonBrush"           Color="#2A2010"/>
