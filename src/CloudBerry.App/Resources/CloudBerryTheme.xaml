    <sys:Double x:Key="NierDeletionEffectOpacity">0</sys:Double>
    <sys:Double x:Key="ThemeShellOverlayOpacity">0.92</sys:Double>
    <!-- Impact particle and light opacities -->
    <sys:Double x:Key="FlashParticleOpacity">0.24</sys:Double>
    <sys:Double x:Key="FlashArcOpacity">0.2</sys:Double>
    <sys:Double x:Key="FlashGlowOpacity">0.1</sys:Double>
