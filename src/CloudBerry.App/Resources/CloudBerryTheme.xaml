                <GeometryDrawing Brush="#10FFFFFF" Geometry="M23,3 L24,3 24,4 23,4 Z"/>
                <GeometryDrawing Brush="#0C000000" Geometry="M35,11 L36,11 36,12 35,12 Z"/>
                <GeometryDrawing Brush="#0FFFFFFF" Geometry="M44,20 L45,20 45,21 44,21 Z"/>
                <GeometryDrawing Brush="#0A000000" Geometry="M6,28 L7,28 7,29 6,29 Z"/>
