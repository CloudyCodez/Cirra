    <!-- ToggleButton variant — same glass shell, highlights when IsChecked -->
    <Style x:Key="GhostToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource CloudFocusVisualStyle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GlassChipFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeGhostButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" ClipToBounds="True">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Bg"
                                CornerRadius="{DynamicResource GlassButtonCornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource GlassButtonBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}"
                                                  BlurRadius="4" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Sheen"
                                IsHitTestVisible="False"
                                CornerRadius="{DynamicResource GlassButtonCornerRadius}"
                                Background="{DynamicResource GlassSheenBrush}"
                                Opacity="0"/>
                        <Border x:Name="InnerEdge"
                                Margin="1" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource GlassButtonCornerRadius}"
                                BorderBrush="#38FFFFFF" BorderThickness="1"
                                Opacity="0.28"/>
                        <Border x:Name="PressOverlay"
                                IsHitTestVisible="False"
                                CornerRadius="{DynamicResource GlassButtonCornerRadius}"
                                Background="{DynamicResource GlassPressedOverlayBrush}"
                                Opacity="0"/>
                        <Border x:Name="CheckedOverlay"
                                IsHitTestVisible="False"
                                CornerRadius="{DynamicResource GlassButtonCornerRadius}"
                                Background="{DynamicResource ThemeAccentBrush}"
                                Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.014" Duration="0:0:0.11"/>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.014" Duration="0:0:0.11"/>
                                    <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.16" Duration="0:0:0.11"/>
                                    <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="12" Duration="0:0:0.11"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
                                    <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.16"/>
                                    <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="4" Duration="0:0:0.16"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassButtonHoverFillBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GlassButtonBorderBrush}"/>
                            <Setter TargetName="Sheen" Property="Opacity" Value="1"/>
                            <Setter TargetName="InnerEdge" Property="Opacity" Value="0.68"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckedOverlay" Property="Opacity" Value="0.18"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassButtonPressedFillBrush}"/>
                            <Setter TargetName="PressOverlay" Property="Opacity" Value="1"/>
                            <Setter TargetName="Sheen" Property="Opacity" Value="0.4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

