        <GradientStop Offset="0"   Color="#7262D5F6"/>
        <GradientStop Offset="0.5" Color="#3C6074"/>
        <GradientStop Offset="1"   Color="#243546"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ThemeAtmosphereBlobBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ThemeAtmosphereBlobSecondaryBrush" Color="Transparent"/>

    <FontFamily x:Key="ThemeBodyFontFamily">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="ThemeDisplayFontFamily">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="ThemeInputFontFamily">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
