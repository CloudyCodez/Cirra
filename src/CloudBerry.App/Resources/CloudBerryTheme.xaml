    <!-- ════════════════════════════════════════════════════════════════════
         BASE WINDOW
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeInputFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
    </Style>

    <!-- Reserved ambient geometry layer. -->
    <Style x:Key="AtmosphereBlobStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- Theme-reactive display title. -->
    <Style x:Key="MatrixTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeDisplayFontFamily}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         SCROLLBAR
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Width="12" Background="Transparent">
                        <Border x:Name="Rail"
                                Width="8"
                                Margin="2"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource GlassChipFillBrush}"
                                BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                Opacity="0.22"/>
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb"
                                       Width="4"
                                       MinHeight="38"
                                       HorizontalAlignment="Center"
                                       Background="{DynamicResource ThemePanelEdgeBrush}"
                                       Opacity="0.74">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                                    BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                                                    BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Rail" Property="Opacity" Value="0.62"/>
                            <Setter TargetName="Thumb" Property="Width" Value="7"/>
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource CloudBrush}"/>
                            <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                            <Setter TargetName="Rail" Property="Opacity" Value="0.78"/>
                            <Setter TargetName="Thumb" Property="Width" Value="8"/>
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource BerryBrush}"/>
                            <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Height="12" Background="Transparent">
                                <Border x:Name="Rail"
                                        Height="8"
                                        Margin="2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GlassChipFillBrush}"
                                        BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                        Opacity="0.22"/>
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="4,2">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb"
                                               Height="4"
                                               MinWidth="52"
                                               VerticalAlignment="Center"
                                               Background="{DynamicResource ThemePanelEdgeBrush}"
                                               Opacity="0.74">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                                            BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                                                            BorderThickness="1"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Rail" Property="Opacity" Value="0.62"/>
                                    <Setter TargetName="Thumb" Property="Height" Value="7"/>
                                    <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource CloudBrush}"/>
                                    <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                                    <Setter TargetName="Rail" Property="Opacity" Value="0.78"/>
                                    <Setter TargetName="Thumb" Property="Height" Value="8"/>
                                    <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource BerryBrush}"/>
                                    <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="Both"/>
        <Setter Property="PanningDeceleration" Value="0.0016"/>
        <Setter Property="PanningRatio" Value="1"/>
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Content="{TemplateBinding Content}"
                                                Margin="{TemplateBinding Padding}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0"
                                   Maximum="{TemplateBinding ScrollableHeight}" Minimum="0"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1"
                                   Maximum="{TemplateBinding ScrollableWidth}" Minimum="0"
                                   Orientation="Horizontal"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         LISTBOX
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.CacheLength" Value="1"/>
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         SIDEBAR NAVIGATION
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="NavListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,12,8,6"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
    </Style>

    <Style x:Key="NavListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="NavBg"
                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                            Height="38"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="0"/>
                        </Border.RenderTransform>
                        <Border.Background>
                            <SolidColorBrush x:Name="NavBgBrush" Color="#00000000"/>
                        </Border.Background>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavHoverWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="NavThemeTrace"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.62" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="NavBg"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="2" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavHoverWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="NavThemeTrace"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="NavBg"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <!-- Active left bar — solid charcoal line -->
                            <Rectangle x:Name="NavHoverWash"
                                       Fill="{DynamicResource ThemeNavItemHoverBackgroundBrush}"
                                       Opacity="0"
                                       IsHitTestVisible="False"/>
                            <Border x:Name="NavThemeTrace"
                                    Width="42"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource ThemeSweepBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00FFFFFF"/>
                                        <GradientStop Offset="0.45" Color="#FFFFFFFF"/>
                                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="ActiveBar"
                                    Width="3" HorizontalAlignment="Left"
                                    Background="{DynamicResource ThemeNavItemSelectedBorderBrush}" Opacity="0"/>
                            <StackPanel Orientation="Horizontal" Margin="14,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NavIcon"
                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="13" Width="18" TextAlignment="Center"
                                           Foreground="{DynamicResource TextOnDarkBrush}"
                                           Opacity="0.45"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLabel"
                                           Margin="10,0,0,0"
                                           Text="{TemplateBinding Content}"
                                           FontSize="11.5"
                                           FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                           Foreground="{DynamicResource TextOnDarkBrush}"
                                           Opacity="0.6"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavLabel" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="NavIcon"  Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NavBg"      Property="Background" Value="{DynamicResource ThemeNavItemSelectedBackgroundBrush}"/>
                            <Setter TargetName="NavBg"      Property="BorderBrush" Value="{DynamicResource ThemeNavItemSelectedBorderBrush}"/>
                            <Setter TargetName="NavLabel"   Property="Opacity" Value="1"/>
                            <Setter TargetName="NavIcon"    Property="Opacity" Value="1"/>
                            <Setter TargetName="ActiveBar"  Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact blade navigation -->
    <Style x:Key="BladeNavListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BladeNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="BladeBg"
                            MinWidth="120"
                            Padding="16,9"
                            BorderThickness="1"
                            CornerRadius="0"
                            Background="{DynamicResource ThemeNavItemBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeNavItemBorderBrush}">
                        <Grid>
                            <Border x:Name="BladeTrace"
                                    Width="58"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource ThemeSweepBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00FFFFFF"/>
                                        <GradientStop Offset="0.5" Color="#FFFFFFFF"/>
                                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <TextBlock x:Name="BladeLabel"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{TemplateBinding Content}"/>
                            <!-- Active underline — solid charcoal bar -->
                            <Border x:Name="BladeAccent"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Margin="8,0,8,0"
                                    Background="{DynamicResource BerryBrush}"
                                    Opacity="0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BladeBg" Property="Background" Value="{DynamicResource ThemeNavItemHoverBackgroundBrush}"/>
                            <Setter TargetName="BladeBg" Property="BorderBrush" Value="{DynamicResource ThemeNavItemBorderBrush}"/>
                            <Setter TargetName="BladeTrace" Property="Opacity" Value="0.48"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="BladeBg" Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
                            <Setter TargetName="BladeBg" Property="BorderBrush" Value="{DynamicResource ThemeNavItemBorderBrush}"/>
                            <Setter TargetName="BladeAccent" Property="Opacity" Value="1"/>
                            <Setter TargetName="BladeTrace" Property="Opacity" Value="0.62"/>
                            <Setter TargetName="BladeLabel" Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="BladeBg" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         TAB CONTROL STYLES
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="InvisibleTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <TabPanel IsItemsHost="True" Visibility="Collapsed" Height="0"/>
                        <Border x:Name="PageHost" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform Y="6"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="6" To="0" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented tab button -->
    <Style x:Key="PillTabButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource GlassButtonBorderThickness}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemePillLabelBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid TextElement.Foreground="{TemplateBinding Foreground}"
                          TextElement.FontFamily="{DynamicResource ThemeBodyFontFamily}"
                          TextElement.FontSize="{TemplateBinding FontSize}">
                        <Border x:Name="PillBg"
                                CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{DynamicResource ThemePillFillBrush}"
                                BorderBrush="{DynamicResource ThemePillBorderBrush}"/>
                        <Border x:Name="ActiveBar"
                                Height="2" VerticalAlignment="Bottom"
                                Margin="6,0,6,0" Opacity="0"
                                Background="{DynamicResource BerryBrush}"/>
                        <ContentPresenter x:Name="PillContent"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBg" Property="Background" Value="{DynamicResource ThemePillHoverFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PillBg" Property="Background" Value="{DynamicResource ThemePillSelectedFillBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="ActiveBar" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemePillLabelActiveBrush}"/>
                            <Setter TargetName="PillBg" Property="Background" Value="{DynamicResource ThemePillSelectedFillBrush}"/>
                            <Setter TargetName="PillBg" Property="BorderBrush" Value="{DynamicResource ThemePillBorderBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="0" Padding="4,4,4,0" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <TabPanel IsItemsHost="True" Margin="0"/>
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Pill"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource ThemePillFillBrush}"
                                BorderBrush="{DynamicResource ThemePillBorderBrush}"
                                BorderThickness="1"/>
                        <Border x:Name="PillHover"
                                CornerRadius="0"
                                Background="{DynamicResource ThemePillHoverFillBrush}"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <Border x:Name="PillSelected"
                                CornerRadius="0"
                                Background="{DynamicResource ThemePillSelectedFillBrush}"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <Border Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <TextBlock x:Name="PillText"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                       Text="{TemplateBinding Header}"
                                       Foreground="{DynamicResource ThemePillLabelBrush}"/>
                        </Border>
                        <Border x:Name="SelBar" Height="2" VerticalAlignment="Bottom"
                                Margin="8,0" Opacity="0"
                                Background="{DynamicResource BerryBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PillHover" Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.10"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PillHover" Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.16"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelBar" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="PillSelected" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelBar" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="PillSelected" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource ThemePillLabelActiveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         WINDOW CHROME BUTTONS
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="WindowControlButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Opacity" Value="0.55"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
