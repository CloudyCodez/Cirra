        <GradientStop Offset="0"   Color="#22C8BA96"/>
        <GradientStop Offset="0.4" Color="#10BEB08A"/>
        <GradientStop Offset="0.8" Color="#06A89870"/>
        <GradientStop Offset="1"   Color="#00000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ThemeShellPatternBrush" Color="Transparent"/>
    <!-- Sidebar: layered vignette — rich darkness at edges, not flat -->
    <LinearGradientBrush x:Key="ThemeSidebarOverlayBrush" StartPoint="1,0" EndPoint="0,0">
        <GradientStop Offset="0"   Color="#22000000"/>
        <GradientStop Offset="0.6" Color="#08000000"/>
        <GradientStop Offset="1"   Color="#00000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ThemeSidebarPatternBrush" Color="Transparent"/>
    <!-- Moving highlight trace -->
    <SolidColorBrush x:Key="ThemeSweepBrush" Color="#2A2010"/>
    <sys:Double x:Key="ThemeShellPatternOpacity">0.05</sys:Double>
    <sys:Double x:Key="ThemeSidebarPatternOpacity">0.06</sys:Double>
    <sys:Double x:Key="ThemeSweepOpacity">0.065</sys:Double>
