         SEPARATOR — NieR ruled line
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Opacity" Value="0.35"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1"
                               Fill="{TemplateBinding Background}"
                               Opacity="{TemplateBinding Opacity}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         TOOLTIP — crisp ink panel with gold rule
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ThemePanelFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="1"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#14100A" BlurRadius="12" ShadowDepth="2" Opacity="0.36"/>
                        </Border.Effect>
                        <Grid>
                            <!-- Subtle top gold rule -->
                            <Border Height="1" VerticalAlignment="Top" Margin="0,-1,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0"   Color="#008A7040"/>
                                        <GradientStop Offset="0.3" Color="#558A7040"/>
                                        <GradientStop Offset="0.7" Color="#558A7040"/>
                                        <GradientStop Offset="1"   Color="#008A7040"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════════
         Hero / card overlay brushes — used by MainWindow and BigPictureWindow
         ═══════════════════════════════════════════════════════════════ -->
    <!-- HeroOverlayBrush: dark-to-transparent gradient draped over hero artwork -->
    <LinearGradientBrush x:Key="HeroOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"   Color="#00000000"/>
        <GradientStop Offset="0.5" Color="#44000000"/>
        <GradientStop Offset="1"   Color="#CC100C09"/>
    </LinearGradientBrush>

    <!-- CardBottomOverlayBrush: scrim at card bottom for title legibility -->
    <LinearGradientBrush x:Key="CardBottomOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"   Color="#00000000"/>
        <GradientStop Offset="0.3" Color="#60100C09"/>
        <GradientStop Offset="1"   Color="#E8100C09"/>
    </LinearGradientBrush>

    <!-- NostalgiaAtmosphereBrush: warm amber vignette for nostalgia/retro views -->
    <LinearGradientBrush x:Key="NostalgiaAtmosphereBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#18C8A870"/>
        <GradientStop Offset="0.5" Color="#08BEB08A"/>
        <GradientStop Offset="1"   Color="#14C8A058"/>
    </LinearGradientBrush>

</ResourceDictionary>
