                                <DropShadowEffect Color="{DynamicResource ThemePrimaryButtonGlowColor}"
                                                  BlurRadius="8"
                                                  ShadowDepth="0"
                                                  Opacity="0"/>
                            </Border.Effect>
                        </Border>
                        <!-- PS5 glass top sheen -->
                        <Border x:Name="Sheen"
                                IsHitTestVisible="False"
                                CornerRadius="{DynamicResource GlassButtonCornerRadius}"
                                Background="{DynamicResource GlassSheenBrush}"
                                Opacity="0.10"/>
                        <Border x:Name="InnerEdge"
                                Margin="1"
                                IsHitTestVisible="False"
                                CornerRadius="{DynamicResource GlassButtonCornerRadius}"
                                BorderBrush="#46FFFFFF"
                                BorderThickness="1"
                                Opacity="0.14"/>
                        <!-- Pressed darkener -->
                        <Border x:Name="PressOverlay"
                                IsHitTestVisible="False"
                                CornerRadius="{DynamicResource GlassButtonCornerRadius}"
                                Background="{DynamicResource GlassPressedOverlayBrush}"
                                Opacity="0"/>
                        <!-- Bottom accent line — cream rule à la PS5 focus bar -->
                        <Border x:Name="BottomBar"
                                Height="2" VerticalAlignment="Bottom"
                                IsHitTestVisible="False"
                                Background="{DynamicResource BerryHoverBrush}"
                                Opacity="0"/>
                        <Border x:Name="FxTrace"
                                Width="76"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource ThemeSweepBrush}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform X="-92"/>
                            </Border.RenderTransform>
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#00FFFFFF"/>
                                    <GradientStop Offset="0.52" Color="#FFFFFFFF"/>
                                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemePrimaryButtonHoverFillBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource BerryHoverBrush}"/>
                            <Setter TargetName="BottomBar" Property="Opacity" Value="0.55"/>
                            <Setter TargetName="InnerEdge" Property="Opacity" Value="0.26"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemePrimaryButtonHoverFillBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemePrimaryButtonPressedFillBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource BerryPressedBrush}"/>
                            <Setter TargetName="PressOverlay" Property="Opacity" Value="1"/>
                            <Setter TargetName="Sheen" Property="Opacity" Value="0.4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
