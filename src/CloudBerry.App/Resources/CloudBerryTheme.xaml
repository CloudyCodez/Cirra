    <SolidColorBrush x:Key="ThemeNavItemSelectedBackgroundBrush" Color="#3A1C4054"/>
    <SolidColorBrush x:Key="ThemeNavItemBorderBrush"             Color="#294858"/>
    <SolidColorBrush x:Key="ThemeNavItemHoverBorderBrush"        Color="#62D5F6"/>
