        <Setter Property="Margin" Value="0,14,0,0"/>
        <Setter Property="Background" Value="{DynamicResource ThemePanelFillSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemePanelEdgeBrush}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}"
                                  BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.14"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CommandTileButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Width" Value="154"/>
        <Setter Property="MinHeight" Value="72"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Background" Value="{DynamicResource ThemePanelFillSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemePanelEdgeBrush}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}"
                                  BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.10"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LibrarySignalTileStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadiusControl}"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemePanelFillSoftBrush}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#3C3020" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Border.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                         To="6" Duration="0:0:0.10"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                         To="0.18" Duration="0:0:0.10"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Border.MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                         To="0" Duration="0:0:0.16"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                         To="0" Duration="0:0:0.16"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LibrarySignalTileBusyStyle" TargetType="Border" BasedOn="{StaticResource LibrarySignalTileStyle}">
        <Setter Property="Background" Value="{DynamicResource CloudDimBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CloudBrush}"/>
    </Style>

    <Style x:Key="PageHeroPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
        <Setter Property="Padding" Value="24,22"/>
        <Setter Property="Background" Value="{DynamicResource ThemePanelFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemePanelBorderGradientBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadiusLarge}"/>
    </Style>

    <Style x:Key="AccentPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource ThemePanelFillSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <Style x:Key="InsetCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadiusPanel}"/>
    </Style>

    <Style x:Key="FeatureDetailCardStyle" TargetType="Border" BasedOn="{StaticResource InsetCardStyle}">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Background" Value="{DynamicResource ThemePanelFillSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemePanelEdgeBrush}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}"
                                  BlurRadius="8"
                                  ShadowDepth="2"
                                  Opacity="0.16"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Border.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         To="{StaticResource ThemeHoverLiftDistance}"
                                         Duration="0:0:0.11">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                         To="14"
                                         Duration="0:0:0.11"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                         To="0.24"
                                         Duration="0:0:0.11"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Border.MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         To="0"
                                         Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                         To="8"
                                         Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                         To="0.16"
                                         Duration="0:0:0.18"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MediaAssetCardStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource ThemePanelFillSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemePanelEdgeBrush}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}"
                                  BlurRadius="8"
                                  ShadowDepth="2"
                                  Opacity="0.12"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Border.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1.008"
                                         Duration="0:0:0.11"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         To="1.008"
                                         Duration="0:0:0.11"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                         To="14"
                                         Duration="0:0:0.11"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                         To="0.22"
                                         Duration="0:0:0.11"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Border.MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1"
                                         Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         To="1"
                                         Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                         To="8"
                                         Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                         To="0.12"
                                         Duration="0:0:0.18"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         DANGER BUTTON
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource CloudFocusVisualStyle}"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ErrorDimBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                SnapsToDevicePixels="True"/>
                        <!-- Glass sheen -->
                        <Rectangle x:Name="Sheen"
                                   IsHitTestVisible="False"
                                   Fill="{DynamicResource GlassSheenBrush}"/>
                        <!-- Pressed darkener -->
                        <Rectangle x:Name="PressOverlay"
                                   IsHitTestVisible="False"
                                   Fill="{DynamicResource GlassPressedOverlayBrush}"
                                   Opacity="0"/>
                        <!-- Bottom danger accent -->
                        <Border x:Name="BottomBar"
                                Height="2" VerticalAlignment="Bottom"
                                IsHitTestVisible="False"
                                Background="#40000000"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Button.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.014" Duration="0:0:0.10"/>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.014" Duration="0:0:0.10"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Button.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ErrorBrush}"/>
                            <Setter TargetName="BottomBar" Property="Background" Value="#60000000"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ErrorHoverBrush}"/>
                            <Setter TargetName="PressOverlay" Property="Opacity" Value="1"/>
                            <Setter TargetName="Sheen" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         PLATFORM BADGE PILL — square tag in game list
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="PlatformBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemePanelFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Padding" Value="5,2"/>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         PROGRESS BARS
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="AchievementProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BerryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ThemeCornerRadiusPill}" ClipToBounds="True">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{DynamicResource ThemeCornerRadiusPill}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BusyBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource AchievementProgressBarStyle}">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BerryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="Width" Value="96"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         CONTEXT MENUS
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource ThemePanelFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemePanelBorderGradientBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}"
                                              BlurRadius="28" ShadowDepth="8" Opacity="0.48"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="ItemSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckGlyph" Grid.Column="0"
                                           Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource BerryBrush}"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Margin="20,0,8,0"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="SubmenuGlyph" Grid.Column="3"
                                           Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               Placement="Right" HorizontalOffset="-3" VerticalOffset="-5"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource ThemePanelFillBrush}"
                                    BorderBrush="{DynamicResource ThemePanelBorderGradientBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                    Padding="5">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}"
                                                      BlurRadius="28" ShadowDepth="8" Opacity="0.48"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource ThemeNavItemHoverBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         SLIDER
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Slider">
        <Setter Property="Width" Value="220"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CloudFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track" Height="18" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="{DynamicResource BerryBrush}"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusPill}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="{DynamicResource BorderSubtleBrush}"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusPill}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse x:Name="ThumbGlow" Fill="{DynamicResource AppBackgroundBrush}"
                                                         Stroke="{DynamicResource BerryBrush}" StrokeThickness="2"/>
                                                <Ellipse Margin="5" Fill="{DynamicResource BerryBrush}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbGlow" Property="Fill" Value="{DynamicResource CardHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbGlow" Property="Fill" Value="{DynamicResource BerryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         EXPANDER
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="HeaderToggle" Grid.Row="0"
                                      Style="{x:Null}" Focusable="True" Cursor="Hand"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderSurface" Padding="12,9"
                                            Background="{DynamicResource ThemePanelFillSoftBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" ContentSource="Content" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE70D;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource BerryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                                            <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ThemeNavItemSelectedBackgroundBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter Content="{TemplateBinding Header}"/>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandedContent" Grid.Row="1"
                                          ContentSource="Content" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         CHECKBOX
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource CloudFocusVisualStyle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="18" Height="18"
                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="9" Foreground="{DynamicResource ThemePrimaryButtonTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource BerryBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BerryBrush}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BerryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         STATUS DOT
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="StatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="5" Opacity="0.55"/>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         SEPARATOR
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Opacity" Value="0.35"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1"
                               Fill="{TemplateBinding Background}"
                               Opacity="{TemplateBinding Opacity}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         TOOLTIP
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ThemePanelFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}" BlurRadius="20" ShadowDepth="5" Opacity="0.42"/>
                        </Border.Effect>
                        <Grid>
                            <!-- Subtle optical highlight -->
                            <Border Height="1" VerticalAlignment="Top" Margin="0,-1,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0"   Color="#0062D5F6"/>
                                        <GradientStop Offset="0.3" Color="#5562D5F6"/>
                                        <GradientStop Offset="0.7" Color="#55E4C47D"/>
                                        <GradientStop Offset="1"   Color="#00E4C47D"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Premium fallbacks for controls that do not opt into a specialized role. -->
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource TextFieldStyle}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboFieldStyle}"/>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource AchievementProgressBarStyle}"/>


    <!-- ═══════════════════════════════════════════════════════════════
         Hero / card overlay brushes — used by MainWindow and BigPictureWindow
         ═══════════════════════════════════════════════════════════════ -->
    <!-- HeroOverlayBrush: dark-to-transparent gradient draped over hero artwork -->
    <LinearGradientBrush x:Key="HeroOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"   Color="#00000000"/>
        <GradientStop Offset="0.5" Color="#44000000"/>
        <GradientStop Offset="1"   Color="#CC100C09"/>
    </LinearGradientBrush>

    <!-- CardBottomOverlayBrush: scrim at card bottom for title legibility -->
    <LinearGradientBrush x:Key="CardBottomOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"   Color="#00000000"/>
        <GradientStop Offset="0.3" Color="#60100C09"/>
        <GradientStop Offset="1"   Color="#E8100C09"/>
    </LinearGradientBrush>

    <!-- NostalgiaAtmosphereBrush: warm amber vignette for nostalgia/retro views -->
    <LinearGradientBrush x:Key="NostalgiaAtmosphereBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#18C8A870"/>
        <GradientStop Offset="0.5" Color="#08BEB08A"/>
        <GradientStop Offset="1"   Color="#14C8A058"/>
    </LinearGradientBrush>

</ResourceDictionary>
