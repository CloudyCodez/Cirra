<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ════════════════════════════════════════════════════════════════════
         COLOR PALETTE — Black Flash Theme  ·  Yuji Itadori Edition
         Void black · Cursed crimson · Electric white · Violet undertones
         High-contrast, high-energy, professional performance
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Surfaces — void black spectrum (deep, matte, professional) -->
    <SolidColorBrush x:Key="AppBackgroundBrush"        Color="#0A0A0F" />
    <SolidColorBrush x:Key="SidebarBrush"              Color="#0F0F14" />
    <SolidColorBrush x:Key="SurfaceBrush"              Color="#14141C" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush"      Color="#1A1A24" />
    <SolidColorBrush x:Key="SurfaceHighBrush"          Color="#1E1E2A" />
    <SolidColorBrush x:Key="CardBrush"                 Color="#22222E" />
    <SolidColorBrush x:Key="CardHoverBrush"            Color="#2A2A38" />
    <SolidColorBrush x:Key="CardSelectedBrush"         Color="#323242" />

    <!-- Borders — crisp definition with subtle crimson edge -->
    <SolidColorBrush x:Key="BorderBrush"               Color="#2A2028" />
    <SolidColorBrush x:Key="BorderSubtleBrush"         Color="#3A3040" />

    <!-- Text — crisp hierarchy on dark backgrounds -->
    <SolidColorBrush x:Key="TextPrimaryBrush"          Color="#F8F9FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush"        Color="#C5C6CC" />
    <SolidColorBrush x:Key="TextMutedBrush"            Color="#8A8B96" />
    <SolidColorBrush x:Key="TextOnDarkBrush"           Color="#FFFFFF" />

    <!-- Black Flash Primary — cursed energy crimson spectrum -->
    <SolidColorBrush x:Key="BerryBrush"                Color="#FF2E4D" />
    <SolidColorBrush x:Key="BerryHoverBrush"           Color="#FF4766" />
    <SolidColorBrush x:Key="BerryPressedBrush"         Color="#E61A3A" />
    <SolidColorBrush x:Key="BerryDimBrush"             Color="#FF6B7A" />
    <SolidColorBrush x:Key="BerryMutedBrush"           Color="#CC263D" />

    <!-- Secondary accents — cursed violet & electric bloom -->
    <SolidColorBrush x:Key="CloudBrush"                Color="#4A154B" />
    <SolidColorBrush x:Key="CloudDimBrush"             Color="#2A0020" />
    <SolidColorBrush x:Key="MintBrush"                 Color="#6B2E7A" />
    <SolidColorBrush x:Key="MintDimBrush"              Color="#3A0A30" />
    <SolidColorBrush x:Key="GoldBrush"                 Color="#FF6B7A" />
    <SolidColorBrush x:Key="GoldDimBrush"              Color="#CC5566" />
    <SolidColorBrush x:Key="WarningBrush"              Color="#FF6B7A" />
    <SolidColorBrush x:Key="NeoBerryBrush"             Color="#FF2E4D" />
    <SolidColorBrush x:Key="NeoCyanBrush"              Color="#7A3E8C" />
    <SolidColorBrush x:Key="NeoTwilightBrush"          Color="#1A0010" />

    <!-- Error / Danger — intensified crimson for impact -->
    <SolidColorBrush x:Key="ErrorBrush"                Color="#FF2E4D" />
    <SolidColorBrush x:Key="ErrorHoverBrush"           Color="#FF4766" />
    <SolidColorBrush x:Key="ErrorDimBrush"             Color="#CC263D" />

    <!-- Backward-compat aliases — mapped to Black Flash equivalents -->
    <SolidColorBrush x:Key="PanelBrush"                Color="#1A1A24" />
    <SolidColorBrush x:Key="PanelAltBrush"             Color="#1E1E2A" />
    <SolidColorBrush x:Key="DarkPanelBrush"            Color="#14141C" />
    <SolidColorBrush x:Key="DarkPanelAltBrush"         Color="#1A1A24" />

    <!-- Gradients — Black Flash energy spectrum -->
    <LinearGradientBrush x:Key="BerryGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF2E4D"/>
        <GradientStop Offset="1" Color="#E61A3A"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF6B7A"/>
        <GradientStop Offset="1" Color="#CC5566"/>
    </LinearGradientBrush>
    <!-- Flash Bloom: radial crimson energy burst -->
    <RadialGradientBrush x:Key="FlashBloomGradient" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Offset="0" Color="#FF6B7A"/>
        <GradientStop Offset="0.4" Color="#FF2E4D"/>
        <GradientStop Offset="1" Color="#00000000"/>
    </RadialGradientBrush>
    <!-- Lightning Streak: white→crimson→transparent electric trace -->
    <LinearGradientBrush x:Key="LightningStreakGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FFFFFFFF"/>
        <GradientStop Offset="0.5" Color="#FF2E4D"/>
        <GradientStop Offset="1" Color="#00000000"/>
    </LinearGradientBrush>
    <!-- Domain Vignette: deep black edges with subtle crimson center -->
    <RadialGradientBrush x:Key="DomainVignetteGradient" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Offset="0.4" Color="#000A0A0F"/>
        <GradientStop Offset="0.8" Color="#401A0010"/>
        <GradientStop Offset="1" Color="#800A0A0F"/>
    </RadialGradientBrush>
    <!-- ── Electric sheen: crisp white→crimson specular for premium feel ──────── -->
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"    Color="#40FFFFFF"/>
        <GradientStop Offset="0.25" Color="#20FF6B7A"/>
        <GradientStop Offset="0.45" Color="#08FF2E4D"/>
        <GradientStop Offset="0.46" Color="#00FFFFFF"/>
        <GradientStop Offset="0.82" Color="#06FF2E4D"/>
        <GradientStop Offset="1"    Color="#00000000"/>
    </LinearGradientBrush>
    <!-- Inner highlight stripe — sits 1 px inside border for depth illusion -->
    <LinearGradientBrush x:Key="GlassInnerHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"   Color="#50FFFFFF"/>
        <GradientStop Offset="0.5" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <!-- Pressed/darkening overlay with crimson tint -->
    <LinearGradientBrush x:Key="GlassPressedOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#30FF2E4D"/>
        <GradientStop Offset="1" Color="#180A0A0F"/>
    </LinearGradientBrush>
    <CornerRadius x:Key="GlassButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="GlassChipCornerRadius">8</CornerRadius>
    <Thickness x:Key="GlassButtonBorderThickness">1</Thickness>
    <!-- NieR parchment-tinted glass — refined for v2.0 elegance -->
    <LinearGradientBrush x:Key="GlassButtonFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#48F0E8D0"/>
        <GradientStop Offset="0.5"  Color="#1EC8B8A0"/>
        <GradientStop Offset="1"    Color="#142A2010"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassButtonHoverFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#68F8F0DC"/>
        <GradientStop Offset="0.5"  Color="#2CD0C0A8"/>
        <GradientStop Offset="1"    Color="#1A302818"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassButtonPressedFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#38E4DCC4"/>
        <GradientStop Offset="0.5"  Color="#16B8A890"/>
        <GradientStop Offset="1"    Color="#22000000"/>
    </LinearGradientBrush>
    <!-- Border: bright top-left rim → warm gold mid → subtle bottom -->
    <LinearGradientBrush x:Key="GlassButtonBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#C8FFFFFF"/>
        <GradientStop Offset="0.38" Color="#66C8A870"/>
        <GradientStop Offset="0.70" Color="#28A88840"/>
        <GradientStop Offset="1"    Color="#30FFFFFF"/>
    </LinearGradientBrush>
    <!-- Ghost chip fills -->
    <LinearGradientBrush x:Key="GlassChipFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#28EEE4CC"/>
        <GradientStop Offset="0.5" Color="#10A89870"/>
        <GradientStop Offset="1"   Color="#0E000000"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassChipActiveFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#48F0E6D0"/>
        <GradientStop Offset="0.5" Color="#1AB8A884"/>
        <GradientStop Offset="1"   Color="#16000000"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassChipBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#90FFFFFF"/>
        <GradientStop Offset="0.48" Color="#44C8A870"/>
        <GradientStop Offset="1"    Color="#28FFFFFF"/>
    </LinearGradientBrush>
    <!-- Scanline brush — 1 px dark line every 4 px, NieR CRT feel -->
    <DrawingBrush x:Key="NostalgiaScanlineBrush"
                  Viewport="0,0,1,4"
                  ViewportUnits="Absolute"
                  TileMode="Tile"
                  Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0A3C3020" Geometry="M0,0 L1,0 1,1 0,1 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- NieR:Automata diagonal crosshatch — 45° X-grid lines every 20 px, NieR:A HUD aesthetic -->
    <DrawingBrush x:Key="MatrixRainBrush"
                  Viewport="0,0,20,20"
                  ViewportUnits="Absolute"
                  TileMode="Tile"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Diagonal \ line (top-left → bottom-right) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#3C3020" Thickness="0.55"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,0" EndPoint="20,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Diagonal / line (top-right → bottom-left) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#3C3020" Thickness="0.55"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="20,0" EndPoint="0,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- Atmospheric & overlay brushes — refined for v1-19 -->
    <SolidColorBrush x:Key="AuroraVeilBrush"           Color="#28C2B48E"/>
    <SolidColorBrush x:Key="GlitchNeonBrush"           Color="#2A2010"/>
    <!-- BladeGlass: translucent parchment layer over background –– more glass-like -->
    <LinearGradientBrush x:Key="BladeGlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F0E6DCC2"/>
        <GradientStop Offset="0.48" Color="#DCCEC29E"/>
        <GradientStop Offset="1" Color="#BEB39A78"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BladeActiveBrush"          Color="#2A2010"/>
    <SolidColorBrush x:Key="GlassPanelBorderBrush"     Color="#664A3E2A"/>
    <SolidColorBrush x:Key="GlassPanelHoverBorderBrush" Color="#14100A"/>
    <!-- Shell atmosphere: richer dual-tone warm sand glow -->
    <LinearGradientBrush x:Key="ThemeShellAtmosphereBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"   Color="#22C8BA96"/>
        <GradientStop Offset="0.4" Color="#10BEB08A"/>
        <GradientStop Offset="0.8" Color="#06A89870"/>
        <GradientStop Offset="1"   Color="#00000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ThemeShellPatternBrush" Color="Transparent"/>
    <!-- Sidebar: layered vignette — rich darkness at edges, not flat -->
    <LinearGradientBrush x:Key="ThemeSidebarOverlayBrush" StartPoint="1,0" EndPoint="0,0">
        <GradientStop Offset="0"   Color="#22000000"/>
        <GradientStop Offset="0.6" Color="#08000000"/>
        <GradientStop Offset="1"   Color="#00000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ThemeSidebarPatternBrush" Color="Transparent"/>
    <!-- Sweep: warm sand trace, more vivid -->
    <SolidColorBrush x:Key="ThemeSweepBrush" Color="#2A2010"/>
    <sys:Double x:Key="ThemeShellPatternOpacity">0.05</sys:Double>
    <sys:Double x:Key="ThemeSidebarPatternOpacity">0.06</sys:Double>
    <sys:Double x:Key="ThemeSweepOpacity">0.065</sys:Double>
    <sys:Double x:Key="ThemeRainOverlayOpacity">0.07</sys:Double>
    <sys:Double x:Key="ThemeSweepOverlayOpacity">0.07</sys:Double>
    <SolidColorBrush x:Key="ProfileSurfaceAtmosphereBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="ProfileSurfacePatternBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ProfileSurfaceSweepBrush" Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="ProfileBadgeFillBrush" Color="#18000000"/>
    <SolidColorBrush x:Key="ProfileBadgeBorderBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ProfileBadgeGlowBrush" Color="#55FFFFFF"/>
    <LinearGradientBrush x:Key="ProfileCardBaseBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E7151A23"/>
        <GradientStop Offset="0.48" Color="#BE243044"/>
        <GradientStop Offset="1" Color="#D5090B10"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProfileScoreBandBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#1FFFFFFF"/>
        <GradientStop Offset="0.55" Color="#3312D7FF"/>
        <GradientStop Offset="1" Color="#11FFFFFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProfileAvatarTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#36FFFFFF"/>
        <GradientStop Offset="0.45" Color="#2212D7FF"/>
        <GradientStop Offset="1" Color="#12000000"/>
    </LinearGradientBrush>
    <sys:Double x:Key="ProfileSurfaceAtmosphereOpacity">0.76</sys:Double>
    <sys:Double x:Key="ProfileSurfacePatternOpacity">0.12</sys:Double>
    <sys:Double x:Key="ProfileSurfaceSweepOpacity">0.16</sys:Double>
    <sys:Double x:Key="ProfileBadgePulseOpacity">0.18</sys:Double>
    <!-- ── Motion / interaction tokens — Black Flash kinetic language ──────────── -->
    <sys:Double x:Key="ThemeHoverLiftDistance">-3</sys:Double>
    <sys:Double x:Key="ThemeHoverScale">1.012</sys:Double>
    <sys:Double x:Key="ThemeHoverAnimationFastMs">55</sys:Double>
    <sys:Double x:Key="ThemeHoverAnimationSlowMs">95</sys:Double>
    <!-- Black Flash specific motion tokens -->
    <sys:Double x:Key="FlashImpactScale">1.025</sys:Double>
    <sys:Double x:Key="FlashRecoilScale">0.98</sys:Double>
    <sys:Double x:Key="FlashBurstDurationMs">85</sys:Double>
    <sys:Double x:Key="FlashSettleDurationMs">140</sys:Double>
    <!-- Artwork / overlay opacities — Black Flash optimized -->
    <sys:Double x:Key="NierArtworkOpacity">0</sys:Double>
    <sys:Double x:Key="WutheringArtworkOpacity">0</sys:Double>
    <!-- Yuji images: increased visibility while maintaining subtle blend -->
    <sys:Double x:Key="BlackFlashArtworkOpacity">0.85</sys:Double>
    <sys:Double x:Key="NierDeletionEffectOpacity">0</sys:Double>
    <sys:Double x:Key="ThemeShellOverlayOpacity">0.92</sys:Double>
    <!-- Black Flash particle & effect opacities — SUBTLE MODE -->
    <sys:Double x:Key="FlashParticleOpacity">0.35</sys:Double>
    <sys:Double x:Key="FlashArcOpacity">0.28</sys:Double>
    <sys:Double x:Key="FlashGlowOpacity">0.15</sys:Double>
    <DrawingBrush x:Key="NierDeletionBrush"
                  Viewport="0,0,72,28"
                  ViewportUnits="Absolute"
                  TileMode="Tile"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#243C3020" Geometry="M0,2 L42,2 42,3 0,3 Z"/>
                <GeometryDrawing Brush="#183C3020" Geometry="M8,10 L62,10 62,11 8,11 Z"/>
                <GeometryDrawing Brush="#143C3020" Geometry="M20,18 L70,18 70,19 20,19 Z"/>
                <GeometryDrawing Brush="#203C3020" Geometry="M6,22 L11,22 11,26 6,26 Z"/>
                <GeometryDrawing Brush="#183C3020" Geometry="M49,4 L54,4 54,8 49,8 Z"/>
                <GeometryDrawing Brush="#143C3020" Geometry="M64,13 L70,13 70,17 64,17 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ════════════════════════════════════════════════════════════════════
         THEME PROFILE TOKENS
         Monospace / terminal font · Sharp square corners · 1px borders
         ════════════════════════════════════════════════════════════════════ -->
    <!-- Modern 3D & Depth Resources -->
    <!-- ── 3-D depth & glow tokens ─────────────────────────────────────────── -->
    <Color x:Key="ThemePanelShadowColor">#14100A</Color>
    <!-- Subtle warm-gold glow on primary button hover -->
    <Color x:Key="ThemePrimaryButtonGlowColor">#8A7040</Color>
    <Color x:Key="ThemePointerGlowCenterColor">#38FFFFFF</Color>
    <Color x:Key="ThemePointerGlowMidColor">#2C8A7040</Color>
    <Color x:Key="ThemePointerClickColor">#CC8A7040</Color>
    <!-- Panel border: top-left bright, bottom-right dark for 3-D lift -->
    <LinearGradientBrush x:Key="ThemePanelBorderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#50EEE4CC"/>
        <GradientStop Offset="0.5" Color="#2A2010"/>
        <GradientStop Offset="1"   Color="#1A140A"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ThemeAtmosphereBlobBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ThemeAtmosphereBlobSecondaryBrush" Color="Transparent"/>

    <FontFamily x:Key="ThemeBodyFontFamily">Share Tech Mono, Courier New, Consolas, Lucida Console</FontFamily>
    <FontFamily x:Key="ThemeDisplayFontFamily">Share Tech Mono, Courier New, Consolas</FontFamily>
    <CornerRadius x:Key="ThemeCornerRadiusControl">0</CornerRadius>
    <CornerRadius x:Key="ThemeCornerRadiusPanel">2</CornerRadius>
    <CornerRadius x:Key="ThemeCornerRadiusLarge">3</CornerRadius>
    <CornerRadius x:Key="ThemeCornerRadiusPill">2</CornerRadius>
    <Thickness x:Key="ThemeBorderThickness">1</Thickness>
    <!-- Panel fills: slightly more opaque for crisper card legibility -->
    <SolidColorBrush x:Key="ThemePanelFillBrush"            Color="#F0CEC29E"/>
    <SolidColorBrush x:Key="ThemePanelFillSoftBrush"        Color="#D8DAD0AE"/>
    <SolidColorBrush x:Key="ThemePanelEdgeBrush"            Color="#2A2010"/>
    <SolidColorBrush x:Key="ThemePanelShadowBrush"          Color="#14100A"/>
    <SolidColorBrush x:Key="ThemeDeckFrameBrush"            Color="#22C2B48E"/>
    <SolidColorBrush x:Key="ThemeDeckFrameBorderBrush"      Color="#2A2010"/>
    <!-- Nav items: deeper ink selection, brighter hover wash for clarity -->
    <SolidColorBrush x:Key="ThemeNavItemBackgroundBrush"         Color="#18000000"/>
    <SolidColorBrush x:Key="ThemeNavItemHoverBackgroundBrush"    Color="#26EEE4CC"/>
    <SolidColorBrush x:Key="ThemeNavItemSelectedBackgroundBrush" Color="#2A2010"/>
    <SolidColorBrush x:Key="ThemeNavItemBorderBrush"             Color="#2A2010"/>
    <SolidColorBrush x:Key="ThemeNavItemHoverBorderBrush"        Color="#EEE4CC"/>
    <SolidColorBrush x:Key="ThemeNavItemSelectedBorderBrush"     Color="#EEE4CC"/>
    <SolidColorBrush x:Key="ThemeNavItemTopEdgeBrush"            Color="#50EEE4CC"/>
    <!-- Pill tabs: glass fills now for a premium tactile feel -->
    <LinearGradientBrush x:Key="ThemePillFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#20FFFFFF"/>
        <GradientStop Offset="1" Color="#10000000"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThemePillHoverFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#32FFFFFF"/>
        <GradientStop Offset="1" Color="#18000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ThemePillSelectedFillBrush"          Color="#2A2010"/>
    <SolidColorBrush x:Key="ThemePillBorderBrush"                Color="#2A2010"/>
    <SolidColorBrush x:Key="ThemePillHoverBorderBrush"           Color="#14100A"/>
    <SolidColorBrush x:Key="ThemePillSelectedBorderBrush"        Color="#14100A"/>
    <SolidColorBrush x:Key="ThemePillLabelBrush"                 Color="#4A3E2A"/>
    <SolidColorBrush x:Key="ThemePillLabelActiveBrush"           Color="#EEE4CC"/>
    <!-- ── Button tokens ──────────────────────────────────────────────────── -->
    <!-- Primary: deep ink with warm-cream text; gold glow on hover -->
    <SolidColorBrush x:Key="ThemePrimaryButtonTextBrush"         Color="#EEE4CC"/>
    <SolidColorBrush x:Key="ThemePrimaryButtonFillBrush"         Color="#2A2010"/>
    <SolidColorBrush x:Key="ThemePrimaryButtonHoverFillBrush"    Color="#1E1808"/>
    <SolidColorBrush x:Key="ThemePrimaryButtonPressedFillBrush"  Color="#120E04"/>
    <!-- Secondary: richer parchment, slightly deeper hover -->
    <SolidColorBrush x:Key="ThemeSecondaryButtonTextBrush"       Color="#14100A"/>
    <SolidColorBrush x:Key="ThemeSecondaryButtonFillBrush"       Color="#CEBE9C"/>
    <SolidColorBrush x:Key="ThemeSecondaryButtonHoverFillBrush"  Color="#C2B28A"/>
    <SolidColorBrush x:Key="ThemeSecondaryButtonPressedFillBrush" Color="#B8A880"/>
    <SolidColorBrush x:Key="ThemeSecondaryButtonBorderBrush"     Color="#2A2010"/>
    <!-- Ghost: glass feel, gold-tinted border -->
    <SolidColorBrush x:Key="ThemeGhostButtonHoverFillBrush"      Color="#1AEEE4CC"/>
    <SolidColorBrush x:Key="ThemeGhostButtonPressedFillBrush"    Color="#30C8BC9C"/>
    <SolidColorBrush x:Key="ThemeGhostButtonBorderBrush"         Color="#4A3E2A"/>
    <SolidColorBrush x:Key="ThemeGhostButtonHoverBorderBrush"    Color="#2A2010"/>


    <!-- ════════════════════════════════════════════════════════════════════
         BASE WINDOW
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- AtmosphereBlobStyle — no glow in NieR; flat transparent overlay -->
    <Style x:Key="AtmosphereBlobStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- MatrixTitleTextStyle — NieR: plain charcoal label, no animation -->
    <Style x:Key="MatrixTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeDisplayFontFamily}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         SCROLLBAR — 4 px thin, dark brown thumb on parchment track
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Width="8">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,3">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Tb" Background="{DynamicResource BorderBrush}" CornerRadius="{DynamicResource ThemeCornerRadiusPill}" Opacity="0.75"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Tb" Property="Background" Value="{DynamicResource BerryBrush}"/>
                                                    <Setter TargetName="Tb" Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Tb" Property="Background" Value="{DynamicResource BerryBrush}"/>
                                                    <Setter TargetName="Tb" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Height="8">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="3,2">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Tb" Background="{DynamicResource BorderBrush}" CornerRadius="{DynamicResource ThemeCornerRadiusPill}" Opacity="0.75"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Tb" Property="Background" Value="{DynamicResource BerryBrush}"/>
                                                            <Setter TargetName="Tb" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Tb" Property="Background" Value="{DynamicResource BerryBrush}"/>
                                                            <Setter TargetName="Tb" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Content="{TemplateBinding Content}"
                                                Margin="{TemplateBinding Padding}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0"
                                   Maximum="{TemplateBinding ScrollableHeight}" Minimum="0"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1"
                                   Maximum="{TemplateBinding ScrollableWidth}" Minimum="0"
                                   Orientation="Horizontal"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         LISTBOX
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.CacheLength" Value="1"/>
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         SIDEBAR NAVIGATION — dark panel, cream text on selection
         Mirrors NieR left panel: very dark bg, thin bordered items
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="NavListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,12,8,6"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
    </Style>

    <Style x:Key="NavListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="NavBg"
                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                            Height="38"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="0"/>
                        </Border.RenderTransform>
                        <Border.Background>
                            <SolidColorBrush x:Name="NavBgBrush" Color="#00000000"/>
                        </Border.Background>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavHoverWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="NavThemeTrace"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.62" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="NavBg"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="2" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavHoverWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="NavThemeTrace"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="NavBg"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <!-- Active left bar — solid charcoal line -->
                            <Rectangle x:Name="NavHoverWash"
                                       Fill="{DynamicResource ThemeNavItemHoverBackgroundBrush}"
                                       Opacity="0"
                                       IsHitTestVisible="False"/>
                            <Border x:Name="NavThemeTrace"
                                    Width="42"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource ThemeSweepBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00FFFFFF"/>
                                        <GradientStop Offset="0.45" Color="#FFFFFFFF"/>
                                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="ActiveBar"
                                    Width="3" HorizontalAlignment="Left"
                                    Background="{DynamicResource ThemeNavItemSelectedBorderBrush}" Opacity="0"/>
                            <StackPanel Orientation="Horizontal" Margin="14,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NavIcon"
                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="13" Width="18" TextAlignment="Center"
                                           Foreground="{DynamicResource TextOnDarkBrush}"
                                           Opacity="0.45"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLabel"
                                           Margin="10,0,0,0"
                                           Text="{TemplateBinding Content}"
                                           FontSize="11.5"
                                           FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                           Foreground="{DynamicResource TextOnDarkBrush}"
                                           Opacity="0.6"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavLabel" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="NavIcon"  Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NavBg"      Property="Background" Value="{DynamicResource ThemeNavItemSelectedBackgroundBrush}"/>
                            <Setter TargetName="NavBg"      Property="BorderBrush" Value="{DynamicResource ThemeNavItemSelectedBorderBrush}"/>
                            <Setter TargetName="NavLabel"   Property="Opacity" Value="1"/>
                            <Setter TargetName="NavIcon"    Property="Opacity" Value="1"/>
                            <Setter TargetName="ActiveBar"  Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cloud Deck / Blade nav — flat NieR terminal tab style -->
    <Style x:Key="BladeNavListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BladeNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="BladeBg"
                            MinWidth="120"
                            Padding="16,9"
                            BorderThickness="1"
                            CornerRadius="0"
                            Background="{DynamicResource ThemeNavItemBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeNavItemBorderBrush}">
                        <Grid>
                            <Border x:Name="BladeTrace"
                                    Width="58"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource ThemeSweepBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00FFFFFF"/>
                                        <GradientStop Offset="0.5" Color="#FFFFFFFF"/>
                                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <TextBlock x:Name="BladeLabel"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{TemplateBinding Content}"/>
                            <!-- Active underline — solid charcoal bar -->
                            <Border x:Name="BladeAccent"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Margin="8,0,8,0"
                                    Background="{DynamicResource BerryBrush}"
                                    Opacity="0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BladeBg" Property="Background" Value="{DynamicResource ThemeNavItemHoverBackgroundBrush}"/>
                            <Setter TargetName="BladeBg" Property="BorderBrush" Value="{DynamicResource ThemeNavItemBorderBrush}"/>
                            <Setter TargetName="BladeTrace" Property="Opacity" Value="0.48"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="BladeBg" Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
                            <Setter TargetName="BladeBg" Property="BorderBrush" Value="{DynamicResource ThemeNavItemBorderBrush}"/>
                            <Setter TargetName="BladeAccent" Property="Opacity" Value="1"/>
                            <Setter TargetName="BladeTrace" Property="Opacity" Value="0.62"/>
                            <Setter TargetName="BladeLabel" Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="BladeBg" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         TAB CONTROL STYLES
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="InvisibleTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <TabPanel IsItemsHost="True" Visibility="Collapsed" Height="0"/>
                        <Border x:Name="PageHost" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform Y="6"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="6" To="0" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill tab button — flat NieR box style -->
    <Style x:Key="PillTabButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource GlassButtonBorderThickness}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid TextElement.Foreground="{DynamicResource ThemePillLabelBrush}"
                          TextElement.FontFamily="{DynamicResource ThemeBodyFontFamily}"
                          TextElement.FontSize="{TemplateBinding FontSize}">
                        <Border x:Name="PillBg"
                                CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{DynamicResource ThemePillFillBrush}"
                                BorderBrush="{DynamicResource ThemePillBorderBrush}"/>
                        <Border x:Name="ActiveBar"
                                Height="2" VerticalAlignment="Bottom"
                                Margin="6,0,6,0" Opacity="0"
                                Background="{DynamicResource BerryBrush}"/>
                        <ContentPresenter x:Name="PillContent"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBg" Property="Background" Value="{DynamicResource ThemePillHoverFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PillBg" Property="Background" Value="{DynamicResource ThemePillSelectedFillBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="ActiveBar" Property="Opacity" Value="1"/>
                            <Setter TargetName="PillContent" Property="TextElement.Foreground" Value="{DynamicResource ThemePillLabelActiveBrush}"/>
                            <Setter TargetName="PillBg" Property="Background" Value="{DynamicResource ThemePillSelectedFillBrush}"/>
                            <Setter TargetName="PillBg" Property="BorderBrush" Value="{DynamicResource ThemePillBorderBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="0" Padding="4,4,4,0" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <TabPanel IsItemsHost="True" Margin="0"/>
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Pill"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource ThemePillFillBrush}"
                                BorderBrush="{DynamicResource ThemePillBorderBrush}"
                                BorderThickness="1"/>
                        <Border x:Name="PillHover"
                                CornerRadius="0"
                                Background="{DynamicResource ThemePillHoverFillBrush}"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <Border x:Name="PillSelected"
                                CornerRadius="0"
                                Background="{DynamicResource ThemePillSelectedFillBrush}"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <Border Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <TextBlock x:Name="PillText"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                       Text="{TemplateBinding Header}"
                                       Foreground="{DynamicResource ThemePillLabelBrush}"/>
                        </Border>
                        <Border x:Name="SelBar" Height="2" VerticalAlignment="Bottom"
                                Margin="8,0" Opacity="0"
                                Background="{DynamicResource BerryBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PillHover" Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.10"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PillHover" Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.16"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelBar" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="PillSelected" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelBar" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="PillSelected" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource ThemePillLabelActiveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         WINDOW CHROME BUTTONS
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="WindowControlButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Opacity" Value="0.55"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0">
                        <Grid>
                            <!-- Subtle top shimmer line on hover -->
                            <Border x:Name="TopLine"
                                    Height="1" VerticalAlignment="Top"
                                    Background="#14FFFFFF"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#30EEE4CC"/>
                            <Setter TargetName="TopLine" Property="Opacity" Value="1"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#48EEE4CC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowControlCloseButtonStyle" TargetType="Button"
           BasedOn="{StaticResource WindowControlButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C0392B"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#96281C"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CloudFocusVisualStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border BorderBrush="{DynamicResource GoldBrush}"
                            BorderThickness="2"
                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                            Margin="-3"
                            Opacity="0.92">
                        <Border.Effect>
                            <DropShadowEffect Color="#8A7040"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.42"/>
                        </Border.Effect>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ════════════════════════════════════════════════════════════════════
         ACTION BUTTONS — NieR terminal style
         Primary  = dark charcoal fill + cream text (like NieR status header)
         Secondary = parchment fill + dark border
         Ghost    = transparent + thin border
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource CloudFocusVisualStyle}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryButtonTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GlassButtonFillBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource GlassButtonBorderThickness}"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeBodyFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root"
                          ClipToBounds="True">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <!-- Base fill -->
                        <Border x:Name="Bg"
                                CornerRadius="{DynamicResource GlassButtonCornerRadius}"
                                Background="{DynamicResource GlassButtonFillBrush}"
                                BorderBrush="{DynamicResource GlassButtonBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ThemePrimaryButtonGlowColor}"
                                                  BlurRadius="8"
                                                  ShadowDepth="0"
                                                  Opacity="0"/>
                            </Border.Effect>
                        </Border>
                        <!-- PS5 glass top sheen -->
                        <Border x:Name="Sheen"
                                IsHitTestVisible="False"
                                CornerRadius="{DynamicResource GlassButtonCornerRadius}"
                                Background="{DynamicResource GlassSheenBrush}"/>
                        <Border x:Name="InnerEdge"
                                Margin="1"
                                IsHitTestVisible="False"
                                CornerRadius="{DynamicResource GlassButtonCornerRadius}"
                                BorderBrush="#46FFFFFF"
                                BorderThickness="1"
                                Opacity="0.55"/>
                        <!-- Pressed darkener -->
                        <Border x:Name="PressOverlay"
                                IsHitTestVisible="False"
                                CornerRadius="{DynamicResource GlassButtonCornerRadius}"
                                Background="{DynamicResource GlassPressedOverlayBrush}"
                                Opacity="0"/>
                        <!-- Bottom accent line — cream rule à la PS5 focus bar -->
                        <Border x:Name="BottomBar"
                                Height="2" VerticalAlignment="Bottom"
                                IsHitTestVisible="False"
                                Background="#60E8DEC8"/>
                        <Border x:Name="FxTrace"
                                Width="76"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource ThemeSweepBrush}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform X="-92"/>
                            </Border.RenderTransform>
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#00FFFFFF"/>
                                    <GradientStop Offset="0.52" Color="#FFFFFFFF"/>
                                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Button.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.014" Duration="0:0:0.11"/>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.014" Duration="0:0:0.11"/>
                                    <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.38" Duration="0:0:0.11"/>
                                    <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="14" Duration="0:0:0.11"/>
                                    <DoubleAnimation Storyboard.TargetName="FxTrace" Storyboard.TargetProperty="Opacity" To="0.62" Duration="0:0:0.11"/>
                                    <DoubleAnimation Storyboard.TargetName="FxTrace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="220" Duration="0:0:0.26">
                                        <DoubleAnimation.EasingFunction>
                                            <QuarticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Button.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
                                    <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.16"/>
                                    <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="8" Duration="0:0:0.16"/>
                                    <DoubleAnimation Storyboard.TargetName="FxTrace" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                    <DoubleAnimation Storyboard.TargetName="FxTrace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-92" Duration="0:0:0.01"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassButtonHoverFillBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GlassButtonBorderBrush}"/>
                            <Setter TargetName="BottomBar" Property="Background" Value="#A0E8DEC8"/>
                            <Setter TargetName="InnerEdge" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassButtonPressedFillBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GlassButtonBorderBrush}"/>
                            <Setter TargetName="PressOverlay" Property="Opacity" Value="1"/>
                            <Setter TargetName="Sheen" Property="Opacity" Value="0.4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

