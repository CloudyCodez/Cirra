                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Style="{StaticResource TextFieldStyle}" Margin="0,0,6,0" Text="{Binding EmulatorPsp, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Click="BrowseEmulatorPspClick" Content="Browse"/></Grid>
