                                    </StackPanel>
                                    <WrapPanel Grid.Column="1"
                                               Margin="18,0,0,0"
                                               VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0"
                                                Click="ScanInstalledEmulatorsClick"
                                                Content="Scan Installed"/>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0"
                                                Click="ApplyDetectedEmulatorMappingsClick"
                                                Content="Apply Detected"/>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0"
                                                Click="DetectRetroArchCoresClick"
                                                Content="Refresh Cores"/>
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Margin="0"
                                                Click="OpenRetroArchCoreCenterClick"
                                                Content="Open RetroArch Core Center"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,0,10"
                                       Text="PLATFORMS"/>

                            <ItemsControl ItemsSource="{Binding EmulatorPlatformCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PanelBorderStyle}"
                                                Width="360"
                                                Margin="0,0,14,14"
                                                Padding="14">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                               FontSize="{DynamicResource FontSizeHeading}"
                                                               Margin="0,0,8,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="{Binding Glyph}"/>
                                                    <TextBlock Grid.Column="1"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Text="{Binding Platform}"
                                                               TextWrapping="Wrap"/>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource GoldBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Text="{Binding StatusLabel}"/>
                                                </StackPanel>

                                                <TextBlock Margin="0,6,0,0"
                                                           Style="{StaticResource PathTextBlockStyle}"
                                                           TextWrapping="Wrap"
                                                           ToolTip="{Binding Path}"
                                                           Text="{Binding PathPreview}"/>

                                                <Border Margin="0,8,0,0"
                                                        Padding="6,3"
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                                        Background="{DynamicResource CardHoverBrush}"
                                                        Visibility="{Binding HasDetectedEmulatorName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="{Binding DetectedSourceLabel}"
                                                               TextWrapping="Wrap"/>
                                                </Border>

                                                <WrapPanel Margin="0,10,0,0">
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="8,4" Margin="0,0,6,6"
                                                            Click="BrowseEmulatorCardClick"
                                                            Content="Browse"/>
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Padding="8,4" Margin="0,0,6,6"
                                                            Click="ClearEmulatorCardClick"
                                                            Content="Clear"/>
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Padding="8,4" Margin="0,0,0,6"
                                                            Click="ApplyDetectedEmulatorCardClick"
                                                            Visibility="{Binding HasDetectedEmulatorName, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Content="Use Detected"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <!-- ═══════════════════════════════════════════════════════
                 STATUS BAR
                 ═══════════════════════════════════════════════════════ -->
            <Border x:Name="StatusBarHost" Grid.Row="3"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,8"
                    MinHeight="36">
                <DockPanel VerticalAlignment="Center">
                    <!-- Right side: library summary + running dot -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource VisualFeaturePillStyle}" Margin="0,0,10,0" Padding="8,2" Visibility="Collapsed">
                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding AppearanceThemeKey}"/>
                        </Border>
                        <Border Style="{StaticResource VisualFeaturePillStyle}"
                                Margin="0,0,10,0"
                                Padding="9,2"
                                Visibility="{Binding IsUpdateInstallQueued, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{DynamicResource MintBrush}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="{DynamicResource MintGlowColor}" BlurRadius="7" ShadowDepth="0" Opacity="0.75"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MintBrush}"
                                           Text="{Binding UpdateShellBadgeText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource VisualFeaturePillStyle}" Margin="0,0,10,0" Padding="8,2"
                                Visibility="{Binding IsMetadataBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar Style="{StaticResource BusyBarStyle}" Width="46" Margin="0,0,6,0"/>
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource CloudBrush}"
                                           Text="Metadata"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource VisualFeaturePillStyle}" Margin="0,0,10,0" Padding="8,2"
                                Visibility="{Binding IsAchievementBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar Style="{StaticResource BusyBarStyle}" Width="46" Margin="0,0,6,0"/>
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource GoldBrush}"
                                           Text="Achievements"/>
                            </StackPanel>
                        </Border>
                        <!-- Running game indicator -->
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MintBrush}"
                                  VerticalAlignment="Center" Margin="0,0,5,0"
                                  Visibility="Collapsed"/>
                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding LibrarySummary}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <!-- Left side: current status message -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Running game name when a session is active -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource MintBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{DynamicResource MintGlowColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MintBrush}"
                                       Text="{Binding RunningGameTitle, StringFormat='Now playing: {0}'}" ToolTip="{Binding RunningGameTitle, StringFormat='Now playing: {0}'}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="280"/>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding StatusBarMessage}" ToolTip="{Binding StatusMessage}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
        <Grid x:Name="CommandPaletteOverlay"
              Grid.ColumnSpan="3"
              Background="#B8090B10"
              Visibility="Collapsed"
              Opacity="0"
              IsHitTestVisible="False"
              Panel.ZIndex="110"
              MouseLeftButtonDown="CommandPaletteBackdropMouseDown">
<effects:ThemeEffectLayer ThemeKey="{Binding AppearanceThemeKey}"
                                      EffectRole="Cloudscape"
                                      Intensity="{Binding EffectiveVisualEffectIntensity}"
                                      Quality="{Binding EffectsQuality}"
                                      IsEffectActive="{Binding VisualEffectsEnabled}"
                                      Opacity="0.2"
                                      IsHitTestVisible="False"/>
            <Border x:Name="CommandPalettePanel"
                    Width="720"
                    MaxHeight="650"
                    Margin="28,84,28,44"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Style="{StaticResource ProfileHeroCardStyle}"
                    ClipToBounds="True"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CommandPaletteScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="CommandPaletteLift" Y="0"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Grid>
                    <Rectangle Style="{StaticResource ProfileSurfaceAtmosphereOverlayStyle}"/>
                    <Rectangle Style="{StaticResource ProfileSurfacePatternOverlayStyle}"/>
                    <Rectangle Style="{StaticResource ProfileSurfaceSweepOverlayStyle}"
                               Width="240"
                               Opacity="0.55"/>
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="4,0,4,13">
                            <Border DockPanel.Dock="Right"
                                    Style="{StaticResource GlassMetricChipStyle}"
                                    Margin="0"
                                    Padding="9,4">
                                <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="CIRRA"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Margin="0"
                                           Text="COMMAND CENTER"/>
                                <TextBlock Margin="0,4,0,0"
                                           FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                           FontSize="{DynamicResource FontSizeHeading}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="Your games. One search."/>
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           TextWrapping="Wrap"
                                           Text="Narrow with games: · commands: · themes: · views:    Enter to open · Esc to close"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <TextBox x:Name="CommandPaletteSearchBox"
                                     Height="54"
                                     Padding="48,13,44,13"
                                     VerticalContentAlignment="Center"
                                     FontSize="{DynamicResource FontSizeBodyLarge}"
                                     Style="{StaticResource TextFieldStyle}"
                                     TextChanged="CommandPaletteSearchChanged"/>
                            <TextBlock Margin="17,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="16"
                                       Foreground="{DynamicResource CloudBrush}"
                                       IsHitTestVisible="False"
                                       Text="&#xE721;"/>
                            <Button Width="30"
                                    Height="30"
                                    Margin="0,0,9,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="0"
                                    Style="{StaticResource GhostButtonStyle}"
                                    ToolTip="Close"
                                    Click="OpenCommandPaletteClick">
                                <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           FontSize="11"
                                           Text="&#xE711;"/>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2" MinHeight="168" MaxHeight="500">
                            <ListBox x:Name="CommandPaletteResultsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     MouseDoubleClick="CommandPaletteResultDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Surface"
                                                            Padding="10,8"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeNavItemHoverBackgroundBrush}"/>
                                                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource GlassButtonBorderBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassChipActiveFillBrush}"/>
                                                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CloudBrush}"/>
                                                            <Setter TargetName="Surface" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="{DynamicResource ThemePrimaryButtonGlowColor}"
                                                                                      BlurRadius="14"
                                                                                      ShadowDepth="0"
                                                                                      Opacity="0.28"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="54">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="CommandGlyphSurface"
                                                    Width="38"
                                                    Height="38"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                    Background="{DynamicResource GlassChipFillBrush}"
                                                    BorderBrush="{DynamicResource GlassChipBorderBrush}"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                           FontSize="16"
                                                           Foreground="{DynamicResource CloudBrush}"
                                                           Text="{Binding Glyph}"/>
                                            </Border>
                                            <Border x:Name="GameCoverSurface"
                                                    Width="34"
                                                    Height="48"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="4"
                                                    BorderBrush="{DynamicResource GlassChipBorderBrush}"
                                                    BorderThickness="1"
                                                    Visibility="Collapsed">
                                                <controls:CrossfadeImage Stretch="UniformToFill"
                                                                         Source="{Binding CoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=cover}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0,12,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                           FontSize="{DynamicResource FontSizeBody}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Title}"/>
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Subtitle}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource VisualFeaturePillStyle}"
                                                    Margin="0"
                                                    Padding="8,3">
                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Text="{Binding Category}"/>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsGame}" Value="True">
                                                <Setter TargetName="CommandGlyphSurface" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="GameCoverSurface" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="CommandPaletteEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False">
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           FontSize="26"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="&#xE721;"/>
                                <TextBlock Margin="0,10,0,0"
                                           FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="No matches. Try a shorter title or remove the search prefix."/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="ActionToast"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,70,30,0"
                Width="360"
                Padding="16,13"
                Style="{StaticResource ProfileHeroCardStyle}"
                Opacity="0"
                IsHitTestVisible="False"
                Panel.ZIndex="78"
                ClipToBounds="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ActionToastLift" Y="-12"/>
            </Border.RenderTransform>
            <Grid>
                <Rectangle Style="{StaticResource ProfileSurfaceAtmosphereOverlayStyle}"/>
                <Rectangle Style="{StaticResource ProfileSurfacePatternOverlayStyle}"/>
                <Rectangle Style="{StaticResource ProfileSurfaceSweepOverlayStyle}"
                           Width="150"/>
                <Grid Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34"
                            Height="34"
                            Style="{StaticResource ProfileAvatarBadgeStyle}">
                        <TextBlock x:Name="ActionToastGlyph"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                   FontSize="{DynamicResource FontSizeBodyLarge}"
                                   Foreground="{DynamicResource GoldBrush}"
                                   Text="&#xE735;"/>
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0">
                        <TextBlock x:Name="ActionToastLabel"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0"
                                   Text="ACHIEVEMENT UNLOCKED"/>
                        <TextBlock Margin="0,4,0,0"
                                   FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="GameLaunchHandoffOverlay"
              Grid.ColumnSpan="3"
              Background="#C0000000"
              Opacity="0"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              Panel.ZIndex="122">
<effects:ThemeEffectLayer ThemeKey="{Binding AppearanceThemeKey}"
                                      EffectRole="Cloudscape"
                                      Intensity="{Binding EffectiveVisualEffectIntensity}"
                                      Quality="{Binding EffectsQuality}"
                                      IsEffectActive="{Binding VisualEffectsEnabled}"
                                      Opacity="0.34"
                                      IsHitTestVisible="False"/>
            <Border x:Name="GameLaunchHandoffCard"
                    Width="500" Padding="22,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource ProfileHeroCardStyle}"
                    RenderTransformOrigin="0.5,0.5"
                    ClipToBounds="True">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="GameLaunchHandoffScale" ScaleX="0.97" ScaleY="0.97"/>
                </Border.RenderTransform>
                <Grid>
                    <Rectangle Style="{StaticResource ProfileSurfaceAtmosphereOverlayStyle}"/>
                    <Rectangle Style="{StaticResource ProfileSurfaceSweepOverlayStyle}" Width="190"/>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="50" Height="68" CornerRadius="{DynamicResource ThemeCornerRadiusSmall}"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource GlassPanelBorderBrush}" BorderThickness="1"
                                ClipToBounds="True">
                            <controls:CrossfadeImage Stretch="UniformToFill"
                                                     Source="{Binding DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PREPARING TO PLAY"/>
                            <TextBlock Margin="0,4,0,8"
                                       FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                       FontSize="{DynamicResource FontSizeTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Height="4" HorizontalAlignment="Stretch"
                                         Style="{StaticResource BusyBarStyle}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Ellipse x:Name="PointerGlow"
                 Grid.ColumnSpan="3"
                 Width="108"
                 Height="108"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Opacity="0"
                 IsHitTestVisible="False"
                 Panel.ZIndex="80">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="{DynamicResource ThemePointerGlowCenterColor}"/>
                    <GradientStop Offset="0.34" Color="{DynamicResource ThemePointerGlowMidColor}"/>
                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="PointerGlowTransform" X="-500" Y="-500"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="PointerClickPulse"
                 Grid.ColumnSpan="3"
                 Width="18"
                 Height="18"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 RenderTransformOrigin="0.5,0.5"
                 Opacity="0"
                 Stroke="{DynamicResource CloudBrush}"
                 StrokeThickness="1.5"
                 Fill="Transparent"
                 IsHitTestVisible="False"
                 Panel.ZIndex="81">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PointerClickPulseScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="PointerClickPulseTransform" X="-500" Y="-500"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</Window>
