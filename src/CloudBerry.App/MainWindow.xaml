                            <Border Style="{StaticResource PanelBorderStyle}"
                                    Margin="0,0,0,20"
                                    Visibility="{Binding IsSettingsProfileCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Social"/>
