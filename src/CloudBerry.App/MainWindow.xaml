<Window x:Class="CloudBerry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CloudBerry.App.Controls"
        xmlns:effects="clr-namespace:CloudBerry.App.Effects"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Cirra"
        Icon="pack://application:,,,/Resources/Icons/cirra_app_icon_256.png"
        Width="1560"
        Height="940"
        MinWidth="1280"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="WindowPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Converts a string path/URL → ImageSource; returns null on blank/fail -->
    </Window.Resources>

    <!-- Root: sidebar (200px) | separator (1px) | content (*) -->
    <Grid x:Name="RootShell"
          MouseMove="RootPointerMove"
          MouseLeave="RootPointerLeave"
          PreviewMouseLeftButtonDown="RootPointerDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="216" MinWidth="188" MaxWidth="360"/>
            <ColumnDefinition x:Name="SidebarSeparatorColumn" Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════
             SIDEBAR
             ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="SidebarRail"
              Grid.Column="0"
              Background="{DynamicResource SidebarBrush}"
              SizeChanged="SidebarRailSizeChanged"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>    <!-- Logo -->
                <RowDefinition Height="*"/>       <!-- Nav items -->
                <RowDefinition Height="Auto"/>    <!-- Bottom actions -->
            </Grid.RowDefinitions>

            <Image Grid.RowSpan="3"
                   Stretch="UniformToFill"
                   Opacity="{DynamicResource WutheringArtworkOpacity}"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="LowQuality"
                   Source="pack://application:,,,/Resources/Images/wuwa_theme.jpg">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#55FFFFFF"/>
                        <GradientStop Offset="0.45" Color="#2BFFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>
            <Image Grid.RowSpan="3"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="-8,0,-8,18"
                   Opacity="{DynamicResource BlackFlashArtworkOpacity}"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="LowQuality"
                   Source="pack://application:,,,/Resources/Images/yuji3.png">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00FFFFFF"/>
                        <GradientStop Offset="0.22" Color="#42FFFFFF"/>
                        <GradientStop Offset="0.66" Color="#36FFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>
            <Image Grid.RowSpan="3"
                   Stretch="UniformToFill"
                   Opacity="{DynamicResource NierArtworkOpacity}"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="LowQuality"
                   Source="pack://application:,,,/Resources/Images/nier_theme.png">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#44FFFFFF"/>
                        <GradientStop Offset="0.5" Color="#18FFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>
            <Rectangle Grid.RowSpan="3"
                       Fill="{DynamicResource ThemeSidebarOverlayBrush}"
                       IsHitTestVisible="False"/>
            <Rectangle Grid.RowSpan="3"
                       Fill="{DynamicResource ThemeSidebarPatternBrush}"
                       Opacity="{DynamicResource ThemeSidebarPatternOpacity}"
                       IsHitTestVisible="False"/>
            <Rectangle Grid.RowSpan="3"
                       Fill="{DynamicResource ThemeSweepBrush}"
                       Width="130"
                       HorizontalAlignment="Right"
                       Opacity="{DynamicResource ThemeSweepOpacity}"
                       IsHitTestVisible="False"/>
<effects:ThemeEffectLayer Grid.RowSpan="3"
                                      ThemeKey="{Binding AppearanceThemeKey}"
                                      EffectRole="Sidebar"
                                       Intensity="{Binding EffectiveVisualEffectIntensity}"
                                       Quality="{Binding EffectsQuality}"
                                      IsEffectActive="{Binding VisualEffectsEnabled}"
                                       Opacity="0.16"
                                      IsHitTestVisible="False"/>

            <!-- Brand and active profile -->
            <Border Grid.Row="0" Padding="18,22,16,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="6" ClipToBounds="True"
                                VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Resources/Icons/cirra_app_icon_256.png"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                       FontSize="{DynamicResource FontSizeHeading}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Cirra"/>
                            <TextBlock Margin="0,1,0,0"
                                       FontSize="{DynamicResource FontSizeMicro}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="UNIVERSAL LIBRARY"/>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="SidebarProfileCard"
                            Margin="0,16,0,0"
                            Padding="10"
                            CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                            Background="{DynamicResource ThemeNavItemBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30"
                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BerryBrush}"
                                           Text="{Binding ActiveProfileIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding ActiveProfileName}" ToolTip="{Binding ActiveProfileName}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="{DynamicResource FontSizeMicro}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding ActiveProfilePresenceLine}" ToolTip="{Binding ActiveProfilePresenceLine}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeMicro}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding ActiveProfileLibraryLine}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Nav list — SelectedIndex drives SelectedPrimaryPage -->
            <ListBox Grid.Row="1"
                     Style="{StaticResource NavListBoxStyle}"
                     SelectedIndex="{Binding SelectedPrimaryPage, Mode=TwoWay}"
                     SelectionMode="Single">
                <ListBoxItem Content="Home"       Tag="&#xE80F;" Style="{StaticResource NavListBoxItemStyle}"/>
                <ListBoxItem Content="Library"    Tag="&#xE8F1;" Style="{StaticResource NavListBoxItemStyle}"/>
                <ListBoxItem Content="Metadata"   Tag="&#xE946;" Style="{StaticResource NavListBoxItemStyle}"/>
                <ListBoxItem Content="Achievements" Tag="&#xE74E;" Style="{StaticResource NavListBoxItemStyle}"/>
                <ListBoxItem Content="Theatre"    Tag="&#xE7F4;" Style="{StaticResource NavListBoxItemStyle}"/>
                <ListBoxItem Content="Friends"    Tag="&#xE716;" Style="{StaticResource NavListBoxItemStyle}"/>
                <ListBoxItem Content="Settings"   Tag="&#xE713;" Style="{StaticResource NavListBoxItemStyle}"/>
                <ListBoxItem Content="Emulation"   Tag="&#xE7FC;" Style="{StaticResource NavListBoxItemStyle}"/>
            </ListBox>

            <!-- Bottom: scan + quick-add + scan ROMs -->
            <StackPanel Grid.Row="2" Margin="12,0,12,20">
                <!-- Thin separator + section label -->
                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="ADD TO LIBRARY"
                           FontSize="{DynamicResource FontSizeMicro}" FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="4,0,0,8"
                           Opacity="0.70"/>
                <Button Style="{StaticResource SidebarPrimaryActionButtonStyle}"
                        Click="ScanFolderClick"
                        Margin="0,0,0,8"
                        Content="Add Folder"
                        ToolTip="Choose a folder and let Cirra add the games it finds."/>
                <Button Style="{StaticResource SidebarActionButtonStyle}"
                        Click="QuickAddClick"
                        Margin="0,0,0,8"
                        Content="Add Game"
                        ToolTip="Add a single game or executable."/>
                <ToggleButton x:Name="SidebarMoreActionsToggle"
                              Style="{StaticResource GhostToggleButtonStyle}"
                              IsChecked="{Binding IsSidebarMaintenanceExpanded, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,8"
                              Padding="10,7">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Text="More Tools"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="10,0,0,0"
                                   FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                   FontSize="{DynamicResource FontSizeCaption}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE70D;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarMoreActionsToggle}" Value="True">
                                            <Setter Property="Text" Value="&#xE70E;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </ToggleButton>
                <StackPanel Visibility="{Binding IsChecked, ElementName=SidebarMoreActionsToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Style="{StaticResource SidebarActionButtonStyle}"
                            Click="ScanRomFolderClick"
                            Margin="0,0,0,8"
                            Content="Add ROM Folder"
                            ToolTip="Import emulated games from a folder."/>
                    <Button Style="{StaticResource SidebarActionButtonStyle}"
                            Click="ScanSteamLibrariesClick"
                            Margin="0,0,0,8"
                            Content="Add Steam Games"
                            ToolTip="Find installed Steam games."/>
                    <Button Style="{StaticResource SidebarActionButtonStyle}"
                            Click="ScanLauncherLibrariesClick"
                            Margin="0,0,0,8"
                            Content="Add Launcher Games"
                            ToolTip="Find games from supported launchers."/>
                    <Button Style="{StaticResource SidebarActionButtonStyle}"
                            Click="ScanAllLibrariesClick"
                            Margin="0,0,0,8"
                            Content="Full Scan"
                            ToolTip="Search all supported sources."/>
                    <Button Style="{StaticResource SidebarActionButtonStyle}"
                            Click="RepairLibraryClick"
                            Margin="0,0,0,8"
                            Content="Repair Paths"
                            ToolTip="Reconnect games that moved folders."/>
                    <Button Style="{StaticResource SidebarActionButtonStyle}"
                            Click="PolishLibraryTitlesClick"
                            Margin="0,0,0,8"
                            Content="Clean Titles"
                            ToolTip="Make imported names easier to read."/>
                    <Button Style="{StaticResource SidebarActionButtonStyle}"
                            Click="CleanMissingLibraryClick"
                            Margin="0,0,0,8"
                            Content="Remove Missing"
                            ToolTip="Remove entries whose files no longer exist."/>
                    <Button Style="{StaticResource SidebarActionButtonStyle}"
                            Click="OpenActivityCenterClick"
                            Margin="0,0,0,8"
                            Content="Activity Center"
                            ToolTip="Review progress, cancel running work, and inspect recent results."/>
                    <Button Style="{StaticResource SidebarActionButtonStyle}"
                            Click="OpenInputLabClick"
                            Margin="0,0,0,8"
                            Content="Input Lab"
                            ToolTip="Test controller buttons, sticks, triggers, drift, and disconnect state."/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Sidebar separator — gold hairline with soft fade -->
        <Border x:Name="SidebarSeparator"
                Grid.Column="1"
                Width="1"
                HorizontalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0"   Color="#004A3E2A"/>
                    <GradientStop Offset="0.12" Color="#528A7040"/>
                    <GradientStop Offset="0.88" Color="#528A7040"/>
                    <GradientStop Offset="1"   Color="#004A3E2A"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <GridSplitter x:Name="SidebarResizeGrip"
                      Grid.Column="1"
                      Style="{StaticResource VerticalResizeGripStyle}"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- ═══════════════════════════════════════════════════════
             MAIN CONTENT AREA
             ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="2" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>    <!-- Custom title bar -->
                <RowDefinition Height="Auto"/>  <!-- Blade navigation -->
                <RowDefinition Height="*"/>     <!-- Page content -->
                <RowDefinition Height="Auto"/>  <!-- Status bar -->
            </Grid.RowDefinitions>
            <controls:CrossfadeImage Grid.RowSpan="4"
                                     Stretch="UniformToFill"
                                     Opacity="0.09"
                                     CacheMode="BitmapCache"
                                     IsHitTestVisible="False"
                                     RenderTransformOrigin="0.5,0.5"
                                     Source="{Binding SelectedGame.DisplayBackgroundImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=background}">
                <!-- Scale down then back up = cheap GPU blur substitute. Removes software-rendered
                     BlurEffect which disabled hardware acceleration on this entire subtree. -->
                <controls:CrossfadeImage.RenderTransform>
                    <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                </controls:CrossfadeImage.RenderTransform>
            </controls:CrossfadeImage>
            <Rectangle Grid.RowSpan="4"
                       Fill="{DynamicResource ThemeShellAtmosphereBrush}"
                       IsHitTestVisible="False"/>
            <Rectangle Grid.RowSpan="4"
                       Fill="{DynamicResource HeroOverlayBrush}"
                       Opacity="{DynamicResource ThemeShellOverlayOpacity}"
                       IsHitTestVisible="False"/>
            <Rectangle Grid.RowSpan="4"
                       Fill="{DynamicResource ThemeGrainBrush}"
                       Opacity="{DynamicResource ThemeGrainOpacity}"
                       IsHitTestVisible="False"/>
            <Rectangle Grid.RowSpan="4"
                       Fill="{DynamicResource ThemeShellPatternBrush}"
                       Opacity="{DynamicResource ThemeShellPatternOpacity}"
                       IsHitTestVisible="False"/>
            <Rectangle Grid.RowSpan="4"
                       Fill="{DynamicResource NierDeletionBrush}"
                       Opacity="{DynamicResource NierDeletionEffectOpacity}"
                       IsHitTestVisible="False"/>
<effects:ThemeEffectLayer Grid.RowSpan="4"
                                      ThemeKey="{Binding AppearanceThemeKey}"
                                      EffectRole="Shell"
                                       Quality="{Binding EffectsQuality}"
                                      IsEffectActive="{Binding VisualEffectsEnabled}"
                                       Intensity="{Binding EffectiveVisualEffectIntensity}"
                                       Opacity="0.30"
                                      IsHitTestVisible="False"/>
<effects:ThemeEffectLayer Grid.Row="0"
                                      ThemeKey="{Binding AppearanceThemeKey}"
                                      EffectRole="Chrome"
                                       Quality="{Binding EffectsQuality}"
                                      IsEffectActive="{Binding VisualEffectsEnabled}"
                                       Intensity="{Binding EffectiveVisualEffectIntensity}"
                                       Opacity="0.18"
                                      IsHitTestVisible="False"
                                      Panel.ZIndex="1"/>

            <!-- 2B/A2 YoRHa artwork — right-anchored, gradient-faded left edge, subtle watermark -->
            <Grid Grid.RowSpan="4"
                  IsHitTestVisible="False"
                  ClipToBounds="True"
                  Opacity="{DynamicResource NierArtworkOpacity}">
                <Image Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Resources/Images/nier_theme.png">
                    <Image.OpacityMask>
                        <RadialGradientBrush Center="0.68,0.54"
                                             GradientOrigin="0.68,0.54"
                                             RadiusX="0.88"
                                             RadiusY="0.94">
                            <GradientStop Offset="0" Color="#FFFFFFFF"/>
                            <GradientStop Offset="0.64" Color="#DEFFFFFF"/>
                            <GradientStop Offset="0.88" Color="#66FFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </RadialGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#BCD8D0BF"/>
                            <GradientStop Offset="0.18" Color="#72D8D0BF"/>
                            <GradientStop Offset="0.42" Color="#12D8D0BF"/>
                            <GradientStop Offset="1" Color="#00D8D0BF"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#9CD8D0BF"/>
                            <GradientStop Offset="0.20" Color="#42D8D0BF"/>
                            <GradientStop Offset="0.48" Color="#00D8D0BF"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#4CD8D0BF"/>
                            <GradientStop Offset="0.36" Color="#10D8D0BF"/>
                            <GradientStop Offset="1" Color="#00D8D0BF"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- Tidal Glass artwork blended into the shell background. -->
            <Grid Grid.RowSpan="4"
                  IsHitTestVisible="False"
                  ClipToBounds="True"
                  Opacity="{DynamicResource WutheringArtworkOpacity}">
                <Image Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Resources/Images/wuwa_theme.jpg">
                    <Image.OpacityMask>
                        <RadialGradientBrush Center="0.62,0.52"
                                             GradientOrigin="0.62,0.52"
                                             RadiusX="0.92"
                                             RadiusY="0.86">
                            <GradientStop Offset="0" Color="#FFFFFFFF"/>
                            <GradientStop Offset="0.56" Color="#D8FFFFFF"/>
                            <GradientStop Offset="0.82" Color="#52FFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </RadialGradientBrush>
                    </Image.OpacityMask>
                </Image>

                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#F0061320"/>
                            <GradientStop Offset="0.22" Color="#B0061320"/>
                            <GradientStop Offset="0.56" Color="#22061320"/>
                            <GradientStop Offset="1" Color="#20061320"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#E0061320"/>
                            <GradientStop Offset="0.25" Color="#78061320"/>
                            <GradientStop Offset="0.62" Color="#00061320"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#A0061320"/>
                            <GradientStop Offset="0.34" Color="#38061320"/>
                            <GradientStop Offset="1" Color="#00061320"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- Impact Noir / JJK artwork — Yuji Itadori right-anchored, cursed energy vignette -->
            <Grid Grid.RowSpan="4"
                  IsHitTestVisible="False"
                  ClipToBounds="True"
                  Opacity="{DynamicResource BlackFlashArtworkOpacity}">
                <Image Stretch="Uniform"
                       Width="860"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,18,-70,0"
                       Opacity="0.9"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Resources/Images/yuji1.png">
                    <Image.OpacityMask>
                        <RadialGradientBrush Center="0.72,0.48"
                                             GradientOrigin="0.72,0.48"
                                             RadiusX="0.86"
                                             RadiusY="0.90">
                            <GradientStop Offset="0" Color="#CCFFFFFF"/>
                            <GradientStop Offset="0.40" Color="#92FFFFFF"/>
                            <GradientStop Offset="0.66" Color="#36FFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </RadialGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Image Stretch="Uniform"
                       Width="620"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,46,0"
                       Opacity="0.9"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Resources/Images/yuji6.png">
                    <Image.OpacityMask>
                        <RadialGradientBrush Center="0.66,0.50"
                                             GradientOrigin="0.66,0.50"
                                             RadiusX="0.88"
                                             RadiusY="0.90">
                            <GradientStop Offset="0" Color="#B8FFFFFF"/>
                            <GradientStop Offset="0.42" Color="#78FFFFFF"/>
                            <GradientStop Offset="0.72" Color="#2EFFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </RadialGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Image Stretch="Uniform"
                       Width="720"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="78,0,0,-48"
                       Opacity="0.9"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Resources/Images/yuji5.png">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#00FFFFFF"/>
                            <GradientStop Offset="0.22" Color="#58FFFFFF"/>
                            <GradientStop Offset="0.58" Color="#A0FFFFFF"/>
                            <GradientStop Offset="0.80" Color="#2EFFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Image Stretch="Uniform"
                       Width="610"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,48,110,0"
                       Opacity="0.9"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Resources/Images/yuji4.png">
                    <Image.OpacityMask>
                        <RadialGradientBrush Center="0.72,0.42"
                                             GradientOrigin="0.72,0.42"
                                             RadiusX="0.82"
                                             RadiusY="0.78">
                            <GradientStop Offset="0" Color="#A8FFFFFF"/>
                            <GradientStop Offset="0.44" Color="#70FFFFFF"/>
                            <GradientStop Offset="0.74" Color="#28FFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </RadialGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Image Stretch="Uniform"
                       Width="690"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,76,0"
                       Opacity="0.9"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Resources/Images/yuji7.png">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#A0FFFFFF"/>
                            <GradientStop Offset="0.48" Color="#62FFFFFF"/>
                            <GradientStop Offset="0.80" Color="#22FFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Image Stretch="Uniform"
                       Width="320"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="28,0,0,-34"
                       Opacity="0.9"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Resources/Images/yuji2.png">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#00FFFFFF"/>
                            <GradientStop Offset="0.22" Color="#A8FFFFFF"/>
                            <GradientStop Offset="0.72" Color="#88FFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Image Stretch="Uniform"
                       Width="260"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,30,72,0"
                       Opacity="0.9"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Resources/Images/yuji3.png">
                    <Image.OpacityMask>
                        <RadialGradientBrush Center="0.5,0.5"
                                             GradientOrigin="0.5,0.5"
                                             RadiusX="0.72"
                                             RadiusY="0.72">
                            <GradientStop Offset="0" Color="#FFFFFFFF"/>
                            <GradientStop Offset="0.58" Color="#B0FFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </RadialGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.72,0.44"
                                             GradientOrigin="0.72,0.44"
                                             RadiusX="0.46"
                                             RadiusY="0.50">
                            <GradientStop Offset="0" Color="#7CFF1D2D"/>
                            <GradientStop Offset="0.34" Color="#38B30015"/>
                            <GradientStop Offset="1" Color="#00000000"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#70020102"/>
                            <GradientStop Offset="0.42" Color="#2C020102"/>
                            <GradientStop Offset="0.72" Color="#3C120306"/>
                            <GradientStop Offset="1" Color="#78020102"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Hard left void — blends art into pure black sidebar edge -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0"    Color="#F2030507"/>
                            <GradientStop Offset="0.20" Color="#B0030507"/>
                            <GradientStop Offset="0.52" Color="#28030507"/>
                            <GradientStop Offset="1"    Color="#00030507"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Bottom cursed-energy fade — deep void floor -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0"    Color="#E8030507"/>
                            <GradientStop Offset="0.22" Color="#80030507"/>
                            <GradientStop Offset="0.55" Color="#00030507"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Subtle purple cursed-energy blush over the character -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Offset="0"    Color="#58E51B2D"/>
                            <GradientStop Offset="0.40" Color="#24A20016"/>
                            <GradientStop Offset="1"    Color="#00000000"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- Title bar — ink-dark with very subtle bottom gold shimmer -->
            <Grid x:Name="TitleBarHost" Grid.Row="0" Background="{DynamicResource SidebarBrush}">
                <!-- Gold-tinted bottom shimmer rule -->
                <Border VerticalAlignment="Bottom" Height="1" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0"   Color="#008A7040"/>
                            <GradientStop Offset="0.25" Color="#388A7040"/>
                            <GradientStop Offset="0.75" Color="#388A7040"/>
                            <GradientStop Offset="1"   Color="#008A7040"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <DockPanel>
                    <!-- Window chrome buttons (must opt-in to hit-test) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowControlButtonStyle}"
                                Click="MinimizeClick" Content="&#xE921;"/>
                        <Button Style="{StaticResource WindowControlButtonStyle}"
                                Click="MaxRestoreClick" Content="&#xE922;"/>
                        <Button Style="{StaticResource WindowControlCloseButtonStyle}"
                                Click="CloseClick" Content="&#xE8BB;"/>
                    </StackPanel>
                    <!-- Status indicator in title bar -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,12,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Width="34"
                                Height="30"
                                Margin="0,0,10,0"
                                Padding="0"
                                ToolTip="Search games and commands"
                                Click="OpenCommandPaletteClick">
                            <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="14"
                                       Text="&#xE721;"/>
                        </Button>
                        <Border Style="{StaticResource ShellStatusChipStyle}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       FontWeight="SemiBold"
                                       Text="{Binding ThemeBadgeLabel}"/>
                        </Border>
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,10,0"
                                Width="34"
                                Height="30"
                                Padding="0"
                                ToolTip="{Binding SidebarToggleLabel}"
                                Click="ToggleSidebarClick">
                            <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Text="{Binding SidebarToggleGlyph}"/>
                        </Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Padding="14,7"
                                Click="OpenBigPictureClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           FontSize="12"
                                           Text="&#xE740;"/>
                                <TextBlock Text="Horizon"/>
                            </StackPanel>
                        </Button>
                        <Border x:Name="ShellBusyCapsule"
                                Style="{StaticResource ShellStatusChipStyle}"
                                Margin="0,0,10,0"
                                Padding="10,6"
                                Visibility="{Binding IsShellBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                IsVisibleChanged="ShellBusyCapsuleIsVisibleChanged">
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar Width="34" Height="3" Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource BusyBarStyle}"/>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding ShellBusyLabel}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding CurrentPageTitle}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
            <!-- Title bar lower border — handled by shimmer inside, keep empty spacer -->
            <Border Grid.Row="0" BorderThickness="0" IsHitTestVisible="False"/>

            <!-- ─────────────────────────────────────────────────
                 BLADE NAVIGATION HOST — glass panel, gold-rule top
                 ───────────────────────────────────────────────── -->
            <Border x:Name="BladeNavigationHost"
                    Grid.Row="1"
                    Visibility="{Binding IsFocusMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="18,10,18,8"
                    Padding="10"
                    BorderThickness="0"
                    CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                    RenderTransformOrigin="0.5,0.5">
                <!-- Floating glass panel with top gold-rule -->
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#18EEE4CC"/>
                        <GradientStop Offset="1" Color="#0CEEE4CC"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.28">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Border Padding="8"
                        Background="{DynamicResource ThemeDeckFrameBrush}"
                        BorderBrush="{DynamicResource ThemeDeckFrameBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ThemeCornerRadiusPanel}">
                    <ListBox Style="{StaticResource BladeNavListStyle}"
                             SelectedIndex="{Binding SelectedPrimaryPage}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="BladeNavItemStyle"/>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="Home"/>
                        <ListBoxItem Content="Library"/>
                        <ListBoxItem Content="Metadata"/>
                        <ListBoxItem Content="Achievements"/>
                        <ListBoxItem Content="Theatre"/>
                        <ListBoxItem Content="Friends"/>
                        <ListBoxItem Content="Settings"/>
                        <ListBoxItem Content="Emulation"/>
                    </ListBox>
                </Border>
            </Border>

            <TabControl Grid.Row="2"
                        SelectedIndex="{Binding SelectedPrimaryPage}"
                        Style="{StaticResource InvisibleTabControlStyle}"
                        SelectionChanged="OnTabControlSelectionChanged">

                <!-- ══════════════════════════════════════════
                     PAGE 0 — HOME
                     ══════════════════════════════════════════ -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,18,24,24">

                            <!-- Hero stats bar -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="OVERVIEW"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="PlayPatternsButton"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,5"
                                            Margin="0,0,6,0"
                                            Click="OpenPlayPatternsClick"
                                            ToolTip="When you actually play &#x2014; time of day, day of week, session length">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Text="&#xE9D9;"/>
                                            <TextBlock Margin="7,0,0,0" FontSize="{DynamicResource FontSizeCaption}" Text="Play Patterns"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="YearWrappedButton"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,5"
                                            Margin="0,0,6,0"
                                            Click="OpenYearWrappedClick"
                                            ToolTip="Your gaming year at a glance">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Text="&#xE787;"/>
                                            <TextBlock Margin="7,0,0,0" FontSize="{DynamicResource FontSizeCaption}" Text="Year Wrapped"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="HomeCustomizeButton"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,5"
                                            Click="ToggleHomeCustomizeClick"
                                            ToolTip="Customize Home widgets">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Text="&#xE713;"/>
                                            <TextBlock Margin="7,0,0,0" FontSize="{DynamicResource FontSizeCaption}" Text="Customize"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Popup x:Name="HomeCustomizePopup"
                                       Grid.Column="1"
                                       PlacementTarget="{Binding ElementName=HomeCustomizeButton}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       IsOpen="{Binding IsHomeCustomizeOpen, Mode=TwoWay}">
                                    <Border Style="{StaticResource PanelBorderStyle}"
                                            Padding="14,12"
                                            Margin="0,6,0,0"
                                            MinWidth="200">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="HOME WIDGETS"
                                                       Margin="0,0,0,8"/>
                                            <CheckBox IsChecked="{Binding ShowLibraryStat}"
                                                      Content="Library"
                                                      Margin="0,0,0,7"/>
                                            <CheckBox IsChecked="{Binding ShowMetadataStat}"
                                                      Content="Metadata"
                                                      Margin="0,0,0,7"/>
                                            <CheckBox IsChecked="{Binding ShowAchievementsStat}"
                                                      Content="Achievements"
                                                      Margin="0,0,0,7"/>
                                            <CheckBox IsChecked="{Binding ShowGamerScoreStat}"
                                                      Content="Gamer Score"
                                                      Margin="0,0,0,7"/>
                                            <CheckBox IsChecked="{Binding ShowRunningStat}"
                                                      Content="Running"
                                                      Margin="0,0,0,7"/>
                                            <CheckBox IsChecked="{Binding ShowPlaytimeStat}"
                                                      Content="Playtime"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- First-run banner: shown only until the library has at least one game -->
                            <Border Style="{StaticResource PageHeroPanelStyle}"
                                    Margin="0,0,0,20"
                                    Visibility="{Binding HasGames, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="WELCOME TO CIRRA"/>
                                    <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                               FontSize="{DynamicResource FontSizeHeading}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,4"
                                               Text="A home for every world you play"/>
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,16"
                                               TextWrapping="Wrap"
                                               Text="Bring your games together. Start with a folder, a single game, or an existing library."/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Margin="0,0,10,10"
                                                Click="ScanFolderClick"
                                                Content="Scan a Folder"/>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,10,10"
                                                Click="QuickAddClick"
                                                Content="Add One Game"/>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,10,10"
                                                Click="OpenEmulationPageClick"
                                                Content="Set Up Emulation"/>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,10,10"
                                                Click="RestoreLibraryClick"
                                                Content="Import / Restore Library"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,14"
                                  Visibility="{Binding HasGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="StatCard0" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32" BeginTime="0:0:0.00"/>
                                                <DoubleAnimation Storyboard.TargetName="StatCard0T" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.32" BeginTime="0:0:0.00"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="StatCard1" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32" BeginTime="0:0:0.07"/>
                                                <DoubleAnimation Storyboard.TargetName="StatCard1T" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.32" BeginTime="0:0:0.07"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="StatCard2" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32" BeginTime="0:0:0.14"/>
                                                <DoubleAnimation Storyboard.TargetName="StatCard2T" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.32" BeginTime="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="StatCard3" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32" BeginTime="0:0:0.21"/>
                                                <DoubleAnimation Storyboard.TargetName="StatCard3T" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.32" BeginTime="0:0:0.21"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="StatCard4" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32" BeginTime="0:0:0.28"/>
                                                <DoubleAnimation Storyboard.TargetName="StatCard4T" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.32" BeginTime="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="StatCard5" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32" BeginTime="0:0:0.35"/>
                                                <DoubleAnimation Storyboard.TargetName="StatCard5T" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.32" BeginTime="0:0:0.35"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ShowLibraryStat, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                                    <ColumnDefinition Width="{Binding ShowMetadataStat, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                                    <ColumnDefinition Width="{Binding ShowAchievementsStat, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                                    <ColumnDefinition Width="{Binding ShowGamerScoreStat, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                                    <ColumnDefinition Width="{Binding ShowRunningStat, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                                    <ColumnDefinition Width="{Binding ShowPlaytimeStat, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="StatCard0" Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0"
                                        Visibility="{Binding ShowLibraryStat, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Opacity="0" RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform><TranslateTransform x:Name="StatCard0T" Y="12"/></Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="LIBRARY"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeStatLarge}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding TotalGames}"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="Total games"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StatCard1" Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0"
                                        Visibility="{Binding ShowMetadataStat, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Opacity="0" RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform><TranslateTransform x:Name="StatCard1T" Y="12"/></Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="METADATA"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeStatLarge}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding MetadataReadyCount}"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="Art + summaries"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StatCard2" Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0"
                                        Visibility="{Binding ShowAchievementsStat, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Opacity="0" RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform><TranslateTransform x:Name="StatCard2T" Y="12"/></Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ACHIEVEMENTS"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeStatLarge}"
                                                   Foreground="{DynamicResource GoldBrush}"
                                                   Text="{Binding UnlockedAchievementsCount}"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding TotalAchievementsCount, StringFormat=out of {0} synced}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StatCard3" Grid.Column="3" Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0"
                                        Visibility="{Binding ShowGamerScoreStat, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Opacity="0" RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform><TranslateTransform x:Name="StatCard3T" Y="12"/></Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="GAMERSCORE"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeStatMedium}"
                                                   Foreground="{DynamicResource GoldBrush}"
                                                   Text="{Binding LibraryGamerScore, StringFormat={}{0:N0} G}"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"
                                                   Text="{Binding LibraryGamerScoreLabel}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StatCard4" Grid.Column="4" Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0"
                                        Visibility="{Binding ShowRunningStat, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Opacity="0" RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform><TranslateTransform x:Name="StatCard4T" Y="12"/></Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="RUNNING"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeStatLarge}"
                                                   Foreground="{DynamicResource MintBrush}"
                                                   Text="{Binding RunningCount}"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="Live sessions"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StatCard5" Grid.Column="5" Style="{StaticResource PanelBorderStyle}"
                                        Visibility="{Binding ShowPlaytimeStat, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Opacity="0" RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform><TranslateTransform x:Name="StatCard5T" Y="12"/></Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PLAYTIME"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeStatMedium}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding WeeklyHoursLabel}"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"
                                                   Text="{Binding PlayStreakLabel}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Backlog Debt callout (DIFFERENTIATORS.md #1) -->
                            <Border Style="{StaticResource FeatureDetailCardStyle}"
                                    Padding="18,14"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding HasBacklogDebt, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                               FontSize="{DynamicResource FontSizeHeading}" Margin="0,0,16,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource GoldBrush}"
                                               Text="&#xE719;"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeHeading}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding BacklogDebtLabel}"/>
                                        <TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding HasOldestUntouchedGame, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   Text="{Binding OldestUntouchedLabel, StringFormat='Oldest: {0}'}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Quick actions hero panel -->
                            <Border Style="{StaticResource PageHeroPanelStyle}"
                                    Padding="0"
                                    Margin="0,0,0,16"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:CrossfadeImage Stretch="UniformToFill"
                                                             Opacity="0.12"
                                                             CacheMode="BitmapCache"
                                                             IsHitTestVisible="False"
                                                             Source="{Binding SelectedGame.DisplayBackgroundImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=background}"/>
                                    <Rectangle Fill="{DynamicResource ThemeShellAtmosphereBrush}"
                                               IsHitTestVisible="False"/>
                                    <Rectangle Fill="{DynamicResource HeroOverlayBrush}"
                                               Opacity="0.7"
                                               IsHitTestVisible="False"/>
                                    <StackPanel VerticalAlignment="Top" Margin="22,14">
                                        <Border x:Name="HomeProfileHeroCard"
                                                Style="{StaticResource ProfileHeroCardStyle}"
                                                Width="360"
                                                Height="146"
                                                Margin="0,0,0,8"
                                                Padding="0"
                                                Visibility="Collapsed"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Rectangle Style="{StaticResource ProfileSurfaceAtmosphereOverlayStyle}"/>
                                                <Rectangle Style="{StaticResource ProfileSurfacePatternOverlayStyle}"/>
                                                <Rectangle Style="{StaticResource ProfileSurfaceSweepOverlayStyle}"
                                                           Width="150"/>
                                                <Grid Margin="16,13">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="58"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,8">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Style="{StaticResource FieldLabelStyle}"
                                                                       Margin="0"
                                                                       Text="{Binding ActiveProfileCloudCode}"/>
                                                            <StackPanel DockPanel.Dock="Right"
                                                                        Orientation="Horizontal">
                                                                <Ellipse Width="7"
                                                                         Height="7"
                                                                         Margin="0,0,6,0"
                                                                         VerticalAlignment="Center"
                                                                         Fill="{DynamicResource MintBrush}"/>
                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           Text="{Binding ProfileSocialSummary}"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding ActiveProfileName}"/>
                                                        <TextBlock Margin="0,4,0,0"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Text="{Binding ActiveProfilePresenceLine}"/>
                                                        <TextBlock Margin="0,8,0,0"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="{Binding ActiveProfileMotto}"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="28"/>
                                                        <Grid Margin="0,4,0,0"
                                                              Visibility="Collapsed">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="12"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Style="{StaticResource ProfileStatCardStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                                               Text="LIBRARY"/>
                                                                    <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                    FontSize="{DynamicResource FontSizeHeading}"
                                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                                    Text="{Binding ActiveProfileLibraryLine}"/>
                                                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                                    Text="{Binding ActiveProfileDominantPlatform}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Grid.Column="2"
                                                                    Style="{StaticResource ProfileStatCardStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                                               Text="GAMERSCORE"/>
                                                                    <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                    FontSize="{DynamicResource FontSizeHeading}"
                                                                    Foreground="{DynamicResource CloudBrush}"
                                                                    Text="{Binding ActiveProfileScoreLine}"/>
                                                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                                    Text="{Binding ActiveProfileAchievementLine}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                    <Grid Grid.Column="1"
                                                          HorizontalAlignment="Right">
                                                        <Border VerticalAlignment="Top"
                                                                Width="52"
                                                                Height="52"
                                                                Style="{StaticResource ProfileAvatarBadgeStyle}">
                                                            <Grid>
                                                                <Ellipse Style="{StaticResource ProfileBadgePulseStyle}"
                                                                         Margin="-6"/>
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                                           FontSize="{DynamicResource FontSizeTitle}"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           Text="{Binding ActiveProfileIconGlyph}"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <WrapPanel Margin="0,0,0,8">
                                            <Border Style="{StaticResource VisualFeaturePillStyle}">
                                                <TextBlock Foreground="{DynamicResource ThemePillLabelBrush}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding TotalGames, StringFormat={}{0} titles organized}"/>
                                            </Border>
                                            <Border Style="{StaticResource VisualFeaturePillStyle}">
                                                <TextBlock Foreground="{DynamicResource ThemePillLabelBrush}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding MetadataReadyCount, StringFormat={}{0} metadata ready}"/>
                                            </Border>
                                            <Border Style="{StaticResource VisualFeaturePillStyle}">
                                                <TextBlock Foreground="{DynamicResource ThemePillLabelBrush}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding GamesWithAchievementsCount, StringFormat={}{0} achievement-ready}"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeHeading}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="Library overview"/>
                                        <TextBlock Margin="0,5,0,12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Text="{Binding LibrarySummary}"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="DownloadMissingMetadataClick" Content="Fill Metadata"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="SyncMissingAchievementsClick" Content="Sync Achievements"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Last selected / spotlight quick-launch card -->
                                    <Border Grid.Column="1" Margin="22,18,18,18" Width="190"
                                            Style="{StaticResource AccentPanelStyle}"
                                            Padding="0"
                                            ClipToBounds="True">
                                        <Grid>
                                            <!-- Cover image fills card -->
                                            <Border ClipToBounds="True">
                                                <controls:CrossfadeImage Stretch="UniformToFill"
                                                                         Opacity="0.28"
                                                                         Source="{Binding SelectedGame.DisplayBackgroundImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=background}"/>
                                                                         </Border>
                                            <!-- Full-card scrim so screenshot detail (baked-in game UI, item
                                                 labels, etc.) never reads as noise behind the title text. -->
                                            <Rectangle Fill="{DynamicResource HeroOverlayBrush}" IsHitTestVisible="False"/>
                                            <!-- Bottom gradient + info -->
                                            <Rectangle VerticalAlignment="Bottom" Height="100">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#001A1410"/>
                                                        <GradientStop Offset="1" Color="#FF1A1410"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,16">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                           Foreground="{DynamicResource TextOnDarkBrush}"
                                                           Text="READY TO LAUNCH"/>
                                                <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                           FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding SelectedGame.Title, TargetNullValue='No game selected'}" ToolTip="{Binding SelectedGame.Title, TargetNullValue='No game selected'}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                                        Margin="0,8,0,0" Padding="10,7" FontSize="{DynamicResource FontSizeSmall}"
                                                        Click="LaunchSelectedGameClick"
                                                        Content="&#x25B6;&#x2002;Launch"/>
                                            </StackPanel>
                                            <!-- Label when nothing selected -->
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}"
                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                       Margin="14"
                                                       Text="Pick a game in Library"
                                                       Visibility="{Binding HasSelectedGame, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Library Health: turns hidden diagnostics into a plain-language care loop. -->
                            <Border Style="{StaticResource FeatureDetailCardStyle}"
                                    Padding="16,13"
                                    Margin="0,0,0,16"
                                    ToolTip="Checks the parts that make a library feel reliable: launch paths, duplicate entries, artwork, achievements, emulators, metadata sources, and storage.">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="42"
                                            Height="42"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Top"
                                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   Foreground="{DynamicResource MintBrush}"
                                                   Text="&#xE9D9;"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                   Text="LIBRARY HEALTH"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding LibraryHealthHeadline}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,5,0,12"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding LibraryHealthNextStep}"
                                                   TextWrapping="Wrap"/>
                                        <WrapPanel>
                                            <Border Style="{StaticResource VisualFeaturePillStyle}"
                                                    Margin="0,0,8,8">
                                                <TextBlock Foreground="{DynamicResource ThemePillLabelBrush}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ProductReadinessScoreLabel}"/>
                                            </Border>
                                            <Border Style="{StaticResource VisualFeaturePillStyle}"
                                                    Margin="0,0,8,8">
                                                <TextBlock Foreground="{DynamicResource ThemePillLabelBrush}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ProductReadinessLastCheckedLabel}"/>
                                            </Border>
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,0,8,8"
                                                    Click="RunProductReadinessCheckClick"
                                                    Content="Run Health Check"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,8,8"
                                                    Click="RunLibraryHealthActionClick"
                                                    Content="{Binding LibraryHealthActionLabel}"
                                                    Visibility="{Binding HasLibraryHealthAction, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,0,8"
                                                    Click="PrepareProductTestPassClick"
                                                    Content="Backup + Recheck"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Play Window: time-aware recommendations from the user's real session history. -->
                            <Border Style="{StaticResource FeatureDetailCardStyle}"
                                    Padding="16,14"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding HasPlayWindowRecommendations, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PLAY WINDOW"/>
                                        <TextBlock Margin="0,4,0,9"
                                                   FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="How much time do you have?"
                                                   TextWrapping="Wrap"/>
                                        <ComboBox ItemsSource="{Binding PlayWindowOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Minutes"
                                                  SelectedValue="{Binding SelectedPlayWindowMinutes, Mode=TwoWay}"
                                                  MinWidth="150"
                                                  HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{DynamicResource BorderSubtleBrush}"/>

                                    <Grid Grid.Column="2" Margin="18,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="58" Height="78"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusSmall}"
                                                ClipToBounds="True"
                                                Background="{DynamicResource SurfaceElevatedBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1">
                                            <Image Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding PlayWindowPrimaryRecommendation.Game.DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,18,0" VerticalAlignment="Center">
                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                       FontSize="{DynamicResource FontSizeHeading}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding PlayWindowPrimaryRecommendation.Game.Title}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MintBrush}"
                                                       Text="{Binding PlayWindowPrimaryRecommendation.FitLabel}"/>
                                            <TextBlock Margin="0,5,0,0"
                                                       MaxWidth="720"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding PlayWindowSummary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                VerticalAlignment="Center"
                                                Click="LaunchPlayWindowGameClick"
                                                Content="&#x25B6;&#x2002;Play"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Jump back in — Xbox/PS5-style recent-activity shelf, horizontal scroll -->
                            <StackPanel Margin="0,0,0,20"
                                        Visibility="{Binding HasJumpBackInGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Jump back in" Margin="2,0,0,8"/>
                                <ListBox ItemsSource="{Binding JumpBackInGames}"
                                         SelectedItem="{Binding SelectedGame}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0,0,0,4"
                                         MouseDoubleClick="GameListDoubleClick"
                                         PreviewMouseRightButtonDown="GameListPreviewMouseRightButtonDown"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Launch" Click="LaunchSelectedGameClick"/>
                                            <MenuItem Header="Edit Metadata" Click="OpenSelectedGameMetadataWorkspaceClick"/>
                                            <MenuItem Header="View Achievements" Click="OpenSelectedGameAchievementsPageClick"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,12,0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Width" Value="136"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ShelfCard"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                    Background="{DynamicResource CardBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ShelfCardHoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ShelfCardHoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <StackPanel>
                                                    <Border CornerRadius="{DynamicResource ThemeCornerRadiusControl}" ClipToBounds="True">
                                                        <Grid Height="176">
                                                            <Border Background="{DynamicResource SurfaceBrush}"/>
                                                            <Image Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Source="{Binding DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                                                            <Border x:Name="ShelfCardHoverOverlay" Background="{DynamicResource ArtworkHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
                                                            <!-- Running dot -->
                                                            <Border Width="9" Height="9" CornerRadius="5"
                                                                    Background="{DynamicResource BerryBrush}"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock FontSize="{DynamicResource FontSizeBody}" Margin="6"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Foreground="{DynamicResource GoldBrush}"
                                                            Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Text="&#x2605;"/>
                                                            <ProgressBar Style="{StaticResource AchievementProgressBarStyle}"
                                                                         VerticalAlignment="Bottom" Height="3" BorderThickness="0"
                                                                         Value="{Binding AchievementCompletionPercent, Mode=OneWay}"
                                                                         Maximum="100"
                                                                         Visibility="{Binding HasAchievements, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Margin="2,7,2,2">
                                                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}"
                                                                   FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                                                   FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding LastPlayedLabelShort}" ToolTip="{Binding LastPlayedLabelShort}"
                                                                   FontSize="{DynamicResource FontSizeCaption}" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter TargetName="ShelfCard" Property="BorderBrush" Value="{DynamicResource BerryBrush}"/>
                                                    <Setter TargetName="ShelfCard" Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Almost there — 70-99% complete, close to a clean achievement sweep -->
                            <StackPanel Margin="0,0,0,20"
                                        Visibility="{Binding HasAlmostThereGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Almost there" Margin="2,0,0,8"/>
                                <ListBox ItemsSource="{Binding AlmostThereGames}"
                                         SelectedItem="{Binding SelectedGame}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0,0,0,4"
                                         MouseDoubleClick="GameListDoubleClick"
                                         PreviewMouseRightButtonDown="GameListPreviewMouseRightButtonDown"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Launch" Click="LaunchSelectedGameClick"/>
                                            <MenuItem Header="Edit Metadata" Click="OpenSelectedGameMetadataWorkspaceClick"/>
                                            <MenuItem Header="View Achievements" Click="OpenSelectedGameAchievementsPageClick"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,12,0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Width" Value="136"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="AlmostThereCard"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                    Background="{DynamicResource CardBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="AlmostThereCardHoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="AlmostThereCardHoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <StackPanel>
                                                    <Border CornerRadius="{DynamicResource ThemeCornerRadiusControl}" ClipToBounds="True">
                                                        <Grid Height="176">
                                                            <Border Background="{DynamicResource SurfaceBrush}"/>
                                                            <Image Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Source="{Binding DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                                                            <Border x:Name="AlmostThereCardHoverOverlay" Background="{DynamicResource ArtworkHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
                                                            <Border Style="{StaticResource VisualFeaturePillStyle}"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                                    Padding="6,2">
                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource GoldBrush}"
                                                                           Text="{Binding AchievementCompletionPercent, StringFormat={}{0:0}%}"/>
                                                            </Border>
                                                            <ProgressBar Style="{StaticResource AchievementProgressBarStyle}"
                                                                         VerticalAlignment="Bottom" Height="3" BorderThickness="0"
                                                                         Value="{Binding AchievementCompletionPercent, Mode=OneWay}"
                                                                         Maximum="100"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Margin="2,7,2,2">
                                                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}"
                                                                   FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                                                   FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AchievementSummary}" ToolTip="{Binding AchievementSummary}"
                                                                   FontSize="{DynamicResource FontSizeCaption}" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter TargetName="AlmostThereCard" Property="BorderBrush" Value="{DynamicResource BerryBrush}"/>
                                                    <Setter TargetName="AlmostThereCard" Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Recently improved — games whose metadata/artwork was just filled in or refreshed -->
                            <StackPanel Margin="0,0,0,20"
                                        Visibility="{Binding HasRecentlyImprovedGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Recently improved" Margin="2,0,0,8"/>
                                <ListBox ItemsSource="{Binding RecentlyImprovedGames}"
                                         SelectedItem="{Binding SelectedGame}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0,0,0,4"
                                         MouseDoubleClick="GameListDoubleClick"
                                         PreviewMouseRightButtonDown="GameListPreviewMouseRightButtonDown"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Launch" Click="LaunchSelectedGameClick"/>
                                            <MenuItem Header="Edit Metadata" Click="OpenSelectedGameMetadataWorkspaceClick"/>
                                            <MenuItem Header="View Achievements" Click="OpenSelectedGameAchievementsPageClick"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,12,0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Width" Value="136"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="RecentlyImprovedCard"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                    Background="{DynamicResource CardBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="RecentlyImprovedCardHoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="RecentlyImprovedCardHoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <StackPanel>
                                                    <Border CornerRadius="{DynamicResource ThemeCornerRadiusControl}" ClipToBounds="True">
                                                        <Grid Height="176">
                                                            <Border Background="{DynamicResource SurfaceBrush}"/>
                                                            <Image Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Source="{Binding DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                                                            <Border x:Name="RecentlyImprovedCardHoverOverlay" Background="{DynamicResource ArtworkHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
                                                            <Border Style="{StaticResource VisualFeaturePillStyle}"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                                    Padding="6,2">
                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource ThemePillLabelActiveBrush}"
                                                                           Text="Updated"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Margin="2,7,2,2">
                                                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}"
                                                                   FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                                                   FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding MetadataCoverageLabel}" ToolTip="{Binding MetadataCoverageLabel}"
                                                                   FontSize="{DynamicResource FontSizeCaption}" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter TargetName="RecentlyImprovedCard" Property="BorderBrush" Value="{DynamicResource BerryBrush}"/>
                                                    <Setter TargetName="RecentlyImprovedCard" Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="ContinuePlayingCard" Grid.Column="0" Style="{StaticResource AccentPanelStyle}" Margin="0,0,10,0" Padding="0" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="92"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <controls:CrossfadeImage Stretch="UniformToFill"
                                                                     Opacity="0.42"
                                                                     Source="{Binding ContinuePlayingGame.DisplayBackgroundImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=background}"/>
                                            <Rectangle Fill="{DynamicResource CardBottomOverlayBrush}" Opacity="0.9"/>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="16,14,16,16">
                                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Continue playing"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding ContinuePlayingGame.Title, TargetNullValue='Nothing in progress yet'}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,8,0,14"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding ContinuePlayingSummary}"
                                                   TextWrapping="Wrap"/>
                                        <Border Margin="0,0,0,14"
                                                Padding="10,9"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                Background="{DynamicResource ThemeNavItemBackgroundBrush}"
                                                Visibility="{Binding ContinuePlayingGame.HasNextTimeNote, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Top"
                                                           Margin="0,2,0,0"
                                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource CloudBrush}"
                                                           Text="&#xE70B;"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                               Margin="0"
                                                               Text="NEXT TIME"/>
                                                    <TextBlock Margin="0,4,0,0"
                                                               MaxHeight="44"
                                                               FontSize="{DynamicResource FontSizeSmall}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding ContinuePlayingGame.NextTimeNote}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <WrapPanel>
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="LaunchContinuePlayingClick"
                                                    Content="&#x25B6;&#x2002;Launch"/>
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Click="RevealContinuePlayingClick"
                                                    Content="Open in Library"/>
                                        </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="RotatingPickCard" Grid.Column="1" Style="{StaticResource AccentPanelStyle}" Margin="0,0,10,0" Padding="0" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="92"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <controls:CrossfadeImage Stretch="UniformToFill"
                                                                     Opacity="0.42"
                                                                     Source="{Binding RandomBacklogGame.DisplayBackgroundImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=background}"/>
                                            <Rectangle Fill="{DynamicResource CardBottomOverlayBrush}" Opacity="0.9"/>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="16,14,16,16">
                                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Rotating pick"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding RandomBacklogGame.Title, TargetNullValue='Pick a game to start the rotation', NotifyOnTargetUpdated=True}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Triggers>
                                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.15" To="1" Duration="0:0:0.45"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </TextBlock.Triggers>
                                        </TextBlock>
                                        <TextBlock Margin="0,8,0,14"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding RandomBacklogSummary}"
                                                   TextWrapping="Wrap"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="LaunchBacklogPickClick"
                                                    Content="&#x25B6;&#x2002;Launch"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="ShuffleBacklogPickClick"
                                                    Content="Shuffle Pick"/>
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Click="RevealBacklogPickClick"
                                                    Content="Open in Library"/>
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Click="OpenBacklogPickMetadataClick"
                                                    Content="Edit Metadata"/>
                                        </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="SmartPickCard" Grid.Column="2" Style="{StaticResource AccentPanelStyle}" Padding="0" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="92"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <controls:CrossfadeImage Stretch="UniformToFill"
                                                                     Opacity="0.42"
                                                                     Source="{Binding RecommendedGame.DisplayBackgroundImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=background}"/>
                                            <Rectangle Fill="{DynamicResource CardBottomOverlayBrush}" Opacity="0.9"/>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="16,14,16,16">
                                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Smart recommendation"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding RecommendedGame.Title, TargetNullValue='No smart pick ready'}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,8,0,14"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding RecommendedGameReason}"
                                                   TextWrapping="Wrap"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="LaunchRecommendedGameClick"
                                                    Content="&#x25B6;&#x2002;Launch"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="RevealRecommendedGameClick"
                                                    Content="Open in Library"/>
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Click="OpenRecommendedMetadataClick"
                                                    Content="Edit Metadata"/>
                                        </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Recent unlocks + spotlight -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Recent unlocks"/>
                                        <TextBlock Margin="0,0,0,16" Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding AchievementStatusMessage}"/>
                                        <TextBlock Margin="0,0,0,12"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="No recent unlocks yet. Launch a game through Cirra and local tracking will surface them here."
                                                   Visibility="{Binding HasRecentAchievementUnlocks, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        <ListBox ItemsSource="{Binding RecentAchievementUnlocks}"
                                                 BorderThickness="0" Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,10" Padding="12,10"
                                                            Style="{StaticResource FeatureDetailCardStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="40" Height="40"
                                                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}">
                                                                <Image Stretch="UniformToFill"
                                                                       Source="{Binding IconUrl, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               Text="{Binding AchievementTitle}"/>
                                                                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="6,1"
                                                                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                                            Background="{DynamicResource ThemePillSelectedFillBrush}"
                                                                            Visibility="{Binding IsNewThisSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="NEW" FontSize="10" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource ThemePillLabelActiveBrush}"/>
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           Text="{Binding GameTitle}"/>
                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           Text="{Binding UnlockedLabel}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="HomeSpotlightCard" Grid.Column="1" Style="{StaticResource PageHeroPanelStyle}" Padding="0" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="176"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Border Margin="16,14,0,0"
                                                    Panel.ZIndex="2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource VisualFeaturePillStyle}">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0"
                                                           Foreground="{DynamicResource ThemePillLabelActiveBrush}"
                                                           Text="SPOTLIGHT"/>
                                            </Border>
                                            <controls:CrossfadeImage Stretch="UniformToFill"
                                            Source="{Binding SelectedGame.DisplayBackgroundImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=background}"/>
                                            <Rectangle Fill="{DynamicResource ThemeShellAtmosphereBrush}" Opacity="0.55"/>
                                            <Rectangle Fill="{DynamicResource CardBottomOverlayBrush}" Opacity="0.95"/>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="18,16,18,18">
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeHeading}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding SelectedGame.Title, TargetNullValue='Pick a game in Library'}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding SelectedGame.AchievementSummary, TargetNullValue='No achievement data yet'}"/>
                                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding SelectedGame.MetadataCoverageLabel, TargetNullValue='Metadata status appears here.'}"/>
                                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}"
                                                   Text="{Binding SelectedGame.SummaryOrPlaceholder, TargetNullValue='Select a game to see its summary here.'}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Recent activity feed -->
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="0,14,0,0"
                                    Visibility="{Binding HasHomeActivityFeed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Recent activity"/>
                                    <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource TextMutedBrush}"
                                               Text="What's happened in your library lately."/>
                                    <ItemsControl ItemsSource="{Binding HomeActivityFeed}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="26" Height="26" Margin="0,0,10,0"
                                                            CornerRadius="13"
                                                            Background="{DynamicResource ThemePillSelectedFillBrush}">
                                                        <TextBlock Text="{Binding Glyph}"
                                                                   FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ThemePillLabelActiveBrush}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding Detail}"/>
                                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   Visibility="{Binding HasGameTitle, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                   Text="{Binding GameTitle}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="{DynamicResource FontSizeCaption}"
                                                               Text="{Binding TimeAgoLabel}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Library workspace -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- Library toolbar -->
                            <RowDefinition Height="*"/>      <!-- Content area -->
                        </Grid.RowDefinitions>

                        <!-- Library toolbar row -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource ThemePanelFillSoftBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="24,12">
                            <StackPanel>
                            <DockPanel>
                                <!-- Pill sub-tabs -->
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource ThemePanelFillBrush}"
                                        BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        Padding="6"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PillTabButtonStyle}"
                                                Padding="12,6" Margin="0,0,2,0" FontSize="{DynamicResource FontSizeSmall}"
                                                Tag="{Binding IsBrowseTabActive}"
                                                Click="LibTabBrowseClick"
                                                Content="Library"
                                                ToolTip="Browse your saved games"/>
                                        <Button Style="{StaticResource PillTabButtonStyle}"
                                                Padding="12,6" Margin="0" FontSize="{DynamicResource FontSizeSmall}"
                                                Tag="{Binding IsImportTabActive}"
                                                Click="LibTabImportClick"
                                                Content="Import Review"
                                                ToolTip="Review scanned games before adding them"/>
                                    </StackPanel>
                                </Border>
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="12,7" Margin="10,0,0,0" FontSize="{DynamicResource FontSizeSmall}"
                                        VerticalAlignment="Center"
                                        Click="OpenMetadataWindowClick"
                                        Content="Edit Selected"
                                        ToolTip="Edit details and artwork for the selected game"/>
                                <ToggleButton x:Name="LibraryToolsToggle"
                                              DockPanel.Dock="Right"
                                              Style="{StaticResource GhostToggleButtonStyle}"
                                              IsChecked="{Binding IsLibraryToolsExpanded, Mode=TwoWay}"
                                              Padding="12,7" Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                        ToolTip="Show platform filters, achievement filters, presets, and cleanup tools">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" FontSize="{DynamicResource FontSizeSmall}" Text="More Filters"/>
                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                                                   FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="{DynamicResource FontSizeCaption}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE70D;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=LibraryToolsToggle}" Value="True">
                                                            <Setter Property="Text" Value="&#xE70E;"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </ToggleButton>
                                <!-- Search + sort -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,0,16,0">
                                    <!-- New Collection -->
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6" Margin="0,0,10,0" FontSize="{DynamicResource FontSizeSmall}"
                                            Click="NewCollectionClick"
                                            ToolTip="Create a manual collection from any games you pick">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,6,0" Text="&#xE710;"/>
                                            <TextBlock Text="Collection"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Grid tile size (only meaningful in grid view) -->
                                    <ComboBox Style="{StaticResource ComboFieldStyle}"
                                              Width="100" Margin="0,0,10,0"
                                              Visibility="{Binding IsLibraryGridView, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              ItemsSource="{Binding LibraryGridTileSizes}"
                                              SelectedItem="{Binding LibraryGridTileSize}"
                                              ToolTip="Grid tile size"/>
                                    <!-- List / Grid view toggle -->
                                    <Border Background="{DynamicResource ThemePanelFillBrush}"
                                            BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0"
                                            Padding="3"
                                            Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Padding="7,5" Margin="0,0,1,0"
                                                    Click="SetLibraryListViewClick"
                                                    ToolTip="List view">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLibraryListView}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BerryBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="{DynamicResource FontSizeBody}" Text="&#xE71D;"/>
                                            </Button>
                                            <Button Padding="7,5"
                                                    Click="SetLibraryGridViewClick"
                                                    ToolTip="Grid view">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLibraryGridView}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BerryBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="{DynamicResource FontSizeBody}" Text="&#xE80A;"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <ComboBox Style="{StaticResource ComboFieldStyle}"
                                              Width="170" Margin="0,0,10,0"
                                              ItemsSource="{Binding SortOptions}"
                                              SelectedItem="{Binding SelectedSortOption}"/>
                                </StackPanel>
                                <TextBox x:Name="LibrarySearchBox"
                                         Style="{StaticResource TextFieldStyle}"
                                         Margin="0"
                                         MinWidth="280"
                                         VerticalAlignment="Center"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Search games…"/>
                            </DockPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ListBox Grid.Column="0"
                                         ItemsSource="{Binding Collections}"
                                         SelectedItem="{Binding SelectedCollection}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="LaneChip"
                                                    MinWidth="104"
                                                    Padding="12,8"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                    Background="{DynamicResource ThemePillFillBrush}"
                                                    BorderBrush="{DynamicResource ThemePillBorderBrush}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock x:Name="LaneTitle"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="{Binding Title}" ToolTip="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="{DynamicResource FontSizeCaption}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Text="{Binding Count, StringFormat={}{0} titles}"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                             Value="True">
                                                    <Setter TargetName="LaneChip" Property="Background" Value="{DynamicResource ThemePillSelectedFillBrush}"/>
                                                    <Setter TargetName="LaneChip" Property="BorderBrush" Value="{DynamicResource ThemePillSelectedBorderBrush}"/>
                                                    <Setter TargetName="LaneTitle" Property="Foreground" Value="{DynamicResource ThemePillLabelActiveBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <WrapPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsLibraryToolsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ComboBox Style="{StaticResource ComboFieldStyle}"
                                              Width="160" Margin="0,0,8,0"
                                              ItemsSource="{Binding PlatformFilters}"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedPlatformFilterKey}"/>
                                    <ComboBox Style="{StaticResource ComboFieldStyle}"
                                              Width="172" Margin="0,0,8,0"
                                              ItemsSource="{Binding AchievementFilters}"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedAchievementFilterKey}"
                                              ToolTip="'Finish it' surfaces games 70%+ complete that have gone cold for 30+ days"/>
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="PickRandomFilteredGameClick"
                                            Content="Pick For Me"/>
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="ClearFiltersClick"
                                            Content="Reset"/>
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Margin="0"
                                            Click="CleanMissingLibraryClick"
                                            Content="Clean Missing Games"/>
                                </WrapPanel>
                            </Grid>

                            <!-- Persistent filter summary — visible whenever filters are active, not just on zero results,
                                 and stays visible even if the filter tools row above is collapsed. -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasActiveLibraryFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource BerryBrush}"
                                           Text="&#xE71C;"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding ActiveFilterSummary}"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Padding="6,1" Margin="8,0,0,0"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Click="ClearFiltersClick"
                                        Content="Clear"/>
                            </StackPanel>

                            <!-- Duplicate Ownership Detector banner — visible whenever CloudBerry sees an unresolved
                                 possible duplicate, independent of active filters or the tools row's expanded state. -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasPotentialDuplicates, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource GoldBrush}"
                                           Text="&#xE71B;"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding PotentialDuplicateSummary}"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Padding="6,1" Margin="8,0,0,0"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Click="ReviewDuplicatesClick"
                                        Content="Review"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsLibraryToolsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Presets" FontFamily="{DynamicResource ThemeBodyFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ListBox ItemsSource="{Binding LibraryFilterPresets}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         Visibility="{Binding HasLibraryFilterPresets, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                    Background="{DynamicResource ThemePillFillBrush}"
                                                    BorderBrush="{DynamicResource ThemePillBorderBrush}"
                                                    BorderThickness="1" Padding="10,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                                               FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" Cursor="Hand"
                                                               MouseLeftButtonUp="ApplyFilterPresetClick"
                                                               ToolTip="{Binding Summary}"/>
                                                    <TextBlock Text="✕" Margin="8,0,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center" Cursor="Hand"
                                                               MouseLeftButtonUp="DeleteFilterPresetClick"
                                                               ToolTip="Delete this preset"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBox x:Name="NewFilterPresetNameBox" Style="{StaticResource TextFieldStyle}"
                                         Width="140" Margin="4,0,6,0" Tag="Preset name…"
                                         KeyDown="NewFilterPresetNameBoxKeyDown"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Click="SaveFilterPresetClick" Content="Save Preset"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasLibraryBulkSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                        Background="{DynamicResource ThemePillFillBrush}"
                                        BorderBrush="{DynamicResource BerryBrush}"
                                        BorderThickness="1" Padding="10,5" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding LibraryBulkSelectionSummary}" FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                               FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BerryBrush}"/>
                                </Border>
                                <TextBlock Text="Ctrl/Shift-click games to select more." FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Click="BulkFavoriteClick" Content="Favorite" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Click="BulkUnfavoriteClick" Content="Unfavorite" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Click="BulkMarkCompletedClick" Content="Mark Completed" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Click="BulkMarkUnplayedClick" Content="Mark Unplayed" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Click="BulkRemoveClick" Content="Remove" Foreground="{DynamicResource GoldBrush}" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Click="BulkClearSelectionClick" Content="Clear Selection"/>
                            </StackPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource LibrarySignalTileStyle}"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="LIBRARY"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding TotalGames, StringFormat={}{0} titles}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource LibrarySignalTileStyle}"
                                        BorderBrush="{DynamicResource BerryBrush}"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="METADATA"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   Foreground="{DynamicResource BerryBrush}"
                                                   Text="{Binding MissingMetadataCount, StringFormat={}{0} missing}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0"
                                        Grid.Column="2"
                                        Style="{StaticResource LibrarySignalTileStyle}"
                                        BorderBrush="{DynamicResource GoldBrush}"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ACHIEVEMENTS"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   Foreground="{DynamicResource GoldBrush}"
                                                   Text="{Binding GamesWithAchievementsCount, StringFormat={}{0} ready}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource LibrarySignalTileBusyStyle}"
                                        Visibility="{Binding IsMetadataBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CloudBrush}"
                                                   Text="Metadata sweep in progress"/>
                                        <ProgressBar DockPanel.Dock="Right"
                                                     Style="{StaticResource BusyBarStyle}"
                                                     Width="120"
                                                     Margin="10,0,0,0"/>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Row="1"
                                        Grid.Column="2"
                                        Style="{StaticResource LibrarySignalTileBusyStyle}"
                                        Visibility="{Binding IsAchievementBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CloudBrush}"
                                                   Text="Achievement sync in progress"/>
                                        <ProgressBar DockPanel.Dock="Right"
                                                     Style="{StaticResource BusyBarStyle}"
                                                     Width="100"
                                                     Margin="8,0,0,0"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Content (inner tab control) -->
                        <TabControl Grid.Row="1"
                                    SelectedIndex="{Binding SelectedWorkspaceTab}"
                                    Style="{StaticResource InvisibleTabControlStyle}"
                                    SelectionChanged="OnTabControlSelectionChanged">

                            <!-- Browse view -->
                            <TabItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Left: game list -->
                                        <ColumnDefinition x:Name="LibraryRailColumn" Width="340" MinWidth="280" MaxWidth="540"/>
                                        <ColumnDefinition Width="8"/>
                                        <!-- Right: game detail -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT: Game list -->
                                    <Grid Grid.Column="0" Background="{DynamicResource ThemePanelFillSoftBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition x:Name="LibraryCollectionRow" Height="94" MinHeight="56" MaxHeight="240"/>   <!-- Collection filter -->
                                            <RowDefinition Height="8"/>      <!-- Resizer -->
                                            <RowDefinition Height="*"/>      <!-- Game list -->
                                        </Grid.RowDefinitions>
<effects:ThemeEffectLayer Grid.RowSpan="3"
                                                                  ThemeKey="{Binding AppearanceThemeKey}"
                                                                  EffectRole="Sidebar"
                                                                  Intensity="{Binding EffectiveVisualEffectIntensity}"
                                                                  Quality="{Binding EffectsQuality}"
                                      IsEffectActive="{Binding VisualEffectsEnabled}"
                                                                  Opacity="0.18"
                                                                  IsHitTestVisible="False"/>

                                        <!-- Library navigation -->
                                        <Border Grid.Row="0"
                                                Background="{DynamicResource ThemePanelFillSoftBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,8,10,6">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                               Text="LIBRARY"/>
                                                    <ListBox ItemsSource="{Binding Collections}"
                                                             SelectedItem="{Binding SelectedCollection}"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             Padding="0"
                                                             Margin="0,5,0,0">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Padding" Value="0"/>
                                                                <Setter Property="Margin" Value="0,0,0,1"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="CollectionNode"
                                                                        Padding="8,5,8,5"
                                                                        CornerRadius="{DynamicResource ThemeCornerRadiusControl}">
                                                                    <Border.Triggers>
                                                                        <EventTrigger RoutedEvent="Border.MouseEnter">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="CollNodeHoverBg"
                                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                                     To="1" Duration="0:0:0.12"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                        <EventTrigger RoutedEvent="Border.MouseLeave">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="CollNodeHoverBg"
                                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                                     To="0" Duration="0:0:0.18"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </Border.Triggers>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="14"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border x:Name="CollNodeHoverBg"
                                                                                Grid.ColumnSpan="4"
                                                                                Background="{DynamicResource ThemeNavItemHoverBackgroundBrush}"
                                                                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                                                Opacity="0"/>
                                                                        <Border x:Name="CollNodeAccent"
                                                                                Width="2"
                                                                                Opacity="0"
                                                                                HorizontalAlignment="Left"
                                                                                Background="{DynamicResource BerryBrush}">
                                                                            <Border.Effect>
                                                                                <DropShadowEffect Color="{DynamicResource ThemePanelShadowColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                                                            </Border.Effect>
                                                                        </Border>
                                                                        <TextBlock x:Name="CollNodeGlyph"
                                                                                   Grid.Column="0"
                                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                   Text="{Binding MenuGlyph}"
                                                                                   VerticalAlignment="Center"/>
                                                                        <TextBlock x:Name="CollNodeLabel"
                                                                                   Grid.Column="1"
                                                                                   FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                   Text="{Binding Title}" ToolTip="{Binding Title}"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <Border Grid.Column="2"
                                                                        Padding="6,1"
                                                                        Margin="8,0,0,0"
                                                                        Background="{DynamicResource SurfaceHighBrush}"
                                                                        CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                                                        VerticalAlignment="Center">
                                                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                                            Text="{Binding Count}"/>
                                                                            </Border>
                                                                            <Button x:Name="CollNodeEditButton"
                                                                                    Grid.Column="3"
                                                                                    Style="{StaticResource GhostButtonStyle}"
                                                                                    Padding="4,2" Margin="4,0,0,0"
                                                                                    VerticalAlignment="Center"
                                                                                    Click="EditCollectionClick"
                                                                                    ToolTip="Edit collection">
                                                                                <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="{DynamicResource FontSizeCaption}" Text="&#xE70F;"/>
                                                                            </Button>
                                                                            </Grid>
                                                                        </Border>
                                                                        <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNested}" Value="True">
                                                                        <Setter TargetName="CollectionNode" Property="Padding" Value="18,4,8,4"/>
                                                                        <Setter TargetName="CollNodeLabel" Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
                                                                        <Setter TargetName="CollNodeLabel" Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsMenuHeader}" Value="True">
                                                                        <Setter TargetName="CollNodeLabel" Property="FontWeight" Value="Bold"/>
                                                                        <Setter TargetName="CollNodeGlyph" Property="Foreground" Value="{DynamicResource BerryBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding CollectionId}" Value="">
                                                                        <Setter TargetName="CollNodeEditButton" Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                        <Setter TargetName="CollectionNode" Property="Background" Value="{DynamicResource ThemeNavItemSelectedBackgroundBrush}"/>
                                                                        <Setter TargetName="CollectionNode" Property="BorderBrush" Value="{DynamicResource ThemeNavItemSelectedBorderBrush}"/>
                                                                        <Setter TargetName="CollectionNode" Property="BorderThickness" Value="1"/>
                                                                        <Setter TargetName="CollNodeLabel" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                        <Setter TargetName="CollNodeAccent" Property="Opacity" Value="1"/>
                                                                        </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>

                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>

                                        <GridSplitter Grid.Row="1"
                                                      Style="{StaticResource HorizontalResizeGripStyle}"
                                                      ResizeDirection="Rows"
                                                      ResizeBehavior="PreviousAndNext"/>

                                        <!-- Game list -->
                                        <ListBox x:Name="GameLibraryList"
                                        Grid.Row="2"
                                        ItemsSource="{Binding LibraryView}"
                                        SelectedItem="{Binding SelectedGame}"
                                        SelectionMode="Extended"
                                        SelectionChanged="LibrarySelectionChanged"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Padding="0,0,0,24"
                                        Visibility="{Binding IsLibraryListView, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        MouseDoubleClick="GameListDoubleClick"
                                        PreviewMouseRightButtonDown="GameListPreviewMouseRightButtonDown"
                                        ScrollViewer.CanContentScroll="True"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling"
                                        VirtualizingPanel.CacheLength="1.5"
                                        VirtualizingPanel.CacheLengthUnit="Page"
                                        VirtualizingPanel.ScrollUnit="Pixel">
                                        <ListBox.ContextMenu>
                                        <ContextMenu>
                                        <MenuItem Header="Launch" Click="LaunchSelectedGameClick"/>
                                        <MenuItem Header="Edit Metadata" Click="OpenSelectedGameMetadataWorkspaceClick"/>
                                        <MenuItem Header="Refresh Metadata" Click="RefreshSelectedGameMetadataClick"/>
                                        <MenuItem Header="Sync Achievements" Click="SyncSelectedAchievementsClick"/>
                                        <MenuItem Header="View Achievements" Click="OpenSelectedGameAchievementsPageClick"/>
                                        <Separator/>
                                        <MenuItem x:Name="AddToCollectionMenuList" Header="Add to Collection" SubmenuOpened="AddToCollectionSubmenuOpened"/>
                                        <Separator/>
                                        <MenuItem Header="Favorite Selected" Click="FavoriteSelectedGamesClick"/>
                                        <MenuItem Header="Unfavorite Selected" Click="UnfavoriteSelectedGamesClick"/>
                                        <MenuItem Header="Mark Installed" Click="MarkSelectedGamesInstalledClick"/>
                                        <MenuItem Header="Mark Not Installed" Click="MarkSelectedGamesNotInstalledClick"/>
                                        <Separator/>
                                        <MenuItem Header="Open Folder" Click="OpenSelectedGameFolderClick"/>
                                        <MenuItem Header="Remove Selected" Click="RemoveSelectedGamesClick"/>
                                        </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                        <DataTemplate>
                                        <!-- NieR:Automata item-list style flat row -->
                                        <Border x:Name="GameCard"
                                        Cursor="Hand"
                                        MinHeight="58"
                                                 CornerRadius="0"
                                                BorderThickness="0,0,0,1"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Border.MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="GameCardHoverOverlay"
                                                                            Storyboard.TargetProperty="Opacity"
                                                                            To="1" Duration="0:0:0.08"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="Border.MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="GameCardHoverOverlay"
                                                                            Storyboard.TargetProperty="Opacity"
                                                                            To="0" Duration="0:0:0.08"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Grid>
                                                <!-- A2: theme-safe hover overlay (was literal-Color animation on GameCardBg; now DynamicResource opacity overlay so all 9 themes repaint correctly) -->
                                                <Border x:Name="GameCardHoverOverlay"
                                                        Background="{DynamicResource CardHoverBrush}"
                                                        Opacity="0"
                                                        IsHitTestVisible="False"/>
                                                <!-- NieR cursor — selection indicator, hidden until row is selected -->
                                                <TextBlock x:Name="GameCursor"
                                                           Text="&#x25B6;"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           Foreground="{DynamicResource TextOnDarkBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Margin="4,0,0,0"
                                                           Opacity="0"/>
                                                <Grid Margin="18,0,10,0">
                                                <Grid.ColumnDefinitions>
                                                <!-- mini cover thumbnail -->
                                                <ColumnDefinition Width="42"/>
                                                <!-- ◆ symbol -->
                                                <ColumnDefinition Width="0"/>
                                                <!-- title + last-played sub-label -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- platform label -->
                                                <ColumnDefinition Width="0"/>
                                                    <!-- indicators: ROM + ★ fav -->
                                                                                                        <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Mini cover art, clipped, falls back to tinted bg. Bumped up from the old
                                                     28x38 so it actually reads as a thumbnail at a glance instead of a smudge. -->
                                                <Border Grid.Column="0"
                                                Width="36" Height="48"
                                                CornerRadius="3"
                                                ClipToBounds="True"
                                                VerticalAlignment="Center"
                                                                                                            Margin="0,4,0,4"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1">
                                                <Image Stretch="UniformToFill"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Source="{Binding DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                                                </Border>

                                                <!-- ◆ item-type glyph — NieR inventory icon -->
                                                                                                    <TextBlock x:Name="GameSymbol"
                                                           Visibility="Collapsed"
                                                           Grid.Column="1"
                                                           Text="&#x25C6;"
                                                FontSize="{DynamicResource FontSizeCaption}"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>

                                                <!-- Title + last-played sub-label — title bumped a full step so it's the
                                                     clear visual anchor of the row instead of matching-size body text. -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,1,0,1">
                                                                                                        <TextBlock x:Name="GameTitle"
                                                               FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                                               FontSize="{DynamicResource FontSizeBodyLarge}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding Title}" ToolTip="{Binding Title}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="GamePlatform" FontSize="{DynamicResource FontSizeCaption}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Platform, Mode=OneWay}"/><Run Text="  /  "/><Run Text="{Binding SourceBadgeLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock x:Name="GameLastPlayed"
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding LastPlayedLabelShort}"
                                                Visibility="Collapsed"
                                                               Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                     <!-- Indicators: source badge + launch readiness + ★ favorite -->
                                                     <StackPanel Grid.Column="4"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalAlignment="Center"
                                                                 Margin="4,0,2,0">
                                                         <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                    Visibility="Collapsed"
                                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                                    FontWeight="Bold"
                                                                    HorizontalAlignment="Center"
                                                                    ToolTip="{Binding SourceBadgeLabel, StringFormat='Added via {0}'}"
                                                                    Text="{Binding SourceBadgeLabel}"/>
                                                         <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                                    FontSize="{DynamicResource FontSizeBody}"
                                                                    HorizontalAlignment="Center"
                                                                    Foreground="{DynamicResource GoldBrush}"
                                                                    Visibility="{Binding NeedsLaunchAttention, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Text="&#xE7BA;"
                                                                    Margin="0,2,0,0"
                                                                    ToolTip="{Binding LaunchReadinessLabel}"/>
                                                         <TextBlock x:Name="GameFavStar"
                                                                    FontSize="{DynamicResource FontSizeBody}"
                                                                    HorizontalAlignment="Center"
                                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                                    Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Text="&#x2605;"
                                                                    Margin="0,2,0,0"
                                                                    ToolTip="Favorite"/>
                                                     </StackPanel>
                                                 </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="GameCard"       Property="Background"   Value="{DynamicResource CardSelectedBrush}"/>
                                        <Setter TargetName="GameCard"       Property="BorderBrush"  Value="{DynamicResource BerryBrush}"/>
                                        <Setter TargetName="GameTitle"      Property="Foreground"   Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter TargetName="GameTitle"      Property="FontWeight"   Value="SemiBold"/>
                                        <Setter TargetName="GameSymbol"     Property="Foreground"   Value="{DynamicResource TextOnDarkBrush}"/>
                                        <Setter TargetName="GamePlatform"   Property="Foreground"   Value="{DynamicResource TextSecondaryBrush}"/>
                                         <Setter TargetName="GameLastPlayed" Property="Foreground"   Value="{DynamicResource TextOnDarkBrush}"/>
                                         <Setter TargetName="GameLastPlayed" Property="Opacity"      Value="0.62"/>
                                            <Setter TargetName="GameFavStar"    Property="Foreground"   Value="{DynamicResource GoldBrush}"/>
                                            <Setter TargetName="GameCursor"     Property="Opacity"      Value="1"/>
                                            <Setter TargetName="GameCursor"     Property="Foreground"   Value="{DynamicResource BerryBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter TargetName="GameFavStar" Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                            </DataTrigger>
                                             <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsKeyboardFocusWithin}" Value="True">
                                                 <Setter TargetName="GameCard" Property="BorderBrush"    Value="{DynamicResource GoldBrush}"/>
                                                 <Setter TargetName="GameCard" Property="BorderThickness" Value="0,0,0,2"/>
                                             </DataTrigger>
                                         </DataTemplate.Triggers>
                                        </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Cover Grid view (Playnite/GOG-Galaxy-style tile browsing) -->
                                        <ListBox x:Name="GameLibraryGridList"
                                        Grid.Row="2"
                                        ItemsSource="{Binding LibraryView}"
                                        SelectedItem="{Binding SelectedGame}"
                                        SelectionMode="Extended"
                                        SelectionChanged="LibrarySelectionChanged"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Padding="20,16,20,24"
                                        Visibility="{Binding IsLibraryGridView, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        MouseDoubleClick="GameListDoubleClick"
                                        PreviewMouseRightButtonDown="GameListPreviewMouseRightButtonDown"
                                        ScrollViewer.CanContentScroll="False"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ContextMenu>
                                        <ContextMenu>
                                        <MenuItem Header="Launch" Click="LaunchSelectedGameClick"/>
                                        <MenuItem Header="Edit Metadata" Click="OpenSelectedGameMetadataWorkspaceClick"/>
                                        <MenuItem Header="Refresh Metadata" Click="RefreshSelectedGameMetadataClick"/>
                                        <MenuItem Header="Sync Achievements" Click="SyncSelectedAchievementsClick"/>
                                        <MenuItem Header="View Achievements" Click="OpenSelectedGameAchievementsPageClick"/>
                                        <Separator/>
                                        <MenuItem x:Name="AddToCollectionGridMenuList" Header="Add to Collection" SubmenuOpened="AddToCollectionSubmenuOpened"/>
                                        <Separator/>
                                        <MenuItem Header="Favorite Selected" Click="FavoriteSelectedGamesClick"/>
                                        <MenuItem Header="Unfavorite Selected" Click="UnfavoriteSelectedGamesClick"/>
                                        <MenuItem Header="Mark Installed" Click="MarkSelectedGamesInstalledClick"/>
                                        <MenuItem Header="Mark Not Installed" Click="MarkSelectedGamesNotInstalledClick"/>
                                        <Separator/>
                                        <MenuItem Header="Open Folder" Click="OpenSelectedGameFolderClick"/>
                                        <MenuItem Header="Remove Selected" Click="RemoveSelectedGamesClick"/>
                                        </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,14,14"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Width" Value="{Binding DataContext.LibraryGridCardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                        <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                        </ControlTemplate>
                                        </Setter.Value>
                                        </Setter>
                                        </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                        <DataTemplate>
                                        <Border x:Name="GridCard"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1">
                                        <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.MouseEnter">
                                        <BeginStoryboard>
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GridCardHoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                                        </Storyboard>
                                        </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Border.MouseLeave">
                                        <BeginStoryboard>
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GridCardHoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08"/>
                                        </Storyboard>
                                        </BeginStoryboard>
                                        </EventTrigger>
                                        </Border.Triggers>
                                        <StackPanel>
                                        <Border CornerRadius="{DynamicResource ThemeCornerRadiusControl}" ClipToBounds="True">
                                        <Grid Height="{Binding DataContext.LibraryGridCoverHeight, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <Border Background="{DynamicResource SurfaceBrush}"/>
                                        <Image Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                                                            <Border x:Name="GridCardHoverOverlay" Background="{DynamicResource ArtworkHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
                                        <!-- Running dot -->
                                        <Border Width="9" Height="9" CornerRadius="5"
                                        Background="{DynamicResource BerryBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <!-- Source badge (Manual / Steam / Launcher / ROM / Folder) -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                        Padding="6,2">
                                        <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource VisualFeaturePillStyle}">
                                        <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        </Style.Triggers>
                                        </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource ThemePillLabelActiveBrush}"
                                        Text="{Binding SourceBadgeLabel}"
                                        ToolTip="{Binding SourceBadgeLabel, StringFormat='Added via {0}'}"/>
                                        </Border>
                                        <!-- Launch readiness + favorite badges -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                        <Border Background="{DynamicResource GoldDimBrush}"
                                        BorderBrush="{DynamicResource GoldBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                        Padding="5,1" Margin="0,0,4,0"
                                        Visibility="{Binding NeedsLaunchAttention, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="{Binding LaunchReadinessLabel}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Foreground="{DynamicResource GoldBrush}"
                                        Text="&#xE7BA;"/>
                                        </Border>
                                        <TextBlock x:Name="GridFavStar"
                                        FontSize="{DynamicResource FontSizeBody}" Margin="0,0,0,0"
                                        Foreground="{DynamicResource GoldBrush}"
                                        Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Text="&#x2605;"/>
                                        </StackPanel>
                                        <!-- Achievement completion sliver -->
                                        <ProgressBar Style="{StaticResource AchievementProgressBarStyle}"
                                        VerticalAlignment="Bottom" Height="3" BorderThickness="0"
                                        Value="{Binding AchievementCompletionPercent, Mode=OneWay}"
                                        Maximum="100"
                                        Visibility="{Binding HasAchievements, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                        </Border>
                                        <StackPanel Margin="2,7,2,2">
                                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}"
                                        FontFamily="{DynamicResource ThemeBodyFontFamily}"
                                        FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Platform}" ToolTip="{Binding Platform}"
                                        FontSize="{DynamicResource FontSizeCaption}" Margin="0,2,0,0"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="GridCard" Property="BorderBrush" Value="{DynamicResource BerryBrush}"/>
                                        <Setter TargetName="GridCard" Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter TargetName="GridFavStar" Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                        </DataTrigger>
                                        </DataTemplate.Triggers>
                                        </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Grid.Row="2"
                                                Background="Transparent"
                                                Visibility="{Binding HasNoFilterMatches, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Padding="20,18"
                                                    Style="{StaticResource InsetCardStyle}">
                                                <StackPanel Width="230">
                                                    <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                               FontSize="{DynamicResource FontSizeHeading}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Text="No games match those filters"
                                                               TextAlignment="Center"/>
                                                    <TextBlock Margin="0,8,0,14"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Text="{Binding ActiveFilterSummary}"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap"/>
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Click="ClearFiltersClick"
                                                            Content="Clear Filters"/>
                                                </StackPanel>
                                            </Border>
                                        </Border>

                                        <Border Grid.Row="2"
                                                Background="Transparent"
                                                Visibility="{Binding IsLibraryTrulyEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Padding="24,22"
                                                    Style="{StaticResource InsetCardStyle}">
                                                <StackPanel Width="260">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                               FontSize="{DynamicResource FontSizeStatLarge}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,6"
                                                               Text="&#xE8F1;"/>
                                                    <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                               FontSize="{DynamicResource FontSizeHeading}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Text="Your library is empty"
                                                               TextAlignment="Center"/>
                                                    <TextBlock Margin="0,8,0,14"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Text="Scan a games folder to pull in a library, or add one game manually if you want to try the flow first."
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap"/>
                                                    <StackPanel>
                                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                                Click="ScanFolderClick"
                                                                Content="Scan Games Folder"/>
                                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                                Margin="0,8,0,0"
                                                                Click="QuickAddClick"
                                                                Content="Add One Game Manually"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </Grid>

                                    <!-- Column separator -->
                                    <Border Grid.Column="1"
                                            Width="1"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderSubtleBrush}"/>
                                    <GridSplitter Grid.Column="1"
                                                  Style="{StaticResource VerticalResizeGripStyle}"
                                                  ResizeDirection="Columns"
                                                  ResizeBehavior="PreviousAndNext"/>

                                    <!-- Game detail panel -->
                                    <Grid Grid.Column="2"
                                          Background="{DynamicResource ThemePanelFillSoftBrush}">
                                        <controls:CrossfadeImage Stretch="UniformToFill"
                                                                 Opacity="0.22"
                                                                 CacheMode="BitmapCache"
                                                                 Source="{Binding SelectedGame.DisplayBackgroundImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=background}"/>
                                                                 <Rectangle IsHitTestVisible="False"
                                                   Fill="{DynamicResource ThemeShellAtmosphereBrush}"
                                                   Opacity="0.72"/>
                                        <Rectangle IsHitTestVisible="False"
                                                   Fill="{DynamicResource HeroOverlayBrush}"
                                                   Opacity="0.82"/>
                                        <Rectangle IsHitTestVisible="False"
                                                   Fill="{DynamicResource ThemeShellPatternBrush}"
                                                   Opacity="0.06"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      Background="Transparent">
                                        <StackPanel>

                                            <!-- ── Hero image zone (240px) ── -->
                                            <Border x:Name="LibraryHeroShell"
                                                    Height="340"
                                                    Margin="28,24,28,0"
                                                    ClipToBounds="True"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusLarge}">
                                                <Grid>
                                                    <!-- Background art -->
                                                    <Border Background="{DynamicResource ThemePanelFillSoftBrush}"/>
                                                    <controls:CrossfadeImage Stretch="UniformToFill"
                                                                             Opacity="0.84"
                                                                             Source="{Binding SelectedGame.DisplayBackgroundImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=background}"/>
                                                                             <!-- Gradient overlay -->
                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                <GradientStop Offset="0" Color="#E8120E08"/>
                                                                <GradientStop Offset="0.45" Color="#8A120E08"/>
                                                                <GradientStop Offset="1" Color="#C8120E08"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Offset="0" Color="#221A1410"/>
                                                                <GradientStop Offset="0.55" Color="#501A1410"/>
                                                                <GradientStop Offset="1" Color="#F81A1410"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>

                                                    <Grid Margin="40,34,40,34">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="220"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel MaxWidth="680"
                                                                    VerticalAlignment="Bottom">
                                                            <WrapPanel Margin="0,0,0,12">
                                                                <Border Style="{StaticResource VisualFeaturePillStyle}"
                                                                        Padding="10,4">
                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource ThemePillLabelActiveBrush}"
                                                                Text="{Binding SelectedGame.Platform, TargetNullValue='Select a game'}"/>
                                                                </Border>
                                                                <Border Style="{StaticResource VisualFeaturePillStyle}"
                                                                        Margin="8,0,0,0"
                                                                        Padding="10,4">
                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource ThemePillLabelBrush}"
                                                                Text="{Binding SelectedGame.ReleaseDateLabel}"/>
                                                                </Border>
                                                                <Border Style="{StaticResource GlassMetricChipStyle}"
                                                                        Margin="8,0,0,0"
                                                                        Padding="10,4"
                                                                        Visibility="{Binding SelectedGame.IsRom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource GoldBrush}"
                                                                               Text="ROM library"/>
                                                                </Border>
                                                            </WrapPanel>

                                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                       FontSize="{DynamicResource FontSizeDisplay}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextOnDarkBrush}"
                                                                       Text="{Binding SelectedGame.Title, TargetNullValue='Select a game'}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Margin="0,10,0,0"
                                                                       FontSize="{DynamicResource FontSizeBody}"
                                                                       Foreground="{DynamicResource TextOnDarkBrush}"
                                                                       Text="{Binding SelectedGame.Subtitle}"
                                                                       TextWrapping="Wrap"/>

													<WrapPanel Margin="0,22,0,0">
														<Button Style="{StaticResource PrimaryButtonStyle}"
																Click="LaunchSelectedGameClick"
																Padding="22,11" FontSize="{DynamicResource FontSizeBody}"
																Content="&#x25B6;&#x2002;Play"/>
													</WrapPanel>
													<StackPanel Margin="0,12,0,0" MaxWidth="560">
														<TextBlock FontSize="{DynamicResource FontSizeSmall}"
																   FontWeight="SemiBold"
																   Foreground="{DynamicResource TextOnDarkBrush}"
																   Text="{Binding SelectedLaunchReadinessLabel}"/>
														<TextBlock Margin="0,3,0,0"
																   FontSize="{DynamicResource FontSizeCaption}"
																   Foreground="{DynamicResource TextOnDarkBrush}"
																   Opacity="0.72"
																   TextWrapping="Wrap"
																   Text="{Binding SelectedLaunchReadinessDetail}"/>
													</StackPanel>
												</StackPanel>

                                                        <Border x:Name="LibraryHeroCoverShell"
                                                                Grid.Column="1"
                                                                Width="178"
                                                                Height="248"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                CornerRadius="{DynamicResource ThemeCornerRadiusLarge}"
                                                                Background="{DynamicResource SurfaceElevatedBrush}"
                                                                ClipToBounds="True"
                                                                BorderBrush="{DynamicResource ThemePanelBorderGradientBrush}"
                                                                BorderThickness="1">
                                                            <Grid>
                                                                <TextBlock Text="{Binding SelectedGame.Initials}"
                                                                           FontSize="{DynamicResource FontSizeStatLarge}"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                                <controls:CrossfadeImage Stretch="UniformToFill"
                                                                                         Source="{Binding SelectedGame.DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=hero}"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!-- ── Content body (cover hangs over top by 52px, so pad) ── -->
                                            <StackPanel Margin="40,28,40,0">

                                                <!-- Rating + genre pills -->
                                                <WrapPanel Margin="0,0,0,20">
                                                    <Border Padding="10,4" Margin="0,0,6,6"
                                                            Style="{StaticResource VisualFeaturePillStyle}"
                                                            Visibility="{Binding SelectedGame.HasCoverImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Text="{Binding SelectedGame.RatingLabel}"/>
                                                    </Border>
                                                    <Border Padding="10,4" Margin="0,0,6,6"
                                                            Style="{StaticResource VisualFeaturePillStyle}">
                                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Text="{Binding SelectedGame.ReleaseDateLabel}"/>
                                                    </Border>
                                                    <Border Padding="10,4" Margin="0,0,6,6"
                                                            Style="{StaticResource GlassMetricChipStyle}"
                                                            Visibility="{Binding SelectedGame.HasAchievements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource GoldBrush}"
                                                                   Text="{Binding SelectedGame.AchievementSummary}"/>
                                                    </Border>
                                                    <!-- Gamer Score pill -->
                                                    <Border Padding="10,4" Margin="0,0,6,6"
                                                            Style="{StaticResource GlassMetricChipStyle}"
                                                            Visibility="{Binding SelectedGame.HasAchievements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource GoldBrush}"
                                                                   Text="{Binding SelectedGame.GamerScoreLabel}"/>
                                                    </Border>
                                                    <!-- ROM indicator pill -->
                                                    <Border Padding="10,4" Margin="0,0,6,6"
                                                            Style="{StaticResource VisualFeaturePillStyle}"
                                                            Visibility="{Binding SelectedGame.IsRom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BerryBrush}"
                                                                   Text="ROM — Emulated"/>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Star Ratings -->
                                                <Grid Margin="0,0,0,20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- User rating -->
                                                    <Border Grid.Column="0"
                                                            Style="{StaticResource FeatureDetailCardStyle}"
                                                            Padding="14,10">
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="YOUR RATING"/>
                                                            <WrapPanel Margin="0,6,0,4">
                                                                <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,4,0" Padding="4,2" FontSize="{DynamicResource FontSizeHeading}"
                                                                        Foreground="{DynamicResource GoldBrush}" Click="RateStar1Click" ToolTip="Rate 1 star"
                                                                        Content="{Binding SelectedGame.UserRatingStars, Converter={StaticResource StarFillConverter}, ConverterParameter=1}"/>
                                                                <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,4,0" Padding="4,2" FontSize="{DynamicResource FontSizeHeading}"
                                                                        Foreground="{DynamicResource GoldBrush}" Click="RateStar2Click" ToolTip="Rate 2 stars"
                                                                        Content="{Binding SelectedGame.UserRatingStars, Converter={StaticResource StarFillConverter}, ConverterParameter=2}"/>
                                                                <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,4,0" Padding="4,2" FontSize="{DynamicResource FontSizeHeading}"
                                                                        Foreground="{DynamicResource GoldBrush}" Click="RateStar3Click" ToolTip="Rate 3 stars"
                                                                        Content="{Binding SelectedGame.UserRatingStars, Converter={StaticResource StarFillConverter}, ConverterParameter=3}"/>
                                                                <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,4,0" Padding="4,2" FontSize="{DynamicResource FontSizeHeading}"
                                                                        Foreground="{DynamicResource GoldBrush}" Click="RateStar4Click" ToolTip="Rate 4 stars"
                                                                        Content="{Binding SelectedGame.UserRatingStars, Converter={StaticResource StarFillConverter}, ConverterParameter=4}"/>
                                                                <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,4,0" Padding="4,2" FontSize="{DynamicResource FontSizeHeading}"
                                                                        Foreground="{DynamicResource GoldBrush}" Click="RateStar5Click" ToolTip="Rate 5 stars"
                                                                        Content="{Binding SelectedGame.UserRatingStars, Converter={StaticResource StarFillConverter}, ConverterParameter=5}"/>
                                                                <Button Style="{StaticResource GhostButtonStyle}" Margin="0" Padding="4,2" FontSize="{DynamicResource FontSizeCaption}"
                                                                        Foreground="{DynamicResource TextMutedBrush}" Click="RateClearClick" ToolTip="Clear your rating" Content="Clear"/>
                                                            </WrapPanel>
                                                            <TextBlock FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}"
                                                                       Text="{Binding SelectedGame.UserRatingLabel, TargetNullValue='Not rated yet'}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Critic rating -->
                                                    <Border Grid.Column="2"
                                                            Style="{StaticResource FeatureDetailCardStyle}"
                                                            Padding="14,10">
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CRITIC RATING"/>
                                                            <TextBlock Margin="0,8,0,4"
                                                                       FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeHeading}"
                                                                       Foreground="{DynamicResource GoldBrush}"
                                                                       Text="{Binding SelectedGame.CriticRatingStars, StringFormat={}{0:0.0} / 5, TargetNullValue='—'}"/>
                                                            <TextBlock FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}"
                                                                       Text="{Binding SelectedGame.CriticRatingLabel, TargetNullValue='No critic score yet'}"/>
                                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                                                                       Text="Sourced from metadata provider on last sync"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Return-to-game marker -->
                                                <Border Margin="0,0,0,20"
                                                        Style="{StaticResource FeatureDetailCardStyle}"
                                                        Padding="16,14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,8">
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Margin="12,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           Text="{Binding SelectedGame.NextTimeUpdatedLabel}"/>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Margin="0,0,8,0"
                                                                               FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                                               FontSize="14"
                                                                               Foreground="{DynamicResource CloudBrush}"
                                                                               Text="&#xE70B;"/>
                                                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                                               Margin="0"
                                                                               Text="NEXT TIME"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <TextBox x:Name="SelectedNextTimeNoteBox"
                                                                     MinHeight="68"
                                                                     MaxHeight="104"
                                                                     MaxLength="360"
                                                                     Padding="12,10"
                                                                     AcceptsReturn="True"
                                                                     TextWrapping="Wrap"
                                                                     VerticalScrollBarVisibility="Auto"
                                                                     Style="{StaticResource TextFieldStyle}"
                                                                     Text="{Binding SelectedGame.NextTimeNote, UpdateSourceTrigger=Explicit}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="12,26,0,0"
                                                                    VerticalAlignment="Top">
                                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                                    Margin="0,0,0,6"
                                                                    Padding="14,8"
                                                                    Click="SaveNextTimeNoteClick"
                                                                    Content="Save Marker"/>
                                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                                    Margin="0"
                                                                    Padding="14,8"
                                                                    IsEnabled="{Binding SelectedGame.HasNextTimeNote}"
                                                                    Click="ClearNextTimeNoteClick"
                                                                    Content="Clear"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Preserved manuals and strategy guides -->
                                                <Border Margin="0,0,0,20"
                                                        Style="{StaticResource FeatureDetailCardStyle}"
                                                        Padding="16,14">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,10">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                                        Padding="12,7" Margin="0,0,6,0"
                                                                        Click="AddLocalGuidebookClick"
                                                                        Content="Add PDF"/>
                                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                        Padding="12,7" Margin="0"
                                                                        IsEnabled="{Binding IsGuidebookBusy, Converter={StaticResource InverseBooleanConverter}}"
                                                                        Click="DiscoverGuidebooksClick"
                                                                        Content="Discover Guides"/>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Margin="0,0,8,0"
                                                                               FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                                               FontSize="15" Foreground="{DynamicResource CloudBrush}"
                                                                               Text="&#xE8A5;"/>
                                                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0"
                                                                               Text="GUIDES &amp; MANUALS"/>
                                                                    <TextBlock Margin="9,0,0,0" FontSize="10"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               Text="{Binding SelectedGame.GuidebookCountLabel}"/>
                                                                </StackPanel>
                                                                <TextBlock Margin="0,5,0,0" FontSize="11"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           Text="Original PDF pages, preserved without reflow."/>
                                                            </StackPanel>
                                                        </DockPanel>

                                                        <ProgressBar Height="2" Margin="0,0,0,10" IsIndeterminate="True"
                                                                     Visibility="{Binding IsGuidebookBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                        <ItemsControl ItemsSource="{Binding SelectedGame.Guidebooks}"
                                                                      Visibility="{Binding SelectedGame.HasGuidebooks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,6" Padding="10,8"
                                                                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                                            Background="{DynamicResource GlassChipFillBrush}"
                                                                            BorderBrush="{DynamicResource GlassChipBorderBrush}" BorderThickness="1">
                                                                        <DockPanel>
                                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                                <Button Style="{StaticResource GhostButtonStyle}" Padding="11,6" Margin="0,0,5,0"
                                                                                        Click="OpenGuidebookClick" Content="Read"/>
                                                                                <Button Style="{StaticResource GhostButtonStyle}" Padding="9,6" Margin="0"
                                                                                        Click="RemoveGuidebookClick" ToolTip="Remove from this game" Content="&#xE711;"/>
                                                                            </StackPanel>
                                                                            <StackPanel Margin="0,0,12,0">
                                                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                           Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Margin="0,2,0,0" FontSize="10"
                                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                                           Text="{Binding DiscoveryLabel}"/>
                                                                            </StackPanel>
                                                                        </DockPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <ItemsControl ItemsSource="{Binding GuidebookSearchResults}"
                                                                      Visibility="{Binding HasGuidebookSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,6" Padding="10,8"
                                                                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                                            Background="{DynamicResource GlassChipActiveFillBrush}"
                                                                            BorderBrush="{DynamicResource GlassButtonBorderBrush}" BorderThickness="1">
                                                                        <DockPanel>
                                                                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"
                                                                                    Padding="11,6" Margin="10,0,0,0"
                                                                                    Click="AttachDiscoveredGuidebookClick" Content="Attach"/>
                                                                            <StackPanel>
                                                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                           Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Margin="0,2,0,0" FontSize="10"
                                                                                           Foreground="{DynamicResource CloudBrush}"
                                                                                           Text="{Binding DiscoveryLabel}"/>
                                                                            </StackPanel>
                                                                        </DockPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock Margin="0,4,0,0" FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextWrapping="Wrap" Text="{Binding GuidebookStatusMessage}"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Action buttons -->
                                                <Border Margin="0,0,0,20"
                                                        Style="{StaticResource FeatureDetailCardStyle}"
                                                        Padding="14,10">
                                                    <DockPanel>
                                                        <!-- Remove isolated on far right — destructive, kept away from everything else -->
                                                        <Button DockPanel.Dock="Right"
                                                                Style="{StaticResource DangerButtonStyle}"
                                                                Margin="0" Click="RemoveSelectedGamesClick"
                                                                Content="Remove Selected"/>
                                                        <!-- Save right of center -->
                                                        <Button DockPanel.Dock="Right"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Margin="0,0,10,0"
                                                                Click="SaveSelectedGameClick"
                                                                Content="Save"/>
                                                        <!-- Everything else that isn't already the hero Play button, left-aligned -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                                    Click="SearchSelectedGameMetadataClick"
                                                                    Content="Edit Metadata"/>
                                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                                    Padding="9,7" Margin="0,0,4,0"
                                                                    Click="RefreshSelectedGameMetadataClick"
                                                                    ToolTip="Re-fetch summary, artwork, and ratings for this game"
                                                                    Content="&#x21BB;"/>
                                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                                    Click="SyncSelectedAchievementsClick"
                                                                    Content="Achievements"/>
                                                            <Button Padding="9,7" Margin="0,0,4,0"
                                                                    Click="ToggleFavoriteClick"
                                                                    ToolTip="Favorite"
                                                                    Content="&#x2605;">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SelectedGame.IsFavorite}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                                    Margin="0"
                                                                    Click="OpenSelectedGameFolderClick"
                                                                    Content="Open Folder"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Left-inset section: description + edit fields -->
                                            <StackPanel Margin="28,0,28,0">

                                                <!-- No-metadata state: only the games that actually need it get a real, actionable
                                                     call-out instead of just quietly showing placeholder text further down. -->
                                                <Border Margin="0,0,0,16"
                                                        Style="{StaticResource FeatureDetailCardStyle}"
                                                        Padding="14,10"
                                                        BorderBrush="{DynamicResource GoldBrush}"
                                                        Visibility="{Binding SelectedGame.NeedsMetadataRefresh, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <DockPanel LastChildFill="False">
                                                        <StackPanel DockPanel.Dock="Left">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                                       Foreground="{DynamicResource GoldBrush}"
                                                                       Text="&#xE946;&#x2002;NO METADATA YET"/>
                                                            <TextBlock Margin="0,6,0,0"
                                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Text="This game is missing a summary, cover, or background. Download metadata to fill it in automatically, or fill it in yourself below."/>
                                                        </StackPanel>
                                                        <Button DockPanel.Dock="Right"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                VerticalAlignment="Center"
                                                                Padding="9,7"
                                                                Click="SearchSelectedGameMetadataClick"
                                                                ToolTip="Search for and download metadata for this game"
                                                                Content="Download Metadata"/>
                                                    </DockPanel>
                                                </Border>

                                                <!-- Description -->
                                                <TextBlock Margin="0,0,0,20"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                TextWrapping="Wrap" FontSize="{DynamicResource FontSizeBody}" LineHeight="20"
                                                Text="{Binding SelectedGame.SummaryOrPlaceholder}"/>

                                                 <!-- Playtime + Last Played stat cards -->
                                                 <Grid Margin="0,0,0,16">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="16"/>
                                                         <ColumnDefinition Width="*"/>
                                                     </Grid.ColumnDefinitions>
                                                     <Border Grid.Column="0"
                                                             Style="{StaticResource FeatureDetailCardStyle}"
                                                             Padding="14,10">
                                                         <StackPanel>
                                                             <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PLAYTIME"/>
                                                             <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                        FontSize="{DynamicResource FontSizeHeading}" Margin="0,4,0,2"
                                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                                        Text="{Binding SelectedGame.PlaytimeLabelShort, TargetNullValue='—'}"/>
                                                             <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                                        Text="{Binding SelectedGame.PlaytimeLabel}"/>
                                                         </StackPanel>
                                                     </Border>
                                                     <Border Grid.Column="2"
                                                             Style="{StaticResource FeatureDetailCardStyle}"
                                                             Padding="14,10">
                                                         <StackPanel>
                                                             <TextBlock Style="{StaticResource FieldLabelStyle}" Text="LAST PLAYED"/>
                                                             <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                        FontSize="{DynamicResource FontSizeHeading}" Margin="0,4,0,2"
                                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                                        Text="{Binding SelectedGame.LastPlayedLabelShort, TargetNullValue='—'}"/>
                                                             <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                                        Text="{Binding SelectedGame.LastPlayedLabel}"/>
                                                         </StackPanel>
                                                     </Border>
                                                 </Grid>

                                                 <!-- Backlog Debt: price paid + cost/hour (DIFFERENTIATORS.md #1) -->
                                                 <Grid Margin="0,0,0,16"
                                                       Visibility="{Binding SelectedGame.HasPurchasePrice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="16"/>
                                                         <ColumnDefinition Width="*"/>
                                                     </Grid.ColumnDefinitions>
                                                     <Border Grid.Column="0"
                                                             Style="{StaticResource FeatureDetailCardStyle}"
                                                             Padding="14,10">
                                                         <StackPanel>
                                                             <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PRICE PAID"/>
                                                             <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                        FontSize="{DynamicResource FontSizeHeading}" Margin="0,4,0,2"
                                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                                        Text="{Binding SelectedGame.PurchasePriceUsd, StringFormat={}${0:0.##}, TargetNullValue='—'}"/>
                                                             <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                                        Text="Set below under Price Paid (USD)"/>
                                                         </StackPanel>
                                                     </Border>
                                                     <Border Grid.Column="2"
                                                             Style="{StaticResource FeatureDetailCardStyle}"
                                                             Padding="14,10">
                                                         <StackPanel>
                                                             <TextBlock Style="{StaticResource FieldLabelStyle}" Text="COST / HOUR"/>
                                                             <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                        FontSize="{DynamicResource FontSizeHeading}" Margin="0,4,0,2"
                                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                                        Text="{Binding SelectedGame.CostPerHourLabel}"/>
                                                             <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                                        Text="Value so far"/>
                                                         </StackPanel>
                                                     </Border>
                                                 </Grid>

                                                 <!-- Genres pills (conditional) -->
                                                 <StackPanel Margin="0,0,0,16"
                                                             Visibility="{Binding SelectedGame.HasGenres, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                     <TextBlock Style="{StaticResource FieldLabelStyle}" Text="GENRES" Margin="0,0,0,8"/>
                                                     <ItemsControl ItemsSource="{Binding SelectedGame.GenreList}">
                                                         <ItemsControl.ItemsPanel>
                                                             <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                         </ItemsControl.ItemsPanel>
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate>
                                                                 <Border Padding="10,4" Margin="0,0,6,6"
                                                                         Style="{StaticResource VisualFeaturePillStyle}">
                                                                     <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                Text="{Binding}"/>
                                                                 </Border>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>
                                                 </StackPanel>

                                                 <!-- Developer / Publisher row -->
                                                 <Grid Margin="0,0,0,20">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="16"/>
                                                         <ColumnDefinition Width="*"/>
                                                     </Grid.ColumnDefinitions>
                                                     <Border Grid.Column="0"
                                                             Style="{StaticResource FeatureDetailCardStyle}">
                                                         <StackPanel>
                                                             <TextBlock Style="{StaticResource FieldLabelStyle}" Text="DEVELOPER"/>
                                                             <TextBlock FontSize="{DynamicResource FontSizeSmall}"
                                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                                        Text="{Binding SelectedGame.DevelopersLabel}"
                                                                        TextWrapping="Wrap"/>
                                                         </StackPanel>
                                                     </Border>
                                                     <Border Grid.Column="2"
                                                             Style="{StaticResource FeatureDetailCardStyle}">
                                                         <StackPanel>
                                                             <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PUBLISHER"/>
                                                             <TextBlock FontSize="{DynamicResource FontSizeSmall}"
                                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                                        Text="{Binding SelectedGame.PublishersLabel}"
                                                                        TextWrapping="Wrap"/>
                                                         </StackPanel>
                                                     </Border>
                                                 </Grid>

                                                <!-- Metadata fields (compact grid) -->
                                                <Border Style="{StaticResource PageHeroPanelStyle}"
                                                        CornerRadius="{DynamicResource ThemeCornerRadiusLarge}"
                                                        Padding="18" Margin="0,0,0,20">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="TITLE"/>
                                                            <TextBox Style="{StaticResource TextFieldStyle}"
                                                                     Text="{Binding SelectedGame.Title, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PLATFORM"/>
                                                            <TextBox Style="{StaticResource TextFieldStyle}"
                                                                     Text="{Binding SelectedGame.Platform, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="STATUS"/>
                                                            <ComboBox Style="{StaticResource ComboFieldStyle}"
                                                                      ItemsSource="{Binding StatusChoices}"
                                                                      SelectedItem="{Binding SelectedGame.Status}"/>
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PRICE PAID (USD)"/>
                                                            <TextBox Style="{StaticResource TextFieldStyle}"
                                                                     Tag="e.g. 29.99 — leave blank if unknown/free"
                                                                     Text="{Binding SelectedGame.PurchasePriceInput, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="GAME FILE"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Style="{StaticResource PathTextFieldStyle}"
                                                                         Margin="0,0,6,0"
                                                                         Tag="e.g. C:\Games\MyGame\Game.exe"
                                                                         Text="{Binding SelectedGame.InstallPath, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="0,0,0,10" Padding="12,9"
                                                        Click="BrowseExecutableClick"
                                                        Content="Browse"/>
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="STEAM APP ID (OPTIONAL)"/>
                                                        <TextBox Style="{StaticResource TextFieldStyle}"
                                                        Text="{Binding SelectedGame.SteamAppId, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="DEVELOPER"/>
                                                        <TextBox Style="{StaticResource TextFieldStyle}"
                                                        Text="{Binding SelectedGame.DevelopersText, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PUBLISHER"/>
                                                        <TextBox Style="{StaticResource TextFieldStyle}"
                                                        Text="{Binding SelectedGame.PublishersText, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="GENRES"/>
                                                        <TextBox Style="{StaticResource TextFieldStyle}"
                                                                 Tag="e.g. Action, RPG, Platformer"
                                                        Text="{Binding SelectedGame.GenresText, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="COLLECTIONS"/>
                                                        <TextBox Style="{StaticResource TextFieldStyle}"
                                                                 Tag="e.g. Co-op Night, 2026 Backlog, Comfort Games"
                                                        Text="{Binding SelectedGame.TagsText, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Margin="0,2,0,10"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Text="Comma-separated. Each name becomes a custom collection under My Collections in the Library sidebar."/>
                                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="EMULATOR OVERRIDE (OPTIONAL)"/>
                                                            <TextBox Style="{StaticResource TextFieldStyle}"
                                                                      Tag="Leave blank to use platform default from Settings"
                                                                      Text="{Binding SelectedGame.EmulatorPath, UpdateSourceTrigger=PropertyChanged}"/>
                                                             <TextBlock Style="{StaticResource FieldLabelStyle}" Text="NOTES"/>
                                                             <TextBox Style="{StaticResource TextFieldStyle}"
                                                                      Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                                                                      Text="{Binding SelectedGame.Notes, UpdateSourceTrigger=PropertyChanged}"/>
                                                         </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource FeatureDetailCardStyle}"
                                                        Margin="0,0,0,20"
                                                        Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Save Continuity"/>
                                                        <TextBlock Margin="0,0,0,10"
                                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Text="Add one explicit save file or folder per line. Cirra fingerprints every file and verifies each backup before calling it healthy."/>
                                                        <TextBox Style="{StaticResource TextFieldStyle}"
                                                                 Height="72"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="NoWrap"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 Tag="One save file or folder per line"
                                                                 Text="{Binding SelectedGame.SaveLocationsText, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Margin="0,4,0,0"
                                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding SaveContinuityStatusMessage}"/>
                                                        <WrapPanel Margin="0,12,0,0">
                                                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                                                    Click="DiscoverGameSavesClick" Content="Discover Saves"/>
                                                            <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                                                                    Click="BackupGameSavesClick" Content="Create Verified Backup"/>
                                                            <Button Style="{StaticResource GhostButtonStyle}" Margin="0"
                                                                    Click="RestoreLatestGameSavesClick" Content="Restore Latest"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Screenshots strip -->
                                                <StackPanel Margin="0,0,0,20"
                                                            Visibility="{Binding SelectedGame.HasScreenshots, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource SectionHeadingStyle}"
                                                               Text="Screenshots" Margin="0,0,0,12"/>
                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                  VerticalScrollBarVisibility="Disabled"
                                                                  Height="156">
                                                        <ItemsControl ItemsSource="{Binding SelectedGame.ScreenshotUrls}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="244" Height="148"
                                                                            CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                                                            ClipToBounds="True"
                                                                            Margin="0,0,10,0"
                                                                            Background="{DynamicResource SurfaceBrush}">
                                                                        <Image Stretch="UniformToFill"
                                                                               Source="{Binding Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>

                                                <!-- Linked ownership (Duplicate Ownership Detector) -->
                                                <Border Margin="0,0,0,16"
                                                        Style="{StaticResource FeatureDetailCardStyle}"
                                                        Padding="14,10"
                                                        Visibility="{Binding SelectedGame.IsLinkedDuplicate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                                   Foreground="{DynamicResource GoldBrush}"
                                                                   Text="&#xE71B;&#x2002;LINKED OWNERSHIP"/>
                                                        <TextBlock Margin="0,6,0,0"
                                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding SelectedGame.LinkedOwnershipSummary}"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Achievement sync health -->
                                                <Border Margin="0,0,0,16"
                                                        Style="{StaticResource FeatureDetailCardStyle}"
                                                        Padding="14,10"
                                                        Visibility="{Binding SelectedGame.CanSyncAchievements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <DockPanel LastChildFill="False">
                                                        <StackPanel DockPanel.Dock="Left">
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ACHIEVEMENT SYNC"/>
                                                            <TextBlock Margin="0,6,0,0"
                                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Text="{Binding SelectedGame.AchievementHealthLabel}"/>
                                                        </StackPanel>
                                                        <Button DockPanel.Dock="Right"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                VerticalAlignment="Center"
                                                                Padding="9,7"
                                                                Click="SyncSelectedAchievementsClick"
                                                                ToolTip="Re-check this game's achievement sync now"
                                                                Content="&#x21BB;&#x2002;Refresh"/>
                                                    </DockPanel>
                                                </Border>

                                                <!-- Achievements section -->
                                                <StackPanel Margin="0,0,0,32"
                                                            Visibility="{Binding SelectedGame.HasAchievements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid Margin="0,0,0,10">
                                                        <TextBlock Style="{StaticResource SectionHeadingStyle}"
                                                                   Text="Achievements" Margin="0"/>
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding SelectedGame.AchievementSummary}"/>
                                                    </Grid>

                                                    <!-- Completion bar -->
                                                    <ProgressBar Style="{StaticResource AchievementProgressBarStyle}"
                                                                 Value="{Binding SelectedGame.AchievementCompletionPercent, Mode=OneWay}"
                                                                 Maximum="100" Margin="0,0,0,16"/>

                                                    <!-- Achievement cards -->
                                                    <ItemsControl ItemsSource="{Binding SelectedGame.Achievements}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="310"
                                                                        Margin="0,0,10,10" Padding="12"
                                                                        Background="{DynamicResource CardBrush}"
                                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                        BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerRadiusPanel}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="44"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Width="38" Height="38"
                                                                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                                                Background="{DynamicResource SurfaceBrush}"
                                                                                ClipToBounds="True">
                                                                            <Image Stretch="UniformToFill"
                                                                                   Source="{Binding DisplayIconUrl, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                            <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSmall}"
                                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                       Text="{Binding Title}" ToolTip="{Binding Title}"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                                       Text="{Binding UnlockStateLabel}"/>
                                                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                                       Text="{Binding RarityLabel}"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <!-- ── IMPORT CENTER ── -->
                            <TabItem>
                                <Grid Margin="24,20,24,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Style="{StaticResource PanelBorderStyle}"
                                            Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionHeadingStyle}"
                                                           Text="Import Review"/>
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Text="{Binding ImportSummary}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <WrapPanel Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Margin="18,0,0,0">
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Margin="0,0,8,0"
                                                        Click="SelectSuggestedCandidatesClick"
                                                        Content="Select Suggested"/>
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="0,0,8,0"
                                                        Click="SelectAllCandidatesClick"
                                                        Content="Select All"/>
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Margin="0,0,8,0"
                                                        Click="ClearImportReviewClick"
                                                        Content="Clear"/>
                                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                                        Margin="0"
                                                        Click="ImportSelectedClick"
                                                        Content="Import Selected"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.35*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="0.95*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Style="{StaticResource PanelBorderStyle}"
                                                Padding="0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        CornerRadius="8,8,0,0"
                                                        Padding="18,16,18,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource SectionHeadingStyle}"
                                                                       Text="Candidates"/>
                                                            <TextBlock Margin="0,4,0,0"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <WrapPanel Grid.Column="1"
                                                                   VerticalAlignment="Center">
                                                            <Border Margin="0,0,8,0"
                                                                    Padding="10,4"
                                                                    Background="{DynamicResource BerryDimBrush}"
                                                                    BorderBrush="{DynamicResource BerryBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="999">
                                                                <TextBlock Foreground="{DynamicResource BerryBrush}"
                                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding ReadyToImportCount, StringFormat={}{0} selected}"/>
                                                            </Border>
                                                            <Border Padding="10,4"
                                                                    Background="{DynamicResource SurfaceHighBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="999">
                                                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding StrongMatchCount, StringFormat={}{0} strong matches}"/>
                                                            </Border>
                                                        </WrapPanel>
                                                    </Grid>
                                                </Border>

                                                <ListBox Grid.Row="1"
                                                         ItemsSource="{Binding ImportCandidates}"
                                                         SelectedItem="{Binding SelectedCandidate}"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="18,16,18,24"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.CanContentScroll="True"
                                                         VirtualizingPanel.IsVirtualizing="True"
                                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                                         VirtualizingPanel.CacheLength="1.5"
                                                         VirtualizingPanel.CacheLengthUnit="Page"
                                                         VirtualizingPanel.ScrollUnit="Pixel">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="CandidateCard"
                                                                    Margin="0,0,0,12"
                                                                    Padding="16"
                                                                    Background="{DynamicResource CardBrush}"
                                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                                                    Cursor="Hand">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <CheckBox Margin="0,4,14,0"
                                                                              VerticalAlignment="Top"
                                                                              IsChecked="{Binding IsSelected}"/>

                                                                    <StackPanel Grid.Column="1">
                                                                        <WrapPanel Margin="0,0,0,8">
                                                                            <Border Padding="8,3"
                                                                                    Background="{DynamicResource SurfaceHighBrush}"
                                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="{DynamicResource ThemeCornerRadiusPill}">
                                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                                           Text="{Binding ReviewAccentLabel}"/>
                                                                            </Border>
                                                                            <Border Margin="8,0,0,0"
                                                                                    Padding="8,3"
                                                                                    Background="{DynamicResource SurfaceBrush}"
                                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="{DynamicResource ThemeCornerRadiusPill}">
                                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                           Text="{Binding SourceLabel}"/>
                                                                            </Border>
                                                                            <Border Margin="8,0,0,0"
                                                                                    Padding="8,3"
                                                                                    Background="{DynamicResource SurfaceBrush}"
                                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="{DynamicResource ThemeCornerRadiusPill}">
                                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                           Text="{Binding Platform}"/>
                                                                            </Border>
                                                                            <Border Margin="8,0,0,0"
                                                                                    Padding="8,3"
                                                                                    Background="{DynamicResource GoldDimBrush}"
                                                                                    BorderBrush="{DynamicResource GoldBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                                                                    Visibility="{Binding IsRom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource GoldBrush}"
                                                                                           Text="ROM"/>
                                                                            </Border>
                                                                        </WrapPanel>

                                                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                   Text="{Binding Title}"/>

                                                                        <TextBlock Margin="0,6,0,10"
                                                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                   Text="{Binding SignalsPreview}"
                                                                                   TextWrapping="Wrap"/>

															<TextBlock Margin="0,0,0,10"
															           FontSize="{DynamicResource FontSizeCaption}"
															           Foreground="{DynamicResource MintBrush}"
															           Text="{Binding ReconciliationReason}"
															           TextWrapping="Wrap"/>

                                                                        <ProgressBar Height="6"
                                                                                     Maximum="100"
                                                                                     Value="{Binding ConfidencePercent}"/>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2"
                                                                                Margin="16,0,0,0"
                                                                                VerticalAlignment="Top">
                                                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                                   FontSize="{DynamicResource FontSizeBody}"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                   Text="{Binding ConfidenceBand}"/>
                                                                        <TextBlock Margin="0,4,0,0"
                                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                   Text="{Binding ConfidenceLabel}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                    <Setter TargetName="CandidateCard" Property="Background" Value="{DynamicResource BerryDimBrush}"/>
                                                                    <Setter TargetName="CandidateCard" Property="BorderBrush" Value="{DynamicResource BerryBrush}"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Style="{StaticResource PanelBorderStyle}"
                                                Padding="0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        Style="{StaticResource AccentPanelStyle}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        CornerRadius="8,8,0,0"
                                                        Padding="18,16,18,12">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource SectionHeadingStyle}"
                                                                   Text="{Binding SelectedCandidate.Title, TargetNullValue='Select a candidate'}"/>
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <Border Padding="8,3"
                                                                    Background="{DynamicResource SurfaceHighBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{DynamicResource ThemeCornerRadiusPill}">
                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           Text="{Binding SelectedCandidate.ReviewState, TargetNullValue='Awaiting selection'}"/>
                                                            </Border>
                                                            <Border Margin="8,0,0,0"
                                                                    Padding="8,3"
                                                                    Background="{DynamicResource BerryDimBrush}"
                                                                    BorderBrush="{DynamicResource BerryBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{DynamicResource ThemeCornerRadiusPill}">
                                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BerryBrush}"
                                                                           Text="{Binding SelectedCandidate.ConfidenceLabel, TargetNullValue='Review details'}"/>
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <ScrollViewer Grid.Row="1"
                                                              VerticalScrollBarVisibility="Auto"
                                                              Padding="18,16,18,24">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,16">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Margin="0,0,8,0"
                                                                    Style="{StaticResource InsetCardStyle}"
                                                                    Padding="14,12">
                                                                <StackPanel>
                                                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PLATFORM"/>
                                                                    <TextBlock FontSize="{DynamicResource FontSizeBody}"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               Text="{Binding SelectedCandidate.Platform, TargetNullValue='Unknown'}"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Grid.Column="1"
                                                                    Margin="8,0,0,0"
                                                                    Style="{StaticResource InsetCardStyle}"
                                                                    Padding="14,12">
                                                                <StackPanel>
                                                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="SOURCE"/>
                                                                    <TextBlock FontSize="{DynamicResource FontSizeBody}"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               Text="{Binding SelectedCandidate.SourceLabel, TargetNullValue='Scan'}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>

                                                        <Border Style="{StaticResource InsetCardStyle}"
                                                                Padding="14,12"
                                                                Margin="0,0,0,16">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="MATCH CONFIDENCE"/>
                                                                <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                           FontSize="{DynamicResource FontSizeHeading}"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           Text="{Binding SelectedCandidate.ConfidenceBand, TargetNullValue='Select a candidate'}"/>
                                                                <ProgressBar Height="8"
                                                                             Margin="0,12,0,10"
                                                                             Maximum="100"
                                                                             Value="{Binding SelectedCandidate.ConfidencePercent}"/>
                                                                <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                                                           Text="{Binding SelectedCandidate.ConfidenceLabel, TargetNullValue='Cirra will explain why a title was matched once you pick one.'}"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="WHY CLOUDBERRY PICKED THIS"/>
                                                        <Border Style="{StaticResource InsetCardStyle}"
                                                                Padding="14,12"
                                                                Margin="0,6,0,16">
                                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="20"
                                                                       Text="{Binding SelectedCandidate.SignalsText, TargetNullValue='Select a candidate to inspect the scan evidence.'}"/>
                                                        </Border>

                                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="INSTALL PATH"/>
                                                        <Border Style="{StaticResource InsetCardStyle}"
                                                                Padding="14,12">
                                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="20"
                                                                       Text="{Binding SelectedCandidate.InstallPath, TargetNullValue='Select a candidate to preview its path.'}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <!-- ── METADATA SEARCH ── -->
                            <TabItem>
                                <Grid Margin="24,20,24,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Search bar -->
                                    <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="SEARCH"/>
                                                <TextBox x:Name="LibraryMetadataSearchBox"
                                                         Style="{StaticResource TextFieldStyle}" Margin="0"
                                                         KeyDown="LibraryMetadataSearchBoxKeyDown"
                                                         Text="{Binding MetadataSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                                        Click="DownloadMissingMetadataClick"
                                                        Content="Fill Library"/>
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0"
                                                        Click="SearchMetadataClick"
                                                        Content="Search"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Results + detail -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                                            <ListBox x:Name="LibraryMetadataResultsList"
                                                     ItemsSource="{Binding MetadataResults}"
                                                     SelectedItem="{Binding SelectedMetadataResult}"
                                                     BorderThickness="0" Background="Transparent"
                                                     ScrollViewer.CanContentScroll="True"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     VirtualizingPanel.CacheLength="1.5"
                                                     VirtualizingPanel.CacheLengthUnit="Page"
                                                     VirtualizingPanel.ScrollUnit="Pixel"
                                                     PreviewKeyDown="MetadataResultsListPreviewKeyDown">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8" Padding="12"
                                                                Background="{DynamicResource CardBrush}"
                                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerRadiusPanel}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="58"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="50" Height="66"
                                                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                                                        CornerRadius="{DynamicResource ThemeCornerRadiusControl}" ClipToBounds="True">
                                                                    <Image Stretch="UniformToFill"
                                                                    Source="{Binding CoverImageUrl, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=hero}"/>
                                                                    </Border>
                                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                                    <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               Text="{Binding Title}"/>
                                                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               Text="{Binding ReleaseDateLabel}"/>
                                                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               Text="{Binding ProviderName}"/>
                                                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource GoldBrush}"
                                                                               Text="{Binding MatchConfidenceLabel}"
                                                                               Visibility="{Binding HasMatchConfidence, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               Text="{Binding SummaryOrPlaceholder}" ToolTip="{Binding SummaryOrPlaceholder}"
                                                                               TextWrapping="Wrap"
                                                                               MaxHeight="36"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                                            <StackPanel>
                                                <Border Height="120" CornerRadius="{DynamicResource ThemeCornerRadiusPanel}" ClipToBounds="True"
                                                        Margin="0,0,0,14"
                                                        Visibility="{Binding SelectedMetadataResult.HasCoverImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Image Stretch="UniformToFill"
                                                           Source="{Binding SelectedMetadataResult.CoverImageUrl, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=hero}"/>
                                                </Border>
                                                <TextBlock Style="{StaticResource SectionHeadingStyle}"
                                                           Text="{Binding SelectedMetadataResult.Title, TargetNullValue='Select a result'}"/>
                                                <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Text="{Binding MetadataStatusMessage}"/>
                                                <TextBlock Margin="0,8,0,16" FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding SelectedMetadataResult.SummaryOrPlaceholder}"
                                                           TextWrapping="Wrap"/>
                                                <WrapPanel>
                                                    <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                                                            Click="ApplyMetadataClick"
                                                            Content="Apply to Current"/>
                                                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                                                            Click="SearchSelectedGameMetadataClick"
                                                            Content="Retarget Query"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabItem>

                        </TabControl>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════
                     PAGE 2 — METADATA CENTER
                     ══════════════════════════════════════════ -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource ThemePanelFillSoftBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="24,16">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <CheckBox Margin="0,0,14,0" VerticalAlignment="Center"
                                              IsChecked="{Binding ReplaceExistingMetadata}"
                                              IsEnabled="{Binding IsMetadataBusy, Converter={StaticResource InverseBooleanConverter}}"
                                              Content="Replace existing metadata"
                                              ToolTip="When off, Fill Missing and Retry Failed only fill in blank fields and never overwrite anything you or a prior download already set."/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                            Click="OpenMetadataWindowClick" Content="Advanced Editor"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                                            Click="DownloadMissingMetadataClick" Content="Fill Missing"
                                            Visibility="{Binding IsMetadataBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                                            Click="RetryFailedMetadataClick" Content="{Binding FailedMetadataTargetCount, StringFormat='Retry Failed ({0})'}"
                                            Visibility="{Binding HasFailedMetadataTargets, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            IsEnabled="{Binding IsMetadataBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                                            Click="CancelMetadataBatchClick" Content="Cancel"
                                            Visibility="{Binding IsMetadataBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0"
                                            Click="SearchSelectedGameMetadataClick" Content="Search Current Game"/>
                                </WrapPanel>
                                <StackPanel>
                                    <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                               FontSize="{DynamicResource FontSizeHeading}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="Metadata Center"/>
                                    <TextBlock FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding MetadataStatusMessage}" ToolTip="{Binding MetadataStatusMessage}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="24"
                              Visibility="{Binding HasGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" MinWidth="260"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0"
                                    Grid.ColumnSpan="5"
                                    Style="{StaticResource PageHeroPanelStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="METADATA WORKSPACE"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding SelectedGame.Title, TargetNullValue='Select a library game to begin'}" ToolTip="{Binding SelectedGame.Title, TargetNullValue='Select a library game to begin'}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding MetadataStatusMessage}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="36"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource AccentPanelStyle}"
                                            Width="250"
                                            Margin="18,0,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="SELECTED GAME"/>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding SelectedGame.MetadataCoverageLabel, TargetNullValue='Nothing selected yet'}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="Search, compare, and apply metadata and media from one focused surface."
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Library Games"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"
                                                   TextWrapping="Wrap"
                                                   Text="Select a game here, then use the editor window for searching, reviewing media, and applying metadata."/>
                                    </StackPanel>
                                    <ListBox Margin="0,14,0,0"
                                             ItemsSource="{Binding Games}"
                                             SelectedItem="{Binding SelectedGame}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="MetadataGameCard"
                                                        Margin="0,0,0,8" Padding="10"
                                                        Background="{DynamicResource CardBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerRadiusPanel}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="38" Height="52" CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                                Background="{DynamicResource SurfaceElevatedBrush}"
                                                                ClipToBounds="True">
                                                            <Image Stretch="UniformToFill"
                                                                   Source="{Binding DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=hero}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Text="{Binding Title}" ToolTip="{Binding Title}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Text="{Binding MetadataCoverageLabel}" ToolTip="{Binding MetadataCoverageLabel}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter TargetName="MetadataGameCard" Property="Background" Value="{DynamicResource BerryDimBrush}"/>
                                                        <Setter TargetName="MetadataGameCard" Property="BorderBrush" Value="{DynamicResource BerryBrush}"/>
                                                        <Setter TargetName="MetadataGameCard" Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Search Online Metadata"/>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="SEARCH"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="MetadataCenterSearchBox"
                                                     Style="{StaticResource TextFieldStyle}"
                                                     Margin="0,0,10,0"
                                                     KeyDown="MetadataCenterSearchBoxKeyDown"
                                                     Text="{Binding MetadataSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0"
                                                    Click="SearchMetadataClick"
                                                    Content="Search"/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Margin="0,16,0,8"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="MATCHES"/>

                                    <ListBox x:Name="MetadataCenterResultsList"
                                             Grid.Row="2"
                                             ItemsSource="{Binding MetadataResults}"
                                             SelectedItem="{Binding SelectedMetadataResult}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             PreviewKeyDown="MetadataResultsListPreviewKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="MetadataResultCard"
                                                        Margin="0,0,0,8" Padding="12"
                                                        Background="{DynamicResource CardBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerRadiusPanel}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="48" Height="66" CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                                Background="{DynamicResource SurfaceElevatedBrush}"
                                                                ClipToBounds="True">
                                                            <Image Stretch="UniformToFill"
                                                            Source="{Binding CoverImageUrl, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=hero}"/>
                                                            </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Text="{Binding Title}"/>
                                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Text="{Binding ReleaseDateLabel}"/>
                                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Text="{Binding ProviderName}"/>
                                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource GoldBrush}"
                                                                       Text="{Binding MatchConfidenceLabel}"
                                                                       Visibility="{Binding HasMatchConfidence, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Margin="0,5,0,0"
                                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Text="{Binding SummaryOrPlaceholder}"
                                                                       TextWrapping="Wrap"
                                                                       MaxHeight="42"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter TargetName="MetadataResultCard" Property="Background" Value="{DynamicResource BerryDimBrush}"/>
                                                        <Setter TargetName="MetadataResultCard" Property="BorderBrush" Value="{DynamicResource BerryBrush}"/>
                                                        <Setter TargetName="MetadataResultCard" Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource PanelBorderStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Height="170"
                                                Style="{StaticResource InsetCardStyle}"
                                                ClipToBounds="True"
                                                Background="{DynamicResource SurfaceElevatedBrush}">
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding SelectedMetadataResult.HeroImageUrl, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=background}"/>
                                        </Border>
                                        <TextBlock Margin="0,16,0,0"
                                                   Style="{StaticResource SectionHeadingStyle}"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   Text="{Binding SelectedMetadataResult.Title, TargetNullValue='Select a metadata result'}"/>
                                        <TextBlock Margin="0,2,0,10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding SelectedGame.Title, TargetNullValue='No library game selected'}"/>
                                        <TextBlock Margin="0,0,0,10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding SelectedMetadataResult.MediaSummary}" ToolTip="{Binding SelectedMetadataResult.MediaSummary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding SelectedMetadataResult.SummaryOrPlaceholder}"/>
                                        <WrapPanel Margin="0,18,0,0">
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Click="ApplyMetadataClick"
                                                    Content="Apply to Game"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0"
                                                    Click="SaveSelectedGameClick"
                                                    Content="Save Game"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="Transparent"
                                Visibility="{Binding HasGames, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="24,22"
                                    Style="{StaticResource InsetCardStyle}">
                                <StackPanel Width="280">
                                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                               FontSize="{DynamicResource FontSizeStatLarge}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,6"
                                               Text="&#xE8B9;"/>
                                    <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                               FontSize="{DynamicResource FontSizeHeading}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="No games to add metadata to yet"
                                               TextAlignment="Center"/>
                                    <TextBlock Margin="0,8,0,14"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="Bring some games into your library first, then come back here to fill in covers, summaries, and release details."
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <StackPanel>
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Click="ScanFolderClick"
                                                Content="Scan Games Folder"/>
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Margin="0,8,0,0"
                                                Click="QuickAddClick"
                                                Content="Add One Game Manually"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════
                     PAGE 3 — ACHIEVEMENTS
                     ══════════════════════════════════════════ -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" MinWidth="260"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.RowSpan="2" Grid.ColumnSpan="3"
                                   Fill="{DynamicResource AuroraVeilBrush}"
                                   Opacity="0.08"
                                   IsHitTestVisible="False"/>

                        <!-- Header -->
                        <Border Grid.Row="0" Grid.ColumnSpan="3"
                                Style="{StaticResource PageHeroPanelStyle}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1" Padding="22,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeHeading}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="Achievement Center"/>
                                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding AchievementStatusMessage}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource AccentPanelStyle}"
                                            Padding="10"
                                            Margin="16,0,0,0"
                                            CornerRadius="{DynamicResource ThemeCornerRadiusPanel}">
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBox x:Name="AchievementGameSearchBox"
                                                     Style="{StaticResource TextFieldStyle}"
                                                     Tag="Search library games"
                                                     Width="220"
                                                     Height="34"
                                                     Margin="0,0,8,0"
                                                     VerticalContentAlignment="Center"
                                                     KeyDown="AchievementGameSearchBoxKeyDown"
                                                     ToolTip="Search for a game in your library to focus achievements"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                                    Click="SearchAchievementGameClick" Content="Search"/>
                                            <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                                                    Click="ScanSelectedAchievementsLocalClick" Content="Scan Local"/>
                                            <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                                                    Click="SyncSelectedAchievementsClick" Content="Find Source"/>
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0"
                                                    Click="SyncMissingAchievementsClick" Content="Fill Missing"/>
                                        </WrapPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource AccentPanelStyle}"
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                                    Background="{DynamicResource CloudDimBrush}"
                                                    BorderBrush="{DynamicResource CloudBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <Ellipse Fill="{DynamicResource CloudBrush}"
                                                         Width="8"
                                                         Height="8"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Triggers>
                                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0.35"
                                                                                     To="1"
                                                                                     Duration="0:0:1.1"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="SYNC STATUS"/>
                                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding AchievementTrackingSummary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource AccentPanelStyle}" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="READY"/>
                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                       FontSize="{DynamicResource FontSizeBodyLarge}"
                                                       Foreground="{DynamicResource GoldBrush}"
                                                       Text="{Binding GamesWithAchievementsCount}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource AccentPanelStyle}" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="UNLOCKED"/>
                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                       FontSize="{DynamicResource FontSizeBodyLarge}"
                                                       Foreground="{DynamicResource GoldBrush}"
                                                       Text="{Binding UnlockedAchievementsCount}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource AccentPanelStyle}" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="TOTAL"/>
                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                       FontSize="{DynamicResource FontSizeBodyLarge}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding TotalAchievementsCount}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Left: game list -->
                        <Border Grid.Row="1" Grid.Column="0"
                                Margin="0,0,0,4"
                                Style="{StaticResource PanelBorderStyle}"
                                Padding="6"
                                Visibility="{Binding HasGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox ItemsSource="{Binding Games}"
                                 SelectedItem="{Binding SelectedGame}"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="4,4,4,18"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="AchCard" Margin="0,0,0,4"
                                            Background="Transparent" CornerRadius="{DynamicResource ThemeCornerRadiusPanel}" Cursor="Hand">
                                        <Grid Margin="10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="48" CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                                    ClipToBounds="True">
                                                <Image Stretch="UniformToFill"
                                                Source="{Binding DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=hero}"/>
                                                </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource GoldBrush}"
                                                           Text="{Binding AchievementSummary}"/>
                                                <ProgressBar Style="{StaticResource AchievementProgressBarStyle}"
                                                             Margin="0,4,0,0"
                                                             Value="{Binding AchievementCompletionPercent, Mode=OneWay}"
                                                             Maximum="100"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1"
                                Background="{DynamicResource BorderSubtleBrush}"/>

                        <!-- Empty state: no games in library yet -->
                        <Border Grid.Row="1" Grid.ColumnSpan="3"
                                Background="Transparent"
                                Visibility="{Binding HasGames, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="24,22"
                                    Style="{StaticResource InsetCardStyle}">
                                <StackPanel Width="280">
                                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                               FontSize="{DynamicResource FontSizeStatLarge}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,6"
                                               Text="&#xE9D9;"/>
                                    <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                               FontSize="{DynamicResource FontSizeHeading}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="No games to track achievements for yet"
                                               TextAlignment="Center"/>
                                    <TextBlock Margin="0,8,0,14"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="Bring some games into your library first, then sync and track achievements here."
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <StackPanel>
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Click="ScanFolderClick"
                                                Content="Scan Games Folder"/>
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Margin="0,8,0,0"
                                                Click="QuickAddClick"
                                                Content="Add One Game Manually"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Right: achievement detail -->
                        <Border Grid.Row="1" Grid.Column="2"
                                Margin="0,0,0,4"
                                Style="{StaticResource PanelBorderStyle}"
                                Padding="0"
                                Visibility="{Binding HasGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Background="Transparent">
                            <StackPanel Margin="28,24,28,32">
                                <!-- Game header -->
                                <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeStatMedium}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding SelectedGame.Title, TargetNullValue='Select a game'}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding SelectedGame.AchievementSourceLabel}"/>

                                <!-- Stats row -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="UNLOCKED"/>
                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeHeading}"
                                                       Foreground="{DynamicResource GoldBrush}"
                                                       Text="{Binding SelectedGame.AchievementsUnlockedCount, TargetNullValue=0}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="TOTAL"/>
                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeHeading}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding SelectedGame.AchievementCount, TargetNullValue=0}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="COMPLETION"/>
                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeHeading}"
                                                       Foreground="{DynamicResource BerryBrush}"
                                                       Text="{Binding SelectedGame.AchievementCompletionPercent, TargetNullValue=0, StringFormat={}{0:0}%}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource PanelBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="GAMERSCORE"/>
                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontSize="{DynamicResource FontSizeHeading}"
                                                       Foreground="{DynamicResource GoldBrush}"
                                                       Text="{Binding SelectedGame.EarnedGamerScore, TargetNullValue=0, StringFormat={}{0:N0} G}"/>
                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding SelectedGame.GamerScoreLabel}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Progress bar -->
                                <ProgressBar Style="{StaticResource AchievementProgressBarStyle}"
                                             Margin="0,16,0,20"
                                             Value="{Binding SelectedGame.AchievementCompletionPercent, Mode=OneWay}"
                                             Maximum="100"/>

                                <!-- Achievement cards grid -->
                                <ItemsControl ItemsSource="{Binding SelectedGame.Achievements}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Stretch" Margin="0,0,0,10" Padding="14"
                                                    Style="{StaticResource InsetCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="44" Height="44" CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            ClipToBounds="True">
                                                        <Image Stretch="UniformToFill"
                                                        Source="{Binding DisplayIconUrl, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=card}"/>
                                                        </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding Title}"/>
                                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="{Binding UnlockStateLabel}"/>
                                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="{Binding RarityLabel}"/>
                                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource GoldBrush}"
                                                                   Text="{Binding GamerScoreValue, StringFormat={}{0} G}"/>
                                                        <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding DescriptionOrPlaceholder}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- ══════════════════════════════════════════
                     PAGE 4 — THEATRE
                     ══════════════════════════════════════════ -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- toolbar -->
                            <RowDefinition Height="*"/>      <!-- sidebar + browser -->
                        </Grid.RowDefinitions>

                        <!-- ── Toolbar ── -->
                        <Border Grid.Row="0"
                                Padding="12,9"
                                Background="{DynamicResource BladeGlassBrush}"
                                BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Visibility="{Binding IsTheatreWatchMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: exit + nav + sidebar toggle -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="10,5"
                                            Click="ExitTheatreClick"
                                            Content="&#x276E;&#x276E;  Library" FontSize="{DynamicResource FontSizeSmall}"
                                            ToolTip="Return to library"/>
                                    <Border Width="1" Background="{DynamicResource BorderSubtleBrush}" Margin="6,3"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="9,5"
                                            Click="MainTheatreBackClick"
                                            Content="&#x276E;" ToolTip="Back" FontSize="{DynamicResource FontSizeBody}"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="9,5"
                                            Click="MainTheatreForwardClick"
                                            Content="&#x276F;" ToolTip="Forward" FontSize="{DynamicResource FontSizeBody}"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="9,5"
                                            Click="MainTheatreRefreshClick"
                                            Content="&#x27F3;" ToolTip="Refresh" FontSize="{DynamicResource FontSizeBody}"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="9,5"
                                            Click="MainTheatreHomeClick"
                                            Content="&#x2302;" ToolTip="Home" FontSize="{DynamicResource FontSizeBody}"/>
                                    <Border Width="1" Background="{DynamicResource BorderSubtleBrush}" Margin="6,3"/>
                                    <ToggleButton IsChecked="{Binding IsTheatreSidebarOpen, Mode=TwoWay}"
                                                  Style="{StaticResource GhostToggleButtonStyle}"
                                                  Padding="9,5" ToolTip="Toggle saved sites"
                                                  Content="&#xE8A0;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeBody}"/>
                                </StackPanel>

                                <!-- Centre: address bar -->
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0">
                                    <TextBox Style="{StaticResource TextFieldStyle}"
                                             Margin="0" Height="32"
                                             VerticalContentAlignment="Center"
                                             Padding="12,0,52,0"
                                             FontSize="{DynamicResource FontSizeSmall}"
                                             ToolTip="Enter a URL and press Go"
                                             PreviewKeyDown="MainTheatreAddressKeyDown"
                                             Text="{Binding TheatreAddressText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="12,4" Margin="0,0,3,0"
                                            Click="MainTheatreGoClick"
                                            Content="Go" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSmall}"/>
                                </Grid>

                                <!-- Right: Save Site + Watch -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"
                                            Click="MainTheatreAddSiteClick"
                                            Content="&#x2605;  Save Site" ToolTip="Save current site"/>
                                    <Border Width="1" Background="{DynamicResource BorderSubtleBrush}" Margin="6,3"/>
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Padding="14,5"
                                            Click="EnterMainTheatreWatchClick"
                                            Content="&#x25B6;  Watch" ToolTip="Expand to full player (F11)"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="12,5"
                                            Click="ExitMainTheatreWatchClick"
                                            Visibility="{Binding TheatreExitWatchVisibility}"
                                            Content="&#x25A3;  Exit" ToolTip="Exit watch mode"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ── Main area: saved-sites sidebar + browser ── -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Saved sites sidebar -->
                            <Border Grid.Column="0"
                                    Width="220"
                                    Background="{DynamicResource SidebarBrush}"
                                    BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                                    BorderThickness="0,0,1,0"
                                    Visibility="{Binding TheatreSidebarVisibility}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Padding="14,12,14,8"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="0,0,0,1">
                                        <TextBlock Text="SAVED SITES"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Opacity="0.7"/>
                                    </Border>

                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SavedTheatreSites}"
                                             SelectedItem="{Binding SelectedSavedSite}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="Padding" Value="14,9"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <EventSetter Event="MouseLeftButtonUp" Handler="MainTheatreSavedSiteClicked"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                                                           FontSize="{DynamicResource FontSizeBody}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Grid.Row="2" Padding="10,8"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="0,1,0,0">
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Padding="10,5" HorizontalAlignment="Stretch"
                                                Click="MainTheatreRemoveSiteClick"
                                                Content="&#x2715;  Remove Selected"
                                                ToolTip="Remove selected saved site"
                                                FontSize="{DynamicResource FontSizeSmall}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Browser -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource AppBackgroundBrush}"
                                    ClipToBounds="True">
                                <wv2:WebView2 x:Name="MainTheatreBrowser"
                                              CoreWebView2InitializationCompleted="MainTheatreBrowserInitCompleted"/>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- ══════════════════════════════════════════
                     PAGE 5 — FRIENDS
                     ══════════════════════════════════════════ -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24,28,28" MaxWidth="1240">
                            <TextBlock Style="{StaticResource SectionHeadingStyle}"
                                       FontSize="{DynamicResource FontSizeStatMedium}"
                                       Text="Friends"
                                       Margin="0,0,0,20"/>

                            <Border Style="{StaticResource PageHeroPanelStyle}" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{StaticResource PremiumProfileCardStyle}"
                                            Visibility="Collapsed"
                                            MinHeight="286">
                                        <Grid>
                                            <Rectangle Style="{StaticResource ProfileSurfaceAtmosphereOverlayStyle}"/>
                                            <Rectangle Style="{StaticResource ProfileSurfacePatternOverlayStyle}"/>
                                            <Rectangle Style="{StaticResource ProfileSurfaceSweepOverlayStyle}" Width="260"/>
                                            <Border VerticalAlignment="Top"
                                                    Height="72"
                                                    Background="{DynamicResource GlassSheenBrush}"
                                                    BorderBrush="{DynamicResource ProfileBadgeBorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    IsHitTestVisible="False"/>
                                            <Border HorizontalAlignment="Right"
                                                    Width="150"
                                                    Background="{DynamicResource GlassSheenBrush}"
                                                    BorderBrush="{DynamicResource ProfileBadgeBorderBrush}"
                                                    BorderThickness="1,0,0,0"
                                                    IsHitTestVisible="False"/>
                                            <Grid Margin="24,22">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="126"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel>
                                                    <WrapPanel Margin="0,0,0,18">
                                                        <Border Style="{StaticResource ProfileGlassTagStyle}">
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding ActiveProfileStamp}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource ProfileGlassTagStyle}">
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding ActiveProfileCloudCode}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource ProfileGlassTagStyle}">
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding ProfileSocialSummary}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                               FontSize="{DynamicResource FontSizeDisplay}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Text="{Binding ActiveProfileName}"/>
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="{DynamicResource FontSizeBody}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="{Binding ActiveProfilePresenceLine}"/>
                                                    <TextBlock Margin="0,12,18,0"
                                                               FontSize="{DynamicResource FontSizeSmall}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Text="{Binding ActiveProfileMotto}"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="44"/>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Style="{StaticResource ProfileAvatarHeroStyle}">
                                                    <Grid>
                                                        <Ellipse Style="{StaticResource ProfileBadgePulseStyle}" Margin="-8"/>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                                   FontSize="{DynamicResource FontSizeDisplay}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding ActiveProfileIconGlyph}"/>
                                                    </Grid>
                                                </Border>
                                                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,24,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource ProfileScoreBandStyle}">
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="GAMERSCORE"/>
                                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                       FontSize="{DynamicResource FontSizeStatMedium}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource CloudBrush}"
                                                                       Text="{Binding ActiveProfileScoreLine}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="2" Style="{StaticResource ProfileScoreBandStyle}">
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ACHIEVEMENTS"/>
                                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                       FontSize="{DynamicResource FontSizeHeading}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Text="{Binding ActiveProfileAchievementLine}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="4" Style="{StaticResource ProfileScoreBandStyle}">
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="LIBRARY"/>
                                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                       FontSize="{DynamicResource FontSizeHeading}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Text="{Binding ActiveProfileLibraryLine}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="YOUR CIRRA ID"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeTitle}"
                                                   Foreground="{DynamicResource CloudBrush}"
                                                   Text="{Binding ActiveProfileCloudCode}"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding SocialStatusMessage}"
                                                   TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Click="PublishProfileOnlineClick"
                                                    Content="Publish Online"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Click="CopyCloudCodeClick"
                                                    Content="Copy Code"/>
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Click="CopyFriendCardClick"
                                                    Content="Copy Friend Card"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Roster"/>
                                    <TextBlock Margin="0,0,0,16"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding FriendsSummary}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.25*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="FRIEND CARDS"/>
                                            <ListBox Background="Transparent"
                                                     BorderThickness="0"
                                                     ItemsSource="{Binding Friends}"
                                                     SelectedItem="{Binding SelectedFriend}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="FriendCardRoot"
                                                                Style="{StaticResource ProfileCardStyle}"
                                                                Width="340"
                                                                Height="216"
                                                                Padding="0"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <Rectangle Style="{StaticResource ProfileSurfaceAtmosphereOverlayStyle}"/>
                                                                <Rectangle Style="{StaticResource ProfileSurfacePatternOverlayStyle}"/>
                                                                <Rectangle Style="{StaticResource ProfileSurfaceSweepOverlayStyle}"
                                                                           Width="172"/>
                                                                <Border Height="54"
                                                                        VerticalAlignment="Top"
                                                                        Background="{DynamicResource ProfileScoreBandBrush}"
                                                                        BorderBrush="{DynamicResource ProfileBadgeBorderBrush}"
                                                                        BorderThickness="0,0,0,1"
                                                                        IsHitTestVisible="False"/>
                                                                <Border Width="100"
                                                                        HorizontalAlignment="Right"
                                                                        Background="{DynamicResource ProfileAvatarTileBrush}"
                                                                        BorderBrush="{DynamicResource ProfileBadgeBorderBrush}"
                                                                        BorderThickness="1,0,0,0"
                                                                        IsHitTestVisible="False"/>
                                                                <Grid Margin="18,15">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="96"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <DockPanel Grid.ColumnSpan="2">
                                                                        <StackPanel DockPanel.Dock="Left"
                                                                                    Orientation="Horizontal">
                                                                            <Ellipse Width="8"
                                                                                     Height="8"
                                                                                     Margin="0,0,7,0"
                                                                                     VerticalAlignment="Center">
                                                                                <Ellipse.Style>
                                                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource ProfileBadgePulseStyle}">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                                                <Setter Property="Opacity" Value="0.14"/>
                                                                                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Ellipse.Style>
                                                                            </Ellipse>
                                                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                       Text="{Binding StatusLabel}" ToolTip="{Binding StatusLabel}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       MaxWidth="150"/>
                                                                        </StackPanel>
                                                                        <TextBlock DockPanel.Dock="Right"
                                                                                   FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource CloudBrush}"
                                                                                   Text="{Binding CloudCode}"/>
                                                                    </DockPanel>

                                                                    <StackPanel Grid.Row="1"
                                                                                Margin="0,22,12,0">
                                                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                                   FontSize="{DynamicResource FontSizeStatMedium}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                   Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Margin="0,4,0,0"
                                                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                   Text="{Binding PresenceLine}" ToolTip="{Binding PresenceLine}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Margin="0,11,0,0"
                                                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                   Text="{Binding Motto}"
                                                                                   TextWrapping="Wrap"
                                                                                   MaxHeight="38"/>
                                                                    </StackPanel>

                                                                    <Border Grid.Row="1"
                                                                            Grid.Column="1"
                                                                            Width="78"
                                                                            Height="78"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Style="{StaticResource ProfileAvatarHeroStyle}">
                                                                        <Grid>
                                                                            <Ellipse Style="{StaticResource ProfileBadgePulseStyle}"
                                                                                     Margin="-8"/>
                                                                            <TextBlock HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                                                       FontSize="{DynamicResource FontSizeStatLarge}"
                                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                       Text="{Binding IconGlyph}"/>
                                                                        </Grid>
                                                                    </Border>

                                                                    <Grid Grid.Row="2"
                                                                          Grid.ColumnSpan="2"
                                                                          Margin="0,14,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="10"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0"
                                                                                Padding="12,8"
                                                                                Style="{StaticResource ProfileScoreBandStyle}">
                                                                            <StackPanel>
                                                                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                                                           Margin="0,0,0,2"
                                                                                           Text="GAMERSCORE"/>
                                                                                <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                                           FontSize="{DynamicResource FontSizeBodyLarge}"
                                                                                           Foreground="{DynamicResource CloudBrush}"
                                                                                           Text="{Binding ScoreLabel}"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border Grid.Column="2"
                                                                                Padding="12,8"
                                                                                Style="{StaticResource ProfileScoreBandStyle}">
                                                                            <StackPanel>
                                                                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                                                           Margin="0,0,0,2"
                                                                                           Text="LIBRARY"/>
                                                                                <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                                                           FontSize="{DynamicResource FontSizeBodyLarge}"
                                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                           Text="{Binding LibraryCount, StringFormat={}{0} titles}"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                                         Value="True">
                                                                <Setter TargetName="FriendCardRoot"
                                                                        Property="BorderBrush"
                                                                        Value="{DynamicResource CloudBrush}"/>
                                                                <Setter TargetName="FriendCardRoot"
                                                                        Property="Background"
                                                                        Value="{DynamicResource ProfileCardBaseBrush}"/>
