                                       FontSize="{DynamicResource FontSizeStatMedium}" Text="Emulation Station" Margin="0,0,0,20"/>

                            <Border Style="{StaticResource PageHeroPanelStyle}" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="EMULATION STATION"/>
                                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding EmulatorMappingOverview}"/>
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="Detect installed emulators and RetroArch cores, then configure every platform from one place."
