<Window x:Class="CloudBerry.App.DuplicateOwnershipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:CloudBerry.App.Effects"
        Title="Cirra — Review Possible Duplicates"
        Icon="pack://application:,,,/Resources/Icons/cirra_app_icon_256.png"
        Width="720"
        Height="640"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <Rectangle Fill="{DynamicResource NostalgiaAtmosphereBrush}"
                   Opacity="0.85"
                   IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource AuroraVeilBrush}"
                   Opacity="0.12"
                   IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource NostalgiaScanlineBrush}"
                   Opacity="0.03"
                   IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource MatrixRainBrush}"
                   Opacity="{DynamicResource ThemeRainOverlayOpacity}"
                   IsHitTestVisible="False"/>
        <effects:ThemeEffectLayer ThemeKey="{Binding AppearanceThemeKey}"
                                  IsEffectActive="{Binding VisualEffectsEnabled}"
                                  Intensity="0.62"
                                  Opacity="0.36"
                                  IsHitTestVisible="False"/>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PanelBorderStyle}" Padding="18">
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Possible Duplicate Ownership"/>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Text="Cirra found these games under more than one source with the same title. Confirm the ones that are really the same game, or dismiss the ones that aren't — nothing is deleted or merged either way."/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,14,0,14">
                <Border Style="{StaticResource PanelBorderStyle}"
                        Visibility="{Binding HasGroups, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="14"
                                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding TitleSummary}"/>
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding MemberSummary}"/>
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Margin="14,0,0,0">
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Margin="0,0,8,0"
                                                        Click="DismissGroupClick"
                                                        Content="Not The Same Game"/>
                                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                                        Click="LinkGroupClick"
                                                        Content="Link As Same Game"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasGroups, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="All clear!"/>
                    <TextBlock Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="Nothing left to review right now."/>
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="2">
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseClick"
                            Content="Close"/>
                </WrapPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
