<Window x:Class="CloudBerry.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:CloudBerry.App.Effects"
        Title="Cirra" Icon="pack://application:,,,/Resources/Icons/cirra_app_icon_256.png"
        Width="760" Height="460" ResizeMode="NoResize" WindowStyle="None"
        Background="{DynamicResource AppBackgroundBrush}" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Opacity="0">
    <Border x:Name="RootBorder" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}"
            Background="{DynamicResource AppBackgroundBrush}">
        <Grid ClipToBounds="True">
            <effects:ThemeEffectLayer x:Name="Atmosphere" ThemeKey="{Binding ThemeKey}" EffectRole="Cloudscape"
                                      Quality="Balanced" Intensity="0.3" Opacity="0.3" IsHitTestVisible="False"/>
            <Button x:Name="CancelEntryButton" Content="Cancel" Visibility="Collapsed"
                    Panel.ZIndex="1"
                    Style="{StaticResource GhostButtonStyle}" Click="CancelEntryClick"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0"
                    AutomationProperties.Name="Cancel entering Horizon"/>
            <Grid Margin="52,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/Icons/cirra_app_icon_256.png"
                           Width="92" Height="92" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="BrandTitleText" Text="Cirra" Margin="0,16,0,0" FontSize="36"
                               FontFamily="{DynamicResource ThemeDisplayFontFamily}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="BrandSubtitleText" Text="Your games. Your space." Margin="0,6,0,0"
                               FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Grid Grid.Row="1" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/><RowDefinition Height="36"/><RowDefinition Height="4"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="StartupStatusText" Text="{Binding StatusText}" Margin="0,0,54,0"
                               TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ProgressLabel" Text="{Binding ProgressLabel}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="StartupDetailText" Grid.Row="1" Text="{Binding DetailText}" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    <ProgressBar x:Name="StartupProgressBar" Grid.Row="2" Minimum="0" Maximum="100" Value="8"
                                 Height="4" BorderThickness="0" Foreground="{DynamicResource CloudBrush}"
                                 Background="{DynamicResource BorderSubtleBrush}"/>
                    <ProgressBar x:Name="HorizonBusyBar" Grid.Row="2" Height="4" Visibility="Collapsed"
                                 Style="{StaticResource BusyBarStyle}" HorizontalAlignment="Stretch" Width="NaN" Margin="0"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
