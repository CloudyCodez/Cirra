<Window x:Class="CloudBerry.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:CloudBerry.App.Effects"
        Title="CloudBerry"
        Icon="pack://application:,,,/Resources/Icons/cloudberry_app_icon_256.png"
        Width="780"
        Height="460"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.42">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="18" To="0" Duration="0:0:0.42">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="IconBadge"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.82" To="1" Duration="0:0:0.42" BeginTime="0:0:0.08">
                        <DoubleAnimation.EasingFunction>
                            <BackEase Amplitude="0.35" EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="IconBadge"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.82" To="1" Duration="0:0:0.42" BeginTime="0:0:0.08">
                        <DoubleAnimation.EasingFunction>
                            <BackEase Amplitude="0.35" EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="IconBadge"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:0.08"/>
                    <DoubleAnimation Storyboard.TargetName="TitleBlock"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.26" BeginTime="0:0:0.16"/>
                    <DoubleAnimation Storyboard.TargetName="TaglineBlock"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.26" BeginTime="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="QuoteCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.28" BeginTime="0:0:0.26"/>
                    <DoubleAnimation Storyboard.TargetName="FooterPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.24" BeginTime="0:0:0.34"/>
                    <DoubleAnimation Storyboard.TargetName="ProgressGlow"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-160"
                                     To="780"
                                     Duration="0:0:2.4"
                                     RepeatBehavior="Forever"
                                     BeginTime="0:0:0.38"/>
                    <DoubleAnimation Storyboard.TargetName="ProgressGlow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.10" To="0.38" Duration="0:0:1.2"
                                     AutoReverse="True" RepeatBehavior="Forever"
                                     BeginTime="0:0:0.38"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder"
            CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            Background="{DynamicResource AppBackgroundBrush}">
        <Border.BorderBrush>
            <DynamicResource ResourceKey="ThemePanelBorderGradientBrush"/>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#14100A" BlurRadius="40" ShadowDepth="6" Opacity="0.54"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform Y="18"/>
        </Border.RenderTransform>

        <Grid ClipToBounds="True">
            <!-- Top shimmer rule — gold, extremely subtle -->
            <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.6">
                <Border.Background>
                    <DynamicResource ResourceKey="ThemeSweepBrush"/>
                </Border.Background>
            </Border>
            <!-- Theme texture -->
            <Rectangle Fill="{DynamicResource MatrixRainBrush}"
                       Opacity="0.05"
                       IsHitTestVisible="False"/>
            <!-- Scanlines -->
            <Rectangle Fill="{DynamicResource NostalgiaScanlineBrush}"
                       Opacity="0.03"
                       IsHitTestVisible="False"/>
            <effects:ThemeEffectLayer ThemeKey="{Binding ThemeKey}"
                                      Intensity="0.34"
                                      Opacity="0.28"
                                      CacheMode="BitmapCache"
                                      IsHitTestVisible="False"/>
            <!-- 2B/A2 YoRHa artwork — right side of splash, gradient fade -->
            <Grid IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="1"
                       Stretch="UniformToFill"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Right"
                       Opacity="{DynamicResource NierArtworkOpacity}"
                       CacheMode="BitmapCache"
                       RenderOptions.BitmapScalingMode="Fant"
                       Source="pack://application:,,,/Resources/Images/nier_theme.png">
                    <Image.OpacityMask>
                        <RadialGradientBrush Center="0.64,0.52"
                                             GradientOrigin="0.64,0.52"
                                             RadiusX="0.70"
                                             RadiusY="0.86">
                            <GradientStop Offset="0" Color="#FFFFFFFF"/>
                            <GradientStop Offset="0.58" Color="#B8FFFFFF"/>
                            <GradientStop Offset="0.86" Color="#32FFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </RadialGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Rectangle Grid.Column="1" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#E0D8D0BF"/>
                            <GradientStop Offset="0.34" Color="#46D8D0BF"/>
                            <GradientStop Offset="1" Color="#00D8D0BF"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Grid.Column="1" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#C8D8D0BF"/>
                            <GradientStop Offset="0.26" Color="#38D8D0BF"/>
                            <GradientStop Offset="1" Color="#00D8D0BF"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Image Grid.Column="1"
                       Stretch="UniformToFill"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Right"
                       Opacity="{DynamicResource WutheringArtworkOpacity}"
                       CacheMode="BitmapCache"
                       RenderOptions.BitmapScalingMode="Fant"
                       Source="pack://application:,,,/Resources/Images/wuwa_theme.jpg">
                    <Image.OpacityMask>
                        <RadialGradientBrush Center="0.58,0.52"
                                             GradientOrigin="0.58,0.52"
                                             RadiusX="0.86"
                                             RadiusY="0.82">
                            <GradientStop Offset="0" Color="#FFFFFFFF"/>
                            <GradientStop Offset="0.62" Color="#B8FFFFFF"/>
                            <GradientStop Offset="0.88" Color="#32FFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </RadialGradientBrush>
                    </Image.OpacityMask>
                </Image>
            </Grid>

            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBadge"
                            Width="58" Height="58"
                            Margin="0,3,20,0"
                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                            Background="{DynamicResource ThemePanelFillSoftBrush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            RenderTransformOrigin="0.5,0.5"
                            Opacity="0">
                        <Border.BorderBrush>
                            <DynamicResource ResourceKey="ThemePanelBorderGradientBrush"/>
                        </Border.BorderBrush>
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Image Stretch="UniformToFill"
                                   Margin="3"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="pack://application:,,,/Resources/Icons/cloudberry_app_icon_256.png"/>
                            <Rectangle Fill="{DynamicResource GlassSheenBrush}"
                                       Opacity="0.5"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TitleBlock"
                                   FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                   FontSize="32"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Opacity="0"
                                   Text="CloudBerry" />
                        <TextBlock x:Name="TaglineBlock"
                                   Margin="0,6,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Opacity="0"
                                   TextWrapping="Wrap"
                                   Text="Opening your library." />
                    </StackPanel>
                </Grid>

                        <Border x:Name="QuoteCard"
                        Grid.Row="1"
                        Margin="0,18,0,16"
                        Padding="16,14"
                        MinHeight="108"
                        Background="{DynamicResource ThemePanelFillSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                        ClipToBounds="True"
                        Opacity="0">
                        <Border.BorderBrush>
                            <DynamicResource ResourceKey="ThemePanelBorderGradientBrush"/>
                        </Border.BorderBrush>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel>
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Text="STARTING" />
                            <Border Margin="10,0,0,0" Padding="10,4"
                                    Background="{DynamicResource ThemeDeckFrameBrush}" CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                    BorderBrush="{DynamicResource ThemeDeckFrameBorderBrush}" BorderThickness="1">
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                           FontWeight="SemiBold" Text="{Binding QuoteDayLabel}" />
                            </Border>
                        </WrapPanel>

                        <Border Grid.Row="1"
                                Margin="0,16,0,0"
                                Padding="0,2,0,0"
                                ClipToBounds="True">
                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="20"
                                       MaxHeight="66"
                                       Text="{Binding QuoteText}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Footer / Progress -->
                <StackPanel x:Name="FooterPanel" Grid.Row="2" Opacity="0">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding StatusText}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding ProgressLabel}" />
                    </DockPanel>

                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               MaxHeight="34"
                               Text="{Binding DetailText}" />

                    <!-- Progress bar with animated sweep and gold track -->
                    <Grid Margin="0,14,0,0"
                          ClipToBounds="True">
                        <Border CornerRadius="2" Height="6" Background="{DynamicResource ThemePanelFillSoftBrush}"/>
                        <Border ClipToBounds="True" CornerRadius="2">
                                <ProgressBar x:Name="StartupProgressBar"
                                             Minimum="0" Maximum="100" Height="6"
                                             Value="8"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource ThemePrimaryButtonFillBrush}">
                                    <ProgressBar.Background>
                                        <SolidColorBrush Color="Transparent"/>
                                    </ProgressBar.Background>
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Border x:Name="PART_Track" Background="Transparent">
                                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                        Background="{TemplateBinding Foreground}"
                                                        CornerRadius="2"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>
                        </Border>
                        <Border x:Name="ProgressGlow"
                                Width="220"
                                HorizontalAlignment="Left"
                                CornerRadius="2" Height="6"
                                Opacity="0" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform X="-160"/>
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0"   Color="#00FFFFFF"/>
                                    <GradientStop Offset="0.42" Color="#C0FFFFFF"/>
                                    <GradientStop Offset="1"   Color="#00FFFFFF"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
