<Window x:Class="CloudBerry.App.MetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:CloudBerry.App.Effects"
        Title="Cirra Metadata Editor"
        Icon="pack://application:,,,/Resources/Icons/cirra_app_icon_256.png"
        Width="1320"
        Height="860"
        MinWidth="1020"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="MetadataEditorTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,6,0">
                            <Border x:Name="TabBg"
                                    Background="{DynamicResource ThemePanelFillSoftBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}"/>
                            <!-- Glass sheen overlay -->
                            <Border x:Name="TabSheen"
                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0"   Color="#28FFFFFF"/>
                                        <GradientStop Offset="0.5" Color="#00FFFFFF"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBg" Property="BorderBrush" Value="{DynamicResource ThemePanelEdgeBrush}"/>
                                <Setter TargetName="TabSheen" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBg" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
                                <Setter TargetName="TabBg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Offset="0"    Color="#52EEE4CC"/>
                                            <GradientStop Offset="0.42" Color="#2A2010"/>
                                            <GradientStop Offset="1"    Color="#1E1808"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="TabSheen" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="4" IsHitTestVisible="False">
            <Image Stretch="UniformToFill"
                   Opacity="0.08"
                   RenderOptions.BitmapScalingMode="LowQuality"
                   Source="{Binding SelectedGame.DisplayBackgroundImagePath, Converter={StaticResource StringToImageSourceConverter}}"/>
            <Rectangle Fill="{DynamicResource NostalgiaAtmosphereBrush}" Opacity="0.72"/>
            <Rectangle Fill="{DynamicResource ThemeShellPatternBrush}" Opacity="0.04"/>
            <effects:ThemeEffectLayer ThemeKey="{Binding AppearanceThemeKey}"
                                      IsEffectActive="{Binding VisualEffectsEnabled}"
                                      Intensity="0.58"
                                      Opacity="0.42"/>
        </Grid>

        <Border Grid.Row="0"
                Background="{DynamicResource BladeGlassBrush}"
                BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,18">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource GhostButtonStyle}"
                        Padding="14,8"
                        MinWidth="128"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12,0,0,0"
                        Click="CloseClick"
                        Content="Back to Library"/>
                <StackPanel>
                    <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                               FontSize="24"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Edit Game Metadata"/>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding MetadataStatusMessage}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="22,18,22,14"
                Style="{StaticResource PageHeroPanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource AccentPanelStyle}"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42"
                                Height="58"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                ClipToBounds="True">
                            <Image Stretch="UniformToFill"
                                   Source="{Binding SelectedGame.DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="EDITING"/>
                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding SelectedGame.Title, TargetNullValue='Select a library game'}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding SelectedGame.MetadataCoverageLabel, TargetNullValue='Metadata target not selected'}"
                                       TextTrimming="CharacterEllipsis"/>
							<TextBlock Margin="0,3,0,0"
							           FontSize="10"
							           Foreground="{DynamicResource MintBrush}"
							           Text="{Binding SelectedGame.MetadataTrustLabel, TargetNullValue='No field provenance yet'}"
							           TextTrimming="CharacterEllipsis"
							           ToolTip="Manual edits are protected from provider refreshes."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="SEARCH QUERY"/>
                    <TextBox x:Name="MetadataSearchBox"
                             Style="{StaticResource TextFieldStyle}"
                             Margin="0"
                             KeyDown="MetadataSearchBoxKeyDown"
                             Text="{Binding MetadataSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <DockPanel Margin="0,10,0,0" LastChildFill="True">
                        <Border DockPanel.Dock="Left"
                                Padding="10,4"
                                Margin="0,0,8,0"
                                Background="{DynamicResource ThemePanelFillSoftBrush}"
                                BorderBrush="{DynamicResource ThemePanelEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ThemeCornerRadiusPill}">
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="{Binding MetadataResultsCountLabel}"/>
                        </Border>
                        <Border DockPanel.Dock="Left"
                                Padding="10,4"
                                Margin="0,0,8,0"
                                Background="{DynamicResource ThemePanelFillSoftBrush}"
                                BorderBrush="{DynamicResource ThemePanelEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ThemeCornerRadiusPill}">
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedMetadataProvider.DisplayName}"/>
                        </Border>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   Text="{Binding MetadataResultsSummary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>

                <WrapPanel Grid.Column="3"
                           Margin="18,22,0,0"
                           VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Click="UseSelectedGameClick"
                            Content="Retarget Query"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Click="FillLibraryClick"
                            Content="Fill Missing"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Click="SearchClick"
                            Content="Search Web"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="22,0,22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="220" Width="0.95*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition MinWidth="340" Width="1.35*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition MinWidth="320" Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="MetadataPaneLibrary"
                    Grid.Column="0"
                    Style="{StaticResource PanelBorderStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Library Games"/>
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   Text="Pick a game here and keep the metadata workflow inside this window."
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox x:Name="LibraryGamesList"
                             Margin="0,14,0,0"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLength="1.5"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             SelectionChanged="LibraryGamesSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="LibraryGameCard"
                                        Margin="0,0,0,8"
                                        Padding="10"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="LibraryGameCardScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Border x:Name="LibraryGameCardHover"
                                                Background="{DynamicResource CardHoverBrush}"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Border x:Name="LibraryGameCardAccent"
                                                Width="3"
                                                Margin="-10,-10,0,-10"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource BerryBrush}"
                                                CornerRadius="2,0,0,2"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34"
                                                    Height="48"
                                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                    ClipToBounds="True">
                                                <Image Stretch="UniformToFill"
                                                       Source="{Binding DisplayCoverImagePath, Converter={StaticResource StringToImageSourceConverter}}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Text="{Binding MetadataCoverageLabel}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="LibraryGameCard" Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="LibraryGameCardHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="LibraryGameCardScale" Storyboard.TargetProperty="ScaleX" To="1.008" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="LibraryGameCardScale" Storyboard.TargetProperty="ScaleY" To="1.008" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="LibraryGameCardHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="LibraryGameCardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="LibraryGameCardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="LibraryGameCard" Property="BorderBrush" Value="{DynamicResource CloudBrush}"/>
                                        <Setter TargetName="LibraryGameCardAccent" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Cursor="Hand"/>

            <Border x:Name="MetadataPaneResults"
                    Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Search Results"/>
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   Text="{Binding MetadataResultsSummary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox x:Name="MetadataResultsList"
                             Margin="0,14,0,0"
                             ItemsSource="{Binding MetadataResults}"
                             SelectedItem="{Binding SelectedMetadataResult}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLength="1.5"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             SelectionChanged="MetadataResultsSelectionChanged"
                             PreviewKeyDown="MetadataResultsListPreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="MetadataResultCard"
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="MetadataResultCardScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Border x:Name="MetadataResultCardHover"
                                                Background="{DynamicResource CardHoverBrush}"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Border x:Name="MetadataResultCardAccent"
                                                Width="3"
                                                Margin="-12,-12,0,-12"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource BerryBrush}"
                                                CornerRadius="2,0,0,2"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="52"
                                                    Height="72"
                                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                                    CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                    ClipToBounds="True">
                                                <Image Stretch="UniformToFill"
                                                       Source="{Binding CoverImageUrl, Converter={StaticResource StringToImageSourceConverter}}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock FontWeight="SemiBold"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Text="{Binding ReleaseDateLabel}"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Text="{Binding ProviderName}"/>
                                                <TextBlock Margin="0,6,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding SummaryOrPlaceholder}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="42"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="MetadataResultCard" Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="MetadataResultCardHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="MetadataResultCardScale" Storyboard.TargetProperty="ScaleX" To="1.008" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="MetadataResultCardScale" Storyboard.TargetProperty="ScaleY" To="1.008" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="MetadataResultCardHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="MetadataResultCardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="MetadataResultCardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="MetadataResultCard" Property="BorderBrush" Value="{DynamicResource CloudBrush}"/>
                                        <Setter TargetName="MetadataResultCardAccent" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="8"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Cursor="Hand"/>

            <Border x:Name="MetadataPaneInspector"
                    Grid.Column="4"
                    Style="{StaticResource PanelBorderStyle}"
                    Padding="0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TabControl Grid.Row="0"
                                Margin="18,16,18,4"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource MetadataEditorTabItemStyle}">
                    <TabItem Header="General">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
                            <StackPanel>
                                <Border Height="224"
                                        Margin="0,0,0,16"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="LowQuality"
                                               Source="{Binding SelectedMetadataResult.HeroImageUrl, Converter={StaticResource StringToImageSourceConverter}}"/>
                                        <Rectangle Fill="{DynamicResource CardBottomOverlayBrush}"/>
                                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,14">
                                            <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                                       FontSize="22"
                                                       Foreground="{DynamicResource TextOnDarkBrush}"
                                                       Text="{Binding SelectedMetadataResult.Title, TargetNullValue='Select a result'}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextOnDarkBrush}"
                                                       FontSize="11"
                                                       Text="{Binding SelectedMetadataResult.ProviderName, TargetNullValue='Metadata source'}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <WrapPanel Margin="0,0,0,12">
                                    <Border Style="{StaticResource VisualFeaturePillStyle}">
                                        <TextBlock Foreground="{DynamicResource ThemePillLabelBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding SelectedMetadataResult.ReleaseDateLabel, TargetNullValue='Release unknown'}"/>
                                    </Border>
                                    <Border Style="{StaticResource VisualFeaturePillStyle}">
                                        <TextBlock Foreground="{DynamicResource ThemePillLabelBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding SelectedMetadataResult.RatingLabel, TargetNullValue='No community rating'}"/>
                                    </Border>
                                    <Border Style="{StaticResource VisualFeaturePillStyle}">
                                        <TextBlock Foreground="{DynamicResource ThemePillLabelBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding SelectedMetadataResult.MediaSummary, TargetNullValue='Media pending'}"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Text="{Binding SelectedMetadataResult.SummaryOrPlaceholder}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Media">
                        <ScrollViewer x:Name="MediaAssetsScrollViewer"
                                      VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      Padding="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Media Assets"/>
                                <TextBlock Margin="0,6,0,12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12"
                                           Text="Search and apply cover, background, banner, and icon art directly from here."
                                           TextWrapping="Wrap"/>

                                <Border Style="{StaticResource MediaAssetCardStyle}" Padding="0" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="12,12,12,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="COVER"/>
                                            <WrapPanel Grid.Column="1">
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Width="92" Padding="10,5" Margin="0,0,6,0" Click="BrowseCoverFileClick" Content="Local File"/>
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Width="92" Padding="10,5" Click="SearchCoverMediaClick" Content="Search Web"/>
                                            </WrapPanel>
                                        </Grid>
                                        <Border Height="184" Margin="12,0,12,12" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="{DynamicResource ThemeCornerRadiusControl}" ClipToBounds="True">
                                            <Image Stretch="Uniform" Source="{Binding SelectedMetadataResult.CoverImageUrl, Converter={StaticResource StringToImageSourceConverter}}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MediaAssetCardStyle}" Padding="0" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="12,12,12,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="BACKGROUND"/>
                                            <WrapPanel Grid.Column="1">
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Width="92" Padding="10,5" Margin="0,0,6,0" Click="BrowseBackgroundFileClick" Content="Local File"/>
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Width="92" Padding="10,5" Click="SearchBackgroundMediaClick" Content="Search Web"/>
                                            </WrapPanel>
                                        </Grid>
                                        <Border Height="136" Margin="12,0,12,12" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="{DynamicResource ThemeCornerRadiusControl}" ClipToBounds="True">
                                            <Image Stretch="Uniform" Source="{Binding SelectedMetadataResult.BackgroundImageUrl, Converter={StaticResource StringToImageSourceConverter}}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MediaAssetCardStyle}" Padding="0" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="12,12,12,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="BANNER"/>
                                            <WrapPanel Grid.Column="1">
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Width="92" Padding="10,5" Margin="0,0,6,0" Click="BrowseBannerFileClick" Content="Local File"/>
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Width="92" Padding="10,5" Click="SearchBannerMediaClick" Content="Search Web"/>
                                            </WrapPanel>
                                        </Grid>
                                        <Border Height="96" Margin="12,0,12,12" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="{DynamicResource ThemeCornerRadiusControl}" ClipToBounds="True">
                                            <Image Stretch="Uniform" Source="{Binding SelectedMetadataResult.BannerImageUrl, Converter={StaticResource StringToImageSourceConverter}}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MediaAssetCardStyle}" Padding="0">
                                    <StackPanel>
                                        <Grid Margin="12,12,12,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ICON"/>
                                            <WrapPanel Grid.Column="1">
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Width="92" Padding="10,5" Margin="0,0,6,0" Click="BrowseIconFileClick" Content="Local File"/>
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Width="92" Padding="10,5" Click="SearchIconMediaClick" Content="Search Web"/>
                                            </WrapPanel>
                                        </Grid>
                                        <Border Height="96" Margin="12,0,12,12" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="{DynamicResource ThemeCornerRadiusControl}" ClipToBounds="True">
                                            <Image Stretch="Uniform" Source="{Binding SelectedMetadataResult.IconImageUrl, Converter={StaticResource StringToImageSourceConverter}}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Links">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Metadata Links"/>
                                <Border Style="{StaticResource FeatureDetailCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PROVIDER"/>
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding SelectedMetadataResult.ProviderItemUrl, TargetNullValue='Provider link appears here'}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabelStyle}" Text="OFFICIAL WEBSITE"/>
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding SelectedMetadataResult.WebsiteUrl, TargetNullValue='Official website appears here'}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    </TabControl>

                    <!-- Persistent Apply bar — lives outside the TabControl so it's visible on General, Media, AND Links.
                         Previously this was only inside the General tab's ScrollViewer, so switching to Media or Links
                         (or even just scrolling General) hid the one control that actually commits a pick to the game. -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource ThemePanelFillSoftBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedMetadataResult.Title, TargetNullValue='Pick a search result to apply', StringFormat='Applying: {0}'}"/>
                            <WrapPanel Grid.Column="1">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="14,8"
                                        Margin="0,0,8,0"
                                        Click="ApplyInlineClick"
                                        ToolTip="Apply this result's metadata to the selected game and keep working here"
                                        Content="Apply"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14,8"
                                        Click="ApplyClick"
                                        ToolTip="Apply and return to the library"
                                        Content="Apply &amp; Close"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,10">
            <Grid>
                <Rectangle Height="1"
                           VerticalAlignment="Top"
                           Fill="{DynamicResource BerryBrush}"
                           Opacity="0.35"/>
                <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding MetadataStatusMessage}"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
