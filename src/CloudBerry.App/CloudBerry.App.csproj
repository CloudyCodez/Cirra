<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CloudBerry.Core\CloudBerry.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="CompanionTools\title_cleaner.py"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="CompanionTools\library_insights.mjs"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\cloudberry_app_icon_256.png" />
    <Resource Include="Resources\Images\nier_theme.png" />
    <Resource Include="Resources\Images\wuwa_theme.jpg" />
    <Resource Include="Resources\Images\yuji*.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CloudBerry</AssemblyName>
    <AssemblyTitle>CloudBerry</AssemblyTitle>
    <Product>CloudBerry</Product>
    <Company>CloudBerry</Company>
    <Authors>CloudBerry</Authors>
    <Description>CloudBerry is a polished universal game library for Windows, ROM collections, and launcher discovery.</Description>
    <Version>0.2.0.1</Version>
    <AssemblyVersion>0.2.0.1.0</AssemblyVersion>
    <FileVersion>0.2.0.1.0</FileVersion>
    <InformationalVersion>0.2.0.1</InformationalVersion>
    <ApplicationIcon>Resources\Icons\cloudberry_app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Self-contained single-file publish defaults (used by publish.bat) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
