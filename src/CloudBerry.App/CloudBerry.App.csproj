<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CloudBerry.Core\CloudBerry.Core.csproj" />
    <ProjectReference Include="..\CloudBerry.Data\CloudBerry.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="PDFiumSharp" Version="1.4660.0-alpha1" />
    <PackageReference Include="PDFiumSharp.Wpf" Version="1.4660.0-alpha1" />
    <PackageReference Include="PDFiumSharp.NativeBinaries" Version="1.4660.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeCompanionTools)' != 'false'">
    <Content Include="CompanionTools\title_cleaner.py"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="CompanionTools\library_insights.mjs"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\cirra_app_icon_1024.png" />
    <Resource Include="Resources\Icons\cirra_app_icon_256.png" />
    <Resource Include="Resources\Images\nier_theme.png" />
    <Resource Include="Resources\Images\wuwa_theme.jpg" />
    <Resource Include="Resources\Images\yuji*.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Cirra</AssemblyName>
    <AssemblyTitle>Cirra</AssemblyTitle>
    <Product>Cirra</Product>
    <Company>Cirra</Company>
    <Authors>Cirra</Authors>
    <Description>Cirra is a premium universal game library for Windows, ROM collections, and launcher discovery.</Description>
    <Version>0.4.3</Version>
    <AssemblyVersion>0.4.3.0</AssemblyVersion>
    <FileVersion>0.4.3.0</FileVersion>
    <InformationalVersion>0.4.3</InformationalVersion>
    <ApplicationIcon>Resources\Icons\cirra_app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Self-contained single-file publish defaults (used by publish.bat) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
