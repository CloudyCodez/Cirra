<Window x:Class="CloudBerry.App.MediaSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:CloudBerry.App.Effects"
        Title="CloudBerry Media Search"
        Icon="pack://application:,,,/Resources/Icons/cloudberry_app_icon_256.png"
        Width="1280"
        Height="860"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Grid.RowSpan="3"
               Stretch="UniformToFill"
               Opacity="0.08"
               IsHitTestVisible="False"
               Source="{Binding SelectedMediaSearchResult.ImageUrl, Converter={StaticResource StringToImageSourceConverter}}"/>
        <Rectangle Grid.RowSpan="3"
                   Fill="{DynamicResource NostalgiaAtmosphereBrush}"
                   Opacity="0.74"
                   IsHitTestVisible="False"/>
        <Rectangle Grid.RowSpan="3"
                   Fill="{DynamicResource NostalgiaScanlineBrush}"
                   Opacity="0.02"
                   IsHitTestVisible="False"/>
        <Rectangle Grid.RowSpan="3"
                   Fill="{DynamicResource MatrixRainBrush}"
                   Opacity="{DynamicResource ThemeRainOverlayOpacity}"
                   IsHitTestVisible="False"/>
        <Rectangle Grid.RowSpan="3"
                   Fill="{DynamicResource AuroraVeilBrush}"
                   Opacity="0.1"
                   IsHitTestVisible="False"/>
        <effects:ThemeEffectLayer Grid.RowSpan="3"
                                  ThemeKey="{Binding AppearanceThemeKey}"
                                  IsEffectActive="{Binding VisualEffectsEnabled}"
                                  Intensity="0.62"
                                  Opacity="0.44"
                                  IsHitTestVisible="False"/>
        <Rectangle x:Name="MediaSweepLight"
                   Grid.RowSpan="3"
                   Width="300"
                   HorizontalAlignment="Left"
                   Fill="{DynamicResource ThemeSweepBrush}"
                   Opacity="{DynamicResource ThemeSweepOverlayOpacity}"
                   IsHitTestVisible="False">
            <Rectangle.RenderTransform>
                <TranslateTransform X="-360"/>
            </Rectangle.RenderTransform>
            <Rectangle.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="MediaSweepLight"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                             From="-360"
                                             To="1380"
                                             Duration="0:0:14"/>
                            <DoubleAnimation Storyboard.TargetName="MediaSweepLight"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.02"
                                             To="0.08"
                                             AutoReverse="True"
                                             Duration="0:0:7"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Rectangle.Triggers>
            <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#00FFFFFF"/>
                    <GradientStop Offset="0.5" Color="#FFFFFFFF"/>
                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                </LinearGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <Border Grid.Row="0"
                Background="{DynamicResource BladeGlassBrush}"
                BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="CancelClick"
                        Content="Close"/>
                <StackPanel>
                    <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                               FontSize="24"
                               Style="{StaticResource MatrixTitleTextStyle}"
                               Text="Media Search"/>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding MediaSearchStatusMessage}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="26" ClipToBounds="True">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MediaSearchTopBar" Storyboard.TargetProperty="Opacity" From="0.82" To="1" Duration="0:0:0.18" BeginTime="0:0:0.00"/>
                            <DoubleAnimation Storyboard.TargetName="MediaSearchTopBarLift" Storyboard.TargetProperty="Y" From="8" To="0" Duration="0:0:0.22" BeginTime="0:0:0.00"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MediaSearchResultsPane" Storyboard.TargetProperty="Opacity" From="0.82" To="1" Duration="0:0:0.18" BeginTime="0:0:0.05"/>
                            <DoubleAnimation Storyboard.TargetName="MediaSearchResultsPaneLift" Storyboard.TargetProperty="Y" From="8" To="0" Duration="0:0:0.24" BeginTime="0:0:0.05"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MediaSearchPreviewPane" Storyboard.TargetProperty="Opacity" From="0.82" To="1" Duration="0:0:0.18" BeginTime="0:0:0.10"/>
                            <DoubleAnimation Storyboard.TargetName="MediaSearchPreviewPaneLift" Storyboard.TargetProperty="Y" From="8" To="0" Duration="0:0:0.26" BeginTime="0:0:0.10"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="MediaSearchTopBar"
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource PageHeroPanelStyle}"
                    Margin="0,0,0,16"
                    Opacity="1"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MediaSearchTopBarLift" Y="10"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="SEARCH TITLE"/>
                        <TextBox x:Name="MediaSearchBox"
                                 Style="{StaticResource TextFieldStyle}"
                                 Margin="0"
                                 KeyDown="MediaSearchBoxKeyDown"
                                 Text="{Binding MediaSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource ShellStatusChipStyle}">
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedMediaSearchKind}"/>
                            </Border>
                            <Border Style="{StaticResource ShellStatusChipStyle}">
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="Enter to search • double-click to apply"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="TARGET"/>
                        <Border Style="{StaticResource AccentPanelStyle}"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedMediaSearchKind}"/>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           Text="{Binding PreferredMediaResolutionLabel}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <WrapPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="16,0,0,0">
                        <ProgressBar Style="{StaticResource BusyBarStyle}"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsMetadataBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="SearchClick"
                                Content="Search Again"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Click="SelectClick"
                                Content="Apply Selection"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border x:Name="MediaSearchResultsPane"
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource PanelBorderStyle}"
                    Opacity="1"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MediaSearchResultsPaneLift" Y="12"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource SectionHeadingStyle}"
                                   Text="Search Results"/>
                        <Border DockPanel.Dock="Right"
                                Padding="10,4"
                                CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="{Binding MediaSearchResults.Count, StringFormat={}{0} results}"/>
                        </Border>
                    </DockPanel>
                    <ListBox x:Name="MediaResultsList"
                             Grid.Row="1"
                             Margin="0,16,0,0"
                             ItemsSource="{Binding MediaSearchResults}"
                             SelectedItem="{Binding SelectedMediaSearchResult}"
                             BorderThickness="0"
                             Background="Transparent"
                             MouseDoubleClick="ResultDoubleClick"
                             PreviewKeyDown="MediaResultsListPreviewKeyDown"
                             KeyboardNavigation.DirectionalNavigation="Contained"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLength="1.5"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ImageCard"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,12"
                                        Padding="10"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ImgCardScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="ImgCardShadow" Color="{DynamicResource ThemePanelShadowColor}"
                                                         BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                    </Border.Effect>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ImgCardScale"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     To="1.008" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="ImgCardScale"
                                                                     Storyboard.TargetProperty="ScaleY"
                                                                     To="1.008" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="ImgCardShadow"
                                                                     Storyboard.TargetProperty="BlurRadius"
                                                                     To="8" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="ImgCardShadow"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0.18" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="ImgCardHoverOverlay"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Border.MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ImgCardScale"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     To="1" Duration="0:0:0.16"/>
                                                    <DoubleAnimation Storyboard.TargetName="ImgCardScale"
                                                                     Storyboard.TargetProperty="ScaleY"
                                                                     To="1" Duration="0:0:0.16"/>
                                                    <DoubleAnimation Storyboard.TargetName="ImgCardShadow"
                                                                     Storyboard.TargetProperty="BlurRadius"
                                                                     To="0" Duration="0:0:0.16"/>
                                                    <DoubleAnimation Storyboard.TargetName="ImgCardShadow"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.16"/>
                                                    <DoubleAnimation Storyboard.TargetName="ImgCardHoverOverlay"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.16"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="ImgCardHoverOverlay"
                                                Grid.ColumnSpan="2"
                                                Background="{DynamicResource CardHoverBrush}"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Border x:Name="ImgCardSelectionPlate"
                                                Grid.ColumnSpan="2"
                                                Background="{DynamicResource BerryDimBrush}"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Border x:Name="ImgCardSelectionRim"
                                                Grid.ColumnSpan="2"
                                                BorderBrush="{DynamicResource BerryBrush}"
                                                BorderThickness="2"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Border x:Name="ImgCardFocusRim"
                                                Grid.ColumnSpan="2"
                                                BorderBrush="{DynamicResource CloudBrush}"
                                                BorderThickness="2"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Border x:Name="ImgCardAccent"
                                                Width="3"
                                                Margin="-10,-10,0,-10"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource BerryBrush}"
                                                CornerRadius="2,0,0,2"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Border Height="132"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                ClipToBounds="True"
                                                Background="{DynamicResource SurfaceElevatedBrush}">
                                            <Image Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="LowQuality"
                                                   Source="{Binding ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding FitLabel}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <WrapPanel Margin="0,8,0,4">
                                                <Border Margin="0,0,6,6"
                                                        Padding="8,3"
                                                        CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding ResolutionLabel}"/>
                                                </Border>
                                                <Border Margin="0,0,6,6"
                                                        Padding="8,3"
                                                        CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                                        Background="{DynamicResource CloudDimBrush}"
                                                        BorderBrush="{DynamicResource CloudBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Foreground="{DynamicResource CloudBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding ScoreLabel}"/>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11"
                                                       Text="{Binding SourceSummary}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="38"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsKeyboardFocusWithin}" Value="True">
                                            <Setter TargetName="ImgCardFocusRim" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <Setter TargetName="ImageCard" Property="BorderBrush" Value="{DynamicResource BerryBrush}"/>
                                            <Setter TargetName="ImgCardSelectionPlate" Property="Opacity" Value="1"/>
                                            <Setter TargetName="ImgCardSelectionRim" Property="Opacity" Value="1"/>
                                            <Setter TargetName="ImgCardAccent" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1"
                            Margin="0,16,0,0"
                            Style="{StaticResource InsetCardStyle}"
                            Visibility="{Binding HasMediaSearchResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="32">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                       FontSize="20"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="No artwork yet"/>
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="Try a simpler title, or switch to a more specific media type like cover or background."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="360"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="MediaSearchPreviewPane"
                    Grid.Row="1"
                    Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}"
                    Opacity="1"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MediaSearchPreviewPaneLift" Y="12"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Preview"/>
                    <Border Grid.Row="1"
                            Margin="0,16,0,0"
                            CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
                            ClipToBounds="True"
                            Background="{DynamicResource SurfaceElevatedBrush}">
                        <Grid>
                            <Image Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="LowQuality"
                                   Source="{Binding SelectedMediaSearchResult.ImageUrl, Converter={StaticResource StringToImageSourceConverter}}"/>
                            <Rectangle Fill="{DynamicResource AuroraVeilBrush}" Opacity="0.06"/>
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="Select an image to preview"
                                       Visibility="{Binding HasSelectedMediaSearchResult, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedMediaSearchResult.ResolutionLabel, TargetNullValue='No image selected'}"/>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding SelectedMediaSearchResult.FitSummary, TargetNullValue='Choose from the results grid'}"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Border Margin="0,0,8,8"
                                    Padding="10,4"
                                    CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1">
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedMediaSearchResult.AspectRatioLabel, TargetNullValue='Aspect unknown'}"/>
                            </Border>
                            <Border Margin="0,0,8,8"
                                    Padding="10,4"
                                    CornerRadius="{DynamicResource ThemeCornerRadiusPill}"
                                    Background="{DynamicResource CloudDimBrush}"
                                    BorderBrush="{DynamicResource CloudBrush}"
                                    BorderThickness="1">
                                <TextBlock Foreground="{DynamicResource CloudBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedMediaSearchResult.ScoreLabel, TargetNullValue='0% match'}"/>
                            </Border>
                        </WrapPanel>
                        <Border Style="{StaticResource FeatureDetailCardStyle}"
                                Margin="0,14,0,0"
                                Visibility="{Binding HasSelectedMediaSearchResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="SOURCE NOTES"/>
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding SelectedMediaSearchResult.SourceSummary}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           Text="{Binding SelectedMediaSearchResult.FitSummary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding PreferredMediaResolutionLabel}"/>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="OpenImageClick"
                                    Content="Open Full Image"/>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="OpenSourceClick"
                                    Content="Open Source Page"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="SelectClick"
                                    Content="Apply Selection"/>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Click="CancelClick"
                                    Content="Cancel"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                Padding="24,10"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}">
            <Grid>
                <Border Height="1" VerticalAlignment="Top" Margin="0,-1,0,0" Background="{DynamicResource CloudBrush}" Opacity="0.35" IsHitTestVisible="False"/>
                <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding MediaSearchStatusMessage}"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
