<Window x:Class="CloudBerry.App.CleanMissingPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:CloudBerry.App.Effects"
        Title="Cirra — Clean Missing Entries"
        Icon="pack://application:,,,/Resources/Icons/cirra_app_icon_256.png"
        Width="720"
        Height="640"
        MinWidth="560"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <Rectangle Fill="{DynamicResource NostalgiaAtmosphereBrush}"
                   Opacity="0.85"
                   IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource AuroraVeilBrush}"
                   Opacity="0.12"
                   IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource NostalgiaScanlineBrush}"
                   Opacity="0.03"
                   IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource MatrixRainBrush}"
                   Opacity="{DynamicResource ThemeRainOverlayOpacity}"
                   IsHitTestVisible="False"/>
        <effects:ThemeEffectLayer ThemeKey="{Binding AppearanceThemeKey}"
                                  IsEffectActive="{Binding VisualEffectsEnabled}"
                                  Intensity="0.62"
                                  Opacity="0.36"
                                  IsHitTestVisible="False"/>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PanelBorderStyle}" Padding="18">
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Clean Missing Entries"/>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               x:Name="SummaryText"
                               Text="Cirra found library entries whose launch files or folders no longer exist. Uncheck anything you want to keep, then confirm removal."/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,14,0,14"
                    Style="{StaticResource PanelBorderStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"
                                   Text="DETECTED MISSING ENTRIES"/>
                        <Button Margin="16,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="SelectAllClick"
                                Content="Select All"/>
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="SelectNoneClick"
                                Content="Select None"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="EntriesList" ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="12"
                                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding Title}"/>
                                                <TextBlock Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="12"
                                                           Text="{Binding Platform}"/>
                                                <TextBlock Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding InstallPath}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           x:Name="SelectionCountText"
                           Text=""/>
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="CancelClick"
                            Content="Cancel"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Click="RemoveSelectedClick"
                            Content="Remove Selected"/>
                </WrapPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
