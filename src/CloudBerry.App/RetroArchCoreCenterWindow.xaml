<Window x:Class="CloudBerry.App.RetroArchCoreCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:CloudBerry.App.Effects"
        Title="CloudBerry RetroArch Core Center"
        Icon="pack://application:,,,/Resources/Icons/cloudberry_app_icon_256.png"
        Width="980"
        Height="700"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <Rectangle Fill="{DynamicResource NostalgiaAtmosphereBrush}"
                   Opacity="0.85"
                   IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource AuroraVeilBrush}"
                   Opacity="0.12"
                   IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource NostalgiaScanlineBrush}"
                   Opacity="0.03"
                   IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource MatrixRainBrush}"
                   Opacity="{DynamicResource ThemeRainOverlayOpacity}"
                   IsHitTestVisible="False"/>
        <effects:ThemeEffectLayer ThemeKey="{Binding AppearanceThemeKey}"
                                  IsEffectActive="{Binding VisualEffectsEnabled}"
                                  Intensity="0.62"
                                  Opacity="0.36"
                                  IsHitTestVisible="False"/>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorderStyle}" Padding="18">
        <StackPanel>
            <TextBlock FontSize="22"
                       FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="RetroArch Core Center"/>
            <TextBlock Margin="0,6,0,0"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding RetroArchDetectionSummary}"/>
        </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="INSTALLED CORES"/>
                    <ListBox ItemsSource="{Binding RetroArchInstalledCores}"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6"
                                        Padding="10,8"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                        BorderThickness="1"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <Grid>
                                        <!-- Theme-safe hover: opacity-animated overlay, never an animated literal Color -->
                                        <Border x:Name="CoreRowHover"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                Background="{DynamicResource CardHoverBrush}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE7FC;"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource BerryDimBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CoreRowHover"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Border.MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CoreRowHover"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.18"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="SUGGESTED PLATFORM MAPPINGS"/>
                    <ListBox ItemsSource="{Binding RetroArchSuggestions}"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                        Padding="10"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <!-- Theme-safe hover glow — opacity-animated overlay, matches ScanPreviewWindow pattern -->
                                        <Border x:Name="SuggestionHover"
                                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                                Background="{DynamicResource CardHoverBrush}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <!-- Left accent bar in BerryBrush, appears on hover for a bit of life -->
                                        <Border x:Name="SuggestionAccent"
                                                Width="3"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource BerryBrush}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Platform}"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding CoreName}"/>
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding CorePath}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="SuggestionHover"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="SuggestionAccent"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     To="1.008" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     To="1.008" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Border.MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="SuggestionHover"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.18"/>
                                                    <DoubleAnimation Storyboard.TargetName="SuggestionAccent"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.18"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     To="1" Duration="0:0:0.18"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     To="1" Duration="0:0:0.18"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2">
            <WrapPanel DockPanel.Dock="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="RefreshClick"
                        Content="Refresh Cores"/>
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Click="ApplyMappingsClick"
                        Content="Apply Mappings"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
    </Grid>
</Window>
