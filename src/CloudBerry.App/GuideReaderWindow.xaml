<Window x:Class="CloudBerry.App.GuideReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cirra Guide Reader"
        Icon="pack://application:,,,/Resources/Icons/cirra_app_icon_256.png"
        Width="1280" Height="860" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBarDrag">
            <Grid Margin="18,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="GuideTitleText"
                               FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="GuideContextText"
                               Margin="0,2,0,0" FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SourceButton"
                            Margin="8,8,10,8" Padding="12,0"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="OpenSourceClick"
                            Content="Source"/>
                    <Button Width="46" Content="&#xE921;" ToolTip="Minimize"
                            Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeClick"/>
                    <Button Width="46" Content="&#xE922;" ToolTip="Maximize or restore"
                            Style="{StaticResource WindowControlButtonStyle}" Click="MaximizeClick"/>
                    <Button Width="46" Content="&#xE8BB;" ToolTip="Close reader"
                            Style="{StaticResource WindowControlCloseButtonStyle}" Click="CloseClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#111315" KeyDown="ReaderKeyDown" Focusable="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontFamily="Segoe Fluent Icons">
                        <Button x:Name="FirstSpreadButton" FontFamily="Segoe MDL2 Assets" Width="38" Content="&#xE892;" ToolTip="First page" Style="{StaticResource GhostButtonStyle}" Click="FirstSpreadClick"/>
                        <Button x:Name="PreviousSpreadButton" FontFamily="Segoe MDL2 Assets" Width="38" Margin="6,0,0,0" Content="&#xE76B;" ToolTip="Previous pages" Style="{StaticResource GhostButtonStyle}" Click="PreviousSpreadClick"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="PageCounterText" Text="Preparing pages" VerticalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="PageJumpInput" Width="54" Height="24" MinHeight="0" Padding="4,0" Margin="12,0,0,0" VerticalContentAlignment="Center" Text="1" MaxLength="7" ToolTip="Go to PDF page" AutomationProperties.Name="Go to PDF page" KeyDown="PageJumpKeyDown"/>
                            <Button x:Name="PageJumpButton" Width="28" MinHeight="0" Height="24" Padding="0" Margin="4,0,0,0" FontFamily="Segoe MDL2 Assets" Content="&#xE72A;" ToolTip="Go to page" AutomationProperties.Name="Go to page" Style="{StaticResource GhostButtonStyle}" Click="PageJumpClick"/>
                        </StackPanel>
                        <CheckBox x:Name="FacingPagesToggle" Content="Facing pages" Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="10" Checked="FacingPagesChanged" Unchecked="FacingPagesChanged" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" TextElement.FontFamily="Segoe Fluent Icons">
                        <Button x:Name="NextSpreadButton" FontFamily="Segoe MDL2 Assets" Width="38" Content="&#xE76C;" ToolTip="Next pages" Style="{StaticResource GhostButtonStyle}" Click="NextSpreadClick"/>
                        <Button x:Name="LastSpreadButton" FontFamily="Segoe MDL2 Assets" Width="38" Margin="6,0,0,0" Content="&#xE893;" ToolTip="Last page" Style="{StaticResource GhostButtonStyle}" Click="LastSpreadClick"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" x:Name="BookStage" Margin="28,18,28,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="LeftPageFrame" Margin="0,0,3,0" Padding="8" Background="#F5F1E8" BorderBrush="#604C4438" BorderThickness="1" CornerRadius="4,0,0,4">
                    <Image x:Name="LeftPageImage" Stretch="Uniform" SnapsToDevicePixels="True"/>
                </Border>
                <Border Grid.Column="1" Background="#30101010"/>
                <Border x:Name="RightPageFrame" Grid.Column="2" Margin="3,0,0,0" Padding="8" Background="#F5F1E8" BorderBrush="#604C4438" BorderThickness="1" CornerRadius="0,4,4,0">
                    <Image x:Name="RightPageImage" Stretch="Uniform" SnapsToDevicePixels="True"/>
                </Border>
            </Grid>
            <Border x:Name="ReaderStatusPanel" Grid.RowSpan="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="520" Padding="28,24"
                    CornerRadius="{DynamicResource ThemeCornerRadiusLarge}"
                    Background="{DynamicResource GlassButtonFillBrush}"
                    BorderBrush="{DynamicResource GlassButtonBorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                               FontSize="30" HorizontalAlignment="Center"
                               Foreground="{DynamicResource CloudBrush}" Text="&#xE8A5;"/>
                    <TextBlock x:Name="ReaderStatusText"
                               Margin="0,14,0,0" TextAlignment="Center"
                               TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Opening the original PDF..."/>
                    <Button x:Name="RetryButton" Content="Retry" Margin="0,16,0,0"
                            HorizontalAlignment="Center" Visibility="Collapsed"
                            Style="{StaticResource SecondaryButtonStyle}" Click="RetryClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
