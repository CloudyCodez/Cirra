<Window x:Class="CloudBerry.App.RestoreBackupPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:CloudBerry.App.Effects"
        Title="Cirra — Restore Library"
        Icon="pack://application:,,,/Resources/Icons/cirra_app_icon_256.png"
        Width="640"
        Height="480"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <Rectangle Fill="{DynamicResource NostalgiaAtmosphereBrush}"
                   Opacity="0.85"
                   IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource AuroraVeilBrush}"
                   Opacity="0.12"
                   IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource NostalgiaScanlineBrush}"
                   Opacity="0.03"
                   IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource MatrixRainBrush}"
                   Opacity="{DynamicResource ThemeRainOverlayOpacity}"
                   IsHitTestVisible="False"/>
        <effects:ThemeEffectLayer ThemeKey="{Binding AppearanceThemeKey}"
                                  IsEffectActive="{Binding VisualEffectsEnabled}"
                                  Intensity="0.62"
                                  Opacity="0.36"
                                  IsHitTestVisible="False"/>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PanelBorderStyle}" Padding="18">
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Restore Library From Backup"/>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Text="Review what's in this file before Cirra replaces your current library with it."/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,14,0,14"
                    Style="{StaticResource PanelBorderStyle}">
                <StackPanel Margin="4">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="RESTORING FROM"/>
                    <TextBlock Margin="0,4,0,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding SourceFileName}"/>
                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding SourceFilePath}"/>

                    <TextBlock Margin="0,20,0,0" Style="{StaticResource FieldLabelStyle}" Text="THIS BACKUP CONTAINS"/>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap">
                        <Run Text="{Binding GameCountLabel, Mode=OneWay}"/>
                        <Run Text=", saved on "/>
                        <Run Text="{Binding SavedAtLabel, Mode=OneWay}"/>
                        <Run Text="."/>
                    </TextBlock>

                    <Border Margin="0,20,0,0"
                            Padding="12"
                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap">
                                <Run Text="Your current library ("/>
                                <Run Text="{Binding CurrentLibraryLabel, Mode=OneWay}"/>
                                <Run Text=") will be replaced."/>
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="Cirra will automatically back up what you have now before restoring, so this isn't a one-way trip if you picked the wrong file. Cirra will restart itself right after to load the restored library cleanly."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="2">
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="CancelClick"
                            Content="Cancel"/>
                    <Button x:Name="RestoreButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="RestoreClick"
                            Content="Restore And Restart"/>
                </WrapPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
