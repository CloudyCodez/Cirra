<Window x:Class="CloudBerry.App.AccessGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloudBerry"
        Icon="pack://application:,,,/Resources/Icons/cloudberry_app_icon_256.png"
        Width="560"
        Height="440"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Opacity="0">

    <Window.Resources>
        <Storyboard x:Key="KeyFieldShakeStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KeyFieldShakeTransform"
                                           Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="-8"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.10" Value="7"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="-6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.20" Value="5"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="-3"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="16" To="0" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder"
            CornerRadius="{DynamicResource ThemeCornerRadiusPanel}"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            Background="{DynamicResource AppBackgroundBrush}"
            MouseLeftButtonDown="RootBorderMouseLeftButtonDown">
        <Border.BorderBrush>
            <DynamicResource ResourceKey="ThemePanelBorderGradientBrush"/>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#14100A" BlurRadius="40" ShadowDepth="6" Opacity="0.54"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform Y="16"/>
        </Border.RenderTransform>

        <Grid ClipToBounds="True">
            <!-- Top shimmer rule, matching the splash screen's chrome -->
            <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.6">
                <Border.Background>
                    <DynamicResource ResourceKey="ThemeSweepBrush"/>
                </Border.Background>
            </Border>
            <Rectangle Fill="{DynamicResource NostalgiaScanlineBrush}" Opacity="0.03" IsHitTestVisible="False"/>

            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: icon + title + close -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44"
                            Margin="0,0,16,0"
                            CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                            Background="{DynamicResource ThemePanelFillSoftBrush}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Border.BorderBrush>
                            <DynamicResource ResourceKey="ThemePanelBorderGradientBrush"/>
                        </Border.BorderBrush>
                        <Image Stretch="UniformToFill"
                               Margin="2"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/Resources/Icons/cloudberry_app_icon_256.png"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Private Testing"/>
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="CloudBerry isn't public yet."/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource WindowControlCloseButtonStyle}"
                            Click="ExitClick"
                            Content="&#xE8BB;"
                            VerticalAlignment="Top"/>
                </Grid>

                <!-- Explanation -->
                <TextBlock Grid.Row="1"
                           Margin="0,20,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           LineStackingStrategy="BlockLineHeight"
                           Text="You're opening a private testing build. Enter the personal access key you were given below. It's tied to this key and this computer, and only needs to be entered once - CloudBerry will remember it for every launch after this."/>

                <!-- Key field -->
                <StackPanel Grid.Row="2" Margin="0,22,0,0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ACCESS KEY" Margin="0,0,0,7"/>
                    <Border x:Name="KeyFieldBorder" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="KeyFieldShakeTransform" X="0"/>
                        </Border.RenderTransform>
                        <TextBox x:Name="KeyInput"
                                 Style="{StaticResource TextFieldStyle}"
                                 FontSize="15"
                                 Padding="12,10"
                                 KeyDown="KeyInputKeyDown"
                                 TextChanged="KeyInputTextChanged"/>
                    </Border>
                    <TextBlock x:Name="ErrorText"
                               Margin="2,8,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ErrorBrush}"
                               Visibility="Collapsed"
                               Text="That key isn't recognized. Double-check it and try again."/>
                </StackPanel>

                <!-- Footer buttons -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button x:Name="ExitButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Exit"
                            Click="ExitClick"
                            Margin="0,0,10,0"
                            Padding="20,10"/>
                    <Button x:Name="ContinueButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Continue"
                            Click="ContinueClick"
                            IsDefault="True"
                            Padding="24,10"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
