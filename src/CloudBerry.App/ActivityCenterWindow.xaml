<Window x:Class="CloudBerry.App.ActivityCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cirra Activity Center"
        Icon="pack://application:,,,/Resources/Icons/cirra_app_icon_256.png"
        Width="760"
        Height="580"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontFamily="{DynamicResource ThemeDisplayFontFamily}"
                           FontSize="{DynamicResource FontSizeHeading}"
                           FontWeight="SemiBold"
                           Text="Activity Center"/>
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Text="{Binding ActivityCenterSummary}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="CloseClick"
                    ToolTip="Close Activity Center"
                    Content="Close"/>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="{DynamicResource FontSizeBody}"
                       Text="Scans, metadata, backups, and updates will appear here."
                       Visibility="{Binding HasActivityOperations, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            <ListBox ItemsSource="{Binding ActivityOperations}"
                     Background="Transparent"
                     BorderThickness="0"
                     Visibility="{Binding HasActivityOperations, Converter={StaticResource BooleanToVisibilityConverter}}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10"
                                Padding="16,14"
                                CornerRadius="{DynamicResource ThemeCornerRadiusControl}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               TextWrapping="Wrap"
                                               Text="{Binding Message}"/>
                                    <ProgressBar Margin="0,10,0,0"
                                                 Height="4"
                                                 Minimum="0"
                                                 Maximum="1"
                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                 Value="{Binding Progress, TargetNullValue=0}"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Text="{Binding StatusLabel}"/>
                                    <TextBlock Margin="0,3,0,0"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Text="{Binding ProgressLabel}"/>
                                    <Button Margin="0,10,0,0"
                                            Padding="10,5"
                                            Style="{StaticResource GhostButtonStyle}"
                                            IsEnabled="{Binding CanCancel}"
                                            Tag="{Binding Id}"
                                            Click="CancelOperationClick"
                                            Content="Cancel"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
